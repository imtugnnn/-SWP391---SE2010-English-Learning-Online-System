@model EnglishLearningOnlineSystem.Models.User

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<h1>Chi tiết người dùng</h1>

<div>
    <dl class="row mt-4">
        <dt class="col-sm-2">Mã số (Id)</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Tên tài khoản</dt>
        <dd class="col-sm-10">@Model.Username</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Ngày sinh</dt>
        <dd class="col-sm-10">@(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>

        <dt class="col-sm-2">Trạng thái</dt>
        <dd class="col-sm-10">@(Model.IsActive ? "Đang hoạt động" : "Đang khóa")</dd>

        <dt class="col-sm-2">Vai trò</dt>
        <dd class="col-sm-10">@Model.Role?.Name</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>