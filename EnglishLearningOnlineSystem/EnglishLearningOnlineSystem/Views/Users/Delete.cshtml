@model EnglishLearningOnlineSystem.Models.User

@{
    ViewData["Title"] = "Xóa người dùng";
}

<h1>Xóa người dùng</h1>

<h3 class="text-danger">Bạn có chắc chắn muốn xóa người dùng này không?</h3>

<div>
    <dl class="row mt-4">
        <dt class="col-sm-2">Tên tài khoản</dt>
        <dd class="col-sm-10">@Model.Username</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Vai trò</dt>
        <dd class="col-sm-10">@Model.Role?.Name</dd>

        <dt class="col-sm-2">Trạng thái</dt>
        <dd class="col-sm-10">@(Model.IsActive ? "Đang hoạt động" : "Đang khóa")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>