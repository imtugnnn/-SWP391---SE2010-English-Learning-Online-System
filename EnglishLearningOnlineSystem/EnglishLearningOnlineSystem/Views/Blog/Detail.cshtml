@model EnglishLearningOnlineSystem.ViewModels.Blog.BlogReadDetailViewModel

@{
    Layout = "_StudentLayout";
    ViewData["Title"] = Model.Title;
    ViewData["ActiveNav"] = "blog";
}

@section Styles {
    <style>
        .article-wrap { background: var(--card); border: 2px solid var(--border);
            border-radius: var(--radius); box-shadow: var(--shadow); padding: 40px; width: 100%; }
        .article-cat { display: inline-block; background: #e0f2fe; color: var(--sky-dark);
            font-size: .75rem; font-weight: 800; padding: 4px 12px; border-radius: 99px; margin-bottom: 14px; }
        .article-title { font-size: 1.8rem; font-weight: 900; line-height: 1.25; margin-bottom: 10px; }
        .article-meta { color: var(--muted); font-weight: 700; font-size: .85rem; margin-bottom: 24px;
            padding-bottom: 18px; border-bottom: 2px solid var(--border); }
        .article-body { font-size: 1.02rem; line-height: 1.75; white-space: pre-wrap; color: var(--text); }
        .article-back { display: inline-block; margin-bottom: 18px; color: var(--sky-d);
            font-weight: 800; text-decoration: none; }
        .article-back:hover { text-decoration: underline; }
    </style>
}

<a href="/Blog" class="article-back">← Quay lại danh sách</a>

<div class="article-wrap">
    <span class="article-cat">@Model.Category</span>
    <div class="article-title">@Model.Title</div>
    <div class="article-meta">
        @Model.AuthorName
        @if (Model.PublishedAt.HasValue) { <span>· @Model.PublishedAt.Value.ToString("dd/MM/yyyy")</span> }
    </div>
    <div class="article-body">@Model.Content</div>
</div>
