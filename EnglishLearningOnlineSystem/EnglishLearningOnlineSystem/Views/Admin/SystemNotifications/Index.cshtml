        function deleteNotification(id) {
            const n = notifications.find(x => x.id === id);
            if (!n) return;
            if (n.status === 'ÄÃ£ há»§y') {
                alert("ThÃ´ng bÃ¡o nÃ y Ä‘Ã£ Ä‘Æ°á»£c há»§y trÆ°á»›c Ä‘Ã³.");
                return;
            }
            if (!confirm("Báº¡n cÃ³ cháº¯c cháº¯n muá»‘n há»§y thÃ´ng bÃ¡o nÃ y khÃ´ng? Tráº¡ng thÃ¡i sáº½ chuyá»ƒn thÃ nh 'ÄÃ£ há»§y'.")) return;

            fetch(`/SystemNotifications/Delete?id=${id}`, {
                method: 'POST'
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert("Lá»—i káº¿t ná»‘i mÃ¡y chá»§.");
            });
        }

        // HTML Escape Helper
        function escapeHtml(text) {
            if (!text) return '';
            return text.toString()
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
