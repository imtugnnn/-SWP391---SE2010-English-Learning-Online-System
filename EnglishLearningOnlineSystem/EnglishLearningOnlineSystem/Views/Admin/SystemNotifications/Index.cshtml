            e.preventDefault();
            const form = e.target;
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

            clearNotificationError('edit', 'publishTime');

            // Auto generate recipient string and user type badge based on check boxes
            const { recipient, userType } = computeRecipientAndUserType('edit');

            if (!recipient) {
                alert("Vui lÃ²ng chá»n Ã­t nháº¥t má»™t Ä‘á»‘i tÆ°á»£ng nháº­n.");
