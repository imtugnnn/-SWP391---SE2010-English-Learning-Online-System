@* Last Update: 7/16/2026 *@
@model List<EnglishLearningOnlineSystem.Models.AuditLog>

@{
    ViewData["Title"] = "Nhật ký hoạt động hệ thống";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";

    var userRole = ViewBag.UserRole as string;
    var startDate = ViewBag.StartDate as string;
    var endDate = ViewBag.EndDate as string;
    var searchQuery = ViewBag.SearchQuery as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/audit-log.css" asp-append-version="true" />
}

<div class="audit-log-page">
    <!-- Header Section -->
    <div class="page-header">
        <div class="header-title-section">
            <h2>Nhật ký hoạt động hệ thống</h2>
            <p>Theo dõi và giám sát các thay đổi dữ liệu cũng như hành động của Giáo viên, Content Manager và Admin</p>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filter-card">
        <form method="get" action="@Url.Action("Index", "AuditLog")">
            <div class="filter-grid">
                <div class="filter-item">
                    <label for="searchQuery">Tìm kiếm</label>
                    <div class="input-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" id="searchQuery" name="searchQuery" value="@searchQuery" placeholder="Tìm theo tên hoặc hành động..." />
                    </div>
                </div>

                <div class="filter-item">
                    <label for="userRole">Vai trò</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person-badge"></i>
                        <select id="userRole" name="userRole">
                            <option value="">Tất cả vai trò</option>
                            <option value="Admin" selected="@(userRole == "Admin" ? "selected" : null)">Admin</option>
                            <option value="Teacher" selected="@(userRole == "Teacher" ? "selected" : null)">Teacher</option>
                            <option value="Content Manager" selected="@(userRole == "Content Manager" ? "selected" : null)">Content Manager</option>
                        </select>
                    </div>
                </div>

                <div class="filter-item">
                    <label for="startDate">Từ ngày</label>
                    <div class="input-wrapper">
                        <i class="bi bi-calendar-event"></i>
                        <input type="date" id="startDate" name="startDate" value="@startDate" />
                    </div>
                </div>

                <div class="filter-item">
                    <label for="endDate">Đến ngày</label>
                    <div class="input-wrapper">
                        <i class="bi bi-calendar-event"></i>
                        <input type="date" id="endDate" name="endDate" value="@endDate" />
                    </div>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-filter-submit">
                        <i class="bi bi-funnel-fill"></i>
                        Lọc kết quả
                    </button>
                    <a href="@Url.Action("Index", "AuditLog")" class="btn-filter-reset">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Đặt lại
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Stats summary -->
    <div class="results-summary">
        <p>Tìm thấy <strong>@totalItems</strong> bản ghi hoạt động</p>
    </div>

    <!-- Data Table Section -->
    <div class="table-container">
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-clipboard-x"></i>
                </div>
                <h3>Không tìm thấy nhật ký hoạt động nào</h3>
                <p>Không có hoạt động nào khớp với bộ lọc của bạn. Hãy thử đổi từ khóa tìm kiếm hoặc ngày lọc khác.</p>
            </div>
        }
        else
        {
            <table class="audit-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th style="width: 150px;">Tài khoản</th>
                        <th style="width: 180px;">Vai trò</th>
                        <th>Hành động thực hiện</th>
                        <th style="width: 200px;">Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td><span class="log-id">#@log.Id</span></td>
                            <td>
                                <div class="user-info-cell">
                                    <div class="avatar-stub">@log.Username.Substring(0, Math.Min(2, log.Username.Length)).ToUpper()</div>
                                    <span class="username">@log.Username</span>
                                </div>
                            </td>
                            <td>
                                @if (log.UserRole == "Admin")
                                {
                                    <span class="badge badge-admin">
                                        <i class="bi bi-shield-fill-check"></i> Admin
                                    </span>
                                }
                                else if (log.UserRole == "Teacher")
                                {
                                    <span class="badge badge-teacher">
                                        <i class="bi bi-journal-bookmark-fill"></i> Teacher
                                    </span>
                                }
                                else if (log.UserRole == "Content Manager")
                                {
                                    <span class="badge badge-content">
                                        <i class="bi bi-file-earmark-richtext-fill"></i> Content Manager
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-default">@log.UserRole</span>
                                }
                            </td>
                            <td>
                                <div class="action-text">@log.Action</div>
                            </td>
                            <td>
                                <div class="time-cell">
                                    <i class="bi bi-clock"></i>
                                    <span>@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="pagination-container">
                    <ul class="pagination-list">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a href="@Url.Action("Index", "AuditLog", new { startDate, endDate, userRole, searchQuery, page = currentPage - 1 })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a href="@Url.Action("Index", "AuditLog", new { startDate, endDate, userRole, searchQuery, page = i })">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a href="@Url.Action("Index", "AuditLog", new { startDate, endDate, userRole, searchQuery, page = currentPage + 1 })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        }
    </div>
</div>
