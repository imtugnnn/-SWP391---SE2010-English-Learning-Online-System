@* Create by TungDPL *@
@* Last Update: 7/17/2026 *@
@using EnglishLearningOnlineSystem.Controllers.Admin
@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/admin/admin-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container">

    <!-- Grid Chỉ số (6 cards trên cùng) -->
    <div class="stats-grid-6">
        <!-- Card 1: Tổng số người dùng -->
        <a asp-controller="Admin" asp-action="UserManagement" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-users">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Tổng số người dùng</span>
                <span class="card-value">@ViewBag.TotalUsersAll</span>
                <span class="card-trend trend-up">
                    @ViewBag.TotalUsersActive người hoạt động tháng này
                </span>
            </div>
        </a>

        <!-- Card 2: Học sinh -->
        <a asp-controller="Admin" asp-action="UserManagement" asp-route-role="Student" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-students">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Học sinh</span>
                <span class="card-value">@ViewBag.StudentCountAll</span>
                <span class="card-trend trend-up">
                    @ViewBag.StudentCountActive học sinh hoạt động tháng này
                </span>
            </div>
        </a>

        <!-- Card 3: Giáo viên -->
        <a asp-controller="Admin" asp-action="UserManagement" asp-route-role="Teacher" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-teachers">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Giáo viên</span>
                <span class="card-value">@ViewBag.TeacherCountAll</span>
                <span class="card-trend trend-up">
                    @ViewBag.TeacherCountActive giáo viên hoạt động tháng này
                </span>
            </div>
        </a>

        <!-- Card 4: Lớp học đang hoạt động -->
        <a asp-controller="AcademicYears" asp-action="Index" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-classes">
                <i class="bi bi-house-door-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Lớp học đang hoạt động</span>
                <span class="card-value">@ViewBag.ActiveClassesCount</span>
                <span class="card-trend trend-neutral">
                    Đang hoạt động ổn định
                </span>
            </div>
        </a>

        <!-- Card 5: Năm học hiện tại -->
        <a asp-controller="AcademicYears" asp-action="Index" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-year">
                <i class="bi bi-calendar3"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Năm học hiện tại</span>
                <span class="card-value">@ViewBag.ActiveAcademicYear</span>
                <span class="card-trend">
                    <span class="badge-status">Đang hoạt động</span>
                </span>
            </div>
        </a>

        <!-- Card 6: Thông báo tháng này -->
        <a asp-controller="SystemNotifications" asp-action="Index" asp-route-timeRange="month" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-notif">
                <i class="bi bi-megaphone-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Thông báo tháng này</span>
                <span class="card-value">@ViewBag.PublishedNotifsThisMonth đã công bố</span>
                <span class="card-trend trend-down">
                    @ViewBag.ScheduledNotifsThisMonth đang lên lịch gửi
                </span>
            </div>
        </a>
    </div>

    <!-- Dòng 2: Nhật ký hoạt động gần đây & Danh sách lớp học -->
    <div class="row-grid-2" style="margin-top: 24px;">
        <!-- Widget 4: Nhật ký hoạt động gần đây -->
        <div class="card-widget widget-audit-log" style="display: flex; flex-direction: column; height: 100%;">
            <div class="widget-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px; margin-bottom: 15px;">
                <h3 style="font-weight: 700; color: #1e3a5f; margin: 0; font-size: 1.05rem;">
                    <i class="bi bi-clock-history text-primary me-2"></i> Nhật ký hoạt động gần đây
                </h3>
                <a asp-controller="AuditLog" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size: 0.8rem; border-color: #38bdf8; color: #0369a1; font-weight: 800; text-decoration: none;">
                    Xem tất cả
                </a>
            </div>
            <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
                <table class="table table-hover align-middle" style="margin-bottom: 0;">
                    <thead>
                        <tr style="background: #f0f9ff; color: #0369a1; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid #bae6fd;">
                            <th style="padding: 10px 12px; border-bottom: none;">Thời gian</th>
                            <th style="padding: 10px 12px; border-bottom: none;">Người thực hiện</th>
                            <th style="padding: 10px 12px; border-bottom: none;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var auditLogs = ViewBag.LatestAuditLogs as List<EnglishLearningOnlineSystem.Models.AuditLog>;
                        }
                        @if (auditLogs == null || !auditLogs.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i> Chưa có ghi nhận hoạt động nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in auditLogs)
                            {
                                <tr>
                                    <td style="padding: 12px 12px; color: #64748b; font-size: 0.88rem; border-bottom: 1px solid #f1f5f9;">
                                        @log.Timestamp.AddHours(7).ToString("dd/MM HH:mm")
                                    </td>
                                    <td style="padding: 12px 12px; border-bottom: 1px solid #f1f5f9;">
                                        @{
                                            string roleBadge = "bg-secondary";
                                            string roleName = log.UserRole;
                                            if (log.UserRole == "2") { roleBadge = "bg-danger"; roleName = "Admin"; }
                                            else if (log.UserRole == "3") { roleBadge = "bg-success"; roleName = "Teacher"; }
                                            else if (log.UserRole == "5") { roleBadge = "bg-warning text-dark"; roleName = "CM"; }
                                        }
                                        <div class="fw-bold" style="color: #1e3a5f; font-size: 0.9rem;">@log.Username</div>
                                        <span class="badge @roleBadge rounded-pill" style="font-size: 0.68rem; padding: 2px 6px;">@roleName</span>
                                    </td>
                                    <td style="padding: 12px 12px; color: #334155; font-size: 0.88rem; border-bottom: 1px solid #f1f5f9; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@log.Action">
                                        @log.Action
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Widget 5: Danh sách lớp học theo năm học -->
        <div class="card-widget widget-classes-list" style="display: flex; flex-direction: column; height: 100%;">
            <div class="widget-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px; margin-bottom: 15px;">
                <h3 style="font-weight: 700; color: #1e3a5f; margin: 0; font-size: 1.05rem;">
                    <i class="bi bi-mortarboard-fill text-primary me-2"></i> Lớp học năm học hiện tại (@ViewBag.ActiveAcademicYear)
                </h3>
                <a asp-controller="AcademicYears" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size: 0.8rem; border-color: #38bdf8; color: #0369a1; font-weight: 800; text-decoration: none;">
                    Xem tất cả
                </a>
            </div>
            <div class="table-responsive" style="flex-grow: 1; overflow-y: auto;">
                <table class="table table-hover align-middle" style="margin-bottom: 0;">
                    <thead>
                        <tr style="background: #f0f9ff; color: #0369a1; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid #bae6fd;">
                            <th style="padding: 10px 12px; border-bottom: none;">Tên lớp</th>
                            <th style="padding: 10px 12px; border-bottom: none;">Khóa học</th>
                            <th style="padding: 10px 12px; border-bottom: none;">Giáo viên</th>
                            <th style="padding: 10px 12px; border-bottom: none; text-align: center;">Học sinh</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var activeClasses = ViewBag.ActiveClassesList as List<EnglishLearningOnlineSystem.Models.Class>;
                        }
                        @if (activeClasses == null || !activeClasses.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i> Không có lớp học nào trong năm học này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var cls in activeClasses)
                            {
                                <tr>
                                    <td style="padding: 12px 12px; border-bottom: 1px solid #f1f5f9; font-weight: 700; color: #1e3a5f;">
                                        @cls.ClassName
                                    </td>
                                    <td style="padding: 12px 12px; border-bottom: 1px solid #f1f5f9; color: #334155; font-size: 0.88rem;">
                                        @(cls.Course?.CourseName ?? "Chưa gán")
                                    </td>
                                    <td style="padding: 12px 12px; border-bottom: 1px solid #f1f5f9; color: #64748b; font-size: 0.88rem;">
                                        @(cls.Teacher?.Username ?? "Chưa phân công")
                                    </td>
                                    <td style="padding: 12px 12px; border-bottom: 1px solid #f1f5f9; text-align: center; font-weight: bold; color: #10b981; font-size: 0.88rem;">
                                        @(cls.Enrollments?.Count ?? 0)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>



    <!-- Thao tác nhanh -->
    <div class="quick-actions-section">
        <h3>Thao tác nhanh</h3>
        <div class="quick-actions-grid">
            <!-- Action 1 -->
            <a asp-controller="Admin" asp-action="UserManagement" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-users">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Thêm người dùng</span>
                    <span class="btn-desc">Tạo tài khoản người dùng mới</span>
                </div>
            </a>

            <!-- Action 2 -->
            <a asp-controller="AcademicYears" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-classes">
                    <i class="bi bi-house-door-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Tạo lớp học</span>
                    <span class="btn-desc">Tạo lớp học mới</span>
                </div>
            </a>

            <!-- Action 3 -->
            <a asp-controller="SystemNotifications" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-notif">
                    <i class="bi bi-megaphone-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Tạo thông báo</span>
                    <span class="btn-desc">Gửi thông báo hệ thống</span>
                </div>
            </a>

            <!-- Action 4 -->
            <a asp-controller="AcademicYears" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-year">
                    <i class="bi bi-calendar-plus-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Tạo năm học</span>
                    <span class="btn-desc">Thiết lập năm học mới</span>
                </div>
            </a>

            <!-- Action 5 -->
            <a asp-controller="Reports" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-report">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">Xem báo cáo</span>
                    <span class="btn-desc">Xem báo cáo & thống kê</span>
                </div>
            </a>
        </div>
    </div>
</div>
