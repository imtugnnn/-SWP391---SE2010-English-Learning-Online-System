@using EnglishLearningOnlineSystem.Controllers.Admin
@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/admin/admin-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container">

    <!-- Grid Chỉ số (6 cards trên cùng) -->
    <div class="stats-grid-6">
        <!-- Card 1: Tổng số người dùng -->
        <a asp-controller="Admin" asp-action="UserManagement" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-users">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Tổng số người dùng</span>
                <span class="card-value">@ViewBag.TotalUsersAll</span>
                <span class="card-trend trend-up">
                    @ViewBag.TotalUsersActive người hoạt động tháng này
                </span>
            </div>
        </a>

        <!-- Card 2: Học sinh -->
        <a asp-controller="Admin" asp-action="UserManagement" asp-route-role="Student" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-students">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Học sinh</span>
                <span class="card-value">@ViewBag.StudentCountAll</span>
                <span class="card-trend trend-up">
                    @ViewBag.StudentCountActive học sinh hoạt động tháng này
                </span>
            </div>
        </a>

        <!-- Card 3: Giáo viên -->
        <a asp-controller="Admin" asp-action="UserManagement" asp-route-role="Teacher" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-teachers">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Giáo viên</span>
                <span class="card-value">@ViewBag.TeacherCountAll</span>
                <span class="card-trend trend-up">
                    @ViewBag.TeacherCountActive giáo viên hoạt động tháng này
                </span>
            </div>
        </a>

        <!-- Card 4: Lớp học đang hoạt động -->
        <a asp-controller="AcademicYears" asp-action="Index" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-classes">
                <i class="bi bi-house-door-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Lớp học đang hoạt động</span>
                <span class="card-value">@ViewBag.ActiveClassesCount</span>
                <span class="card-trend trend-neutral">
                    Đang hoạt động ổn định
                </span>
            </div>
        </a>

        <!-- Card 5: Năm học hiện tại -->
        <a asp-controller="AcademicYears" asp-action="Index" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-year">
                <i class="bi bi-calendar3"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Năm học hiện tại</span>
                <span class="card-value">@ViewBag.ActiveAcademicYear</span>
                <span class="card-trend">
                    <span class="badge-status">Đang hoạt động</span>
                </span>
            </div>
        </a>

        <!-- Card 6: Thông báo tháng này -->
        <a asp-controller="SystemNotifications" asp-action="Index" asp-route-timeRange="month" class="stat-card-custom" style="text-decoration: none; color: inherit;">
            <div class="icon-wrapper icon-notif">
                <i class="bi bi-megaphone-fill"></i>
            </div>
            <div class="card-info">
                <span class="card-label">Thông báo tháng này</span>
                <span class="card-value">@ViewBag.PublishedNotifsThisMonth đã công bố</span>
                <span class="card-trend trend-down">
                    @ViewBag.ScheduledNotifsThisMonth đang lên lịch gửi
                </span>
            </div>
        </a>
    </div>

    <!-- Dòng 2: Thống kê học tập tổng quan, Xu hướng hoàn thành, Tỷ lệ hoàn thành bài học -->
    <div class="row-grid-3">
        <!-- Widget 1: Thống kê học tập tổng quan -->
        <div class="card-widget widget-overview">
            <div class="widget-header">
                <h3>Thống kê học tập tổng quan</h3>
            </div>
            <div class="overview-grid-2x2">
                <div class="overview-subcard">
                    <div class="subcard-icon text-primary bg-primary-light">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <div class="subcard-info">
                        <span class="subcard-title">Bài học đã hoàn thành</span>
                        <span class="subcard-val">@(ViewBag.TotalUsersAll > 0 ? ViewBag.CompletedLessonsCount.ToString("N0") : "1.254")</span>
                        <span class="subcard-trend @(ViewBag.LessonsTrendPct >= 0 ? "text-success" : "text-danger")">
                            <i class="bi @(ViewBag.LessonsTrendPct >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                            @(Math.Abs((int)(ViewBag.LessonsTrendPct ?? 18)))% so với tháng trước
                        </span>
                    </div>
                </div>

                <div class="overview-subcard">
                    <div class="subcard-icon text-success bg-success-light">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div class="subcard-info">
                        <span class="subcard-title">Lượt làm bài quiz</span>
                        <span class="subcard-val">@(ViewBag.TotalUsersAll > 0 ? ViewBag.TotalQuizAttempts.ToString("N0") : "3.912")</span>
                        <span class="subcard-trend @(ViewBag.QuizAttemptsTrendPct >= 0 ? "text-success" : "text-danger")">
                            <i class="bi @(ViewBag.QuizAttemptsTrendPct >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                            @(Math.Abs((int)(ViewBag.QuizAttemptsTrendPct ?? 12)))% so với tháng trước
                        </span>
                    </div>
                </div>

                <div class="overview-subcard">
                    <div class="subcard-icon text-warning bg-warning-light">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <div class="subcard-info">
                        <span class="subcard-title">Điểm trung bình quiz</span>
                        <span class="subcard-val">@(ViewBag.TotalUsersAll > 0 ? $"{ViewBag.AvgQuizScore}%" : "82%")</span>
                        <span class="subcard-trend @(ViewBag.QuizScoreTrendPct >= 0 ? "text-success" : "text-danger")">
                            <i class="bi @(ViewBag.QuizScoreTrendPct >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                            @(Math.Abs((int)(ViewBag.QuizScoreTrendPct ?? 5)))% so với tháng trước
                        </span>
                    </div>
                </div>

                <div class="overview-subcard">
                    <div class="subcard-icon text-secondary bg-secondary-light">
                        <i class="bi bi-fire"></i>
                    </div>
                    <div class="subcard-info">
                        <span class="subcard-title">Người dùng hoạt động</span>
                        <span class="subcard-val">@(ViewBag.TotalUsersAll > 0 ? ViewBag.StreakUsersCount.ToString("N0") : "418")</span>
                        <span class="subcard-trend @(ViewBag.ActiveStudentsTrendPct >= 0 ? "text-success" : "text-danger")">
                            <i class="bi @(ViewBag.ActiveStudentsTrendPct >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                            @(Math.Abs((int)(ViewBag.ActiveStudentsTrendPct ?? 27)))% so với tháng trước
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Widget 2: Xu hướng hoàn thành -->
        <div class="card-widget widget-trend">
            <div class="widget-header">
                <h3>Xu hướng hoàn thành (6 tháng gần nhất)</h3>
            </div>
            <div class="chart-container">
                <canvas id="trendLineChart"></canvas>
            </div>
        </div>

        <!-- Widget 3: Tỷ lệ hoàn thành bài học -->
        <div class="card-widget widget-donut">
            <div class="widget-header">
                <h3>Tỷ lệ hoàn thành bài học</h3>
            </div>
            <div class="donut-chart-box">
                <div class="donut-chart-wrapper">
                    <canvas id="completionDonutChart"></canvas>
                </div>
                <div class="donut-legend">
                    <div class="donut-legend-item">
                        <span class="legend-dot" style="background-color: #3b82f6;"></span>
                        <span class="legend-lbl">Hoàn thành</span>
                        <span class="legend-val">@ViewBag.PctCompleted%</span>
                    </div>
                    <div class="donut-legend-item">
                        <span class="legend-dot" style="background-color: #10b981;"></span>
                        <span class="legend-lbl">Đang học</span>
                        <span class="legend-val">@ViewBag.PctInProgress%</span>
                    </div>
                    <div class="donut-legend-item">
                        <span class="legend-dot" style="background-color: #f97316;"></span>
                        <span class="legend-lbl">Chưa bắt đầu</span>
                        <span class="legend-val">@ViewBag.PctNotStarted%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dòng 3: Hiệu suất lớp học, Nội dung học tập -->
    <div class="row-grid-2">
        <!-- Widget 1: Hiệu suất lớp học -->
        <div class="card-widget widget-performance">
            <div class="widget-header">
                <h3>Hiệu suất lớp học</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Lớp học</th>
                            <th>Tỷ lệ hoàn thành</th>
                            <th>Điểm trung bình quiz</th>
                            <th>Học sinh tích cực</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.TopClassesPerformance != null && ((List<ClassPerformanceViewModel>)ViewBag.TopClassesPerformance).Any())
                        {
                            foreach (var cp in (List<ClassPerformanceViewModel>)ViewBag.TopClassesPerformance)
                            {
                                <tr>
                                    <td><strong>@cp.ClassName</strong></td>
                                    <td>
                                        <div class="progress-bar-wrapper">
                                            <div class="progress custom-progress">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @(cp.CompletionRate)%;" aria-valuenow="@cp.CompletionRate" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <span class="progress-val">@cp.CompletionRate%</span>
                                        </div>
                                    </td>
                                    <td><strong>@cp.AvgQuizScore%</strong></td>
                                    <td>@cp.ActiveStudentsText</td>
                                </tr>
                            }
                        }
                        else
                        {
                            // Mock data preview matching reference UI
                            <tr>
                                <td><strong>10A1</strong></td>
                                <td>
                                    <div class="progress-bar-wrapper">
                                        <div class="progress custom-progress">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 95%;" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="progress-val">95%</span>
                                    </div>
                                </td>
                                <td><strong>91%</strong></td>
                                <td>38 / 40</td>
                            </tr>
                            <tr>
                                <td><strong>10A2</strong></td>
                                <td>
                                    <div class="progress-bar-wrapper">
                                        <div class="progress custom-progress">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 89%;" aria-valuenow="89" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="progress-val">89%</span>
                                    </div>
                                </td>
                                <td><strong>87%</strong></td>
                                <td>36 / 40</td>
                            </tr>
                            <tr>
                                <td><strong>11A3</strong></td>
                                <td>
                                    <div class="progress-bar-wrapper">
                                        <div class="progress custom-progress">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 82%;" aria-valuenow="82" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="progress-val">82%</span>
                                    </div>
                                </td>
                                <td><strong>84%</strong></td>
                                <td>35 / 40</td>
                            </tr>
                            <tr>
                                <td><strong>11B1</strong></td>
                                <td>
                                    <div class="progress-bar-wrapper">
                                        <div class="progress custom-progress">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 76%;" aria-valuenow="76" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="progress-val">76%</span>
                                    </div>
                                </td>
                                <td><strong>78%</strong></td>
                                <td>32 / 40</td>
                            </tr>
                            <tr>
                                <td><strong>12A1</strong></td>
                                <td>
                                    <div class="progress-bar-wrapper">
                                        <div class="progress custom-progress">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 68%;" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="progress-val">68%</span>
                                    </div>
                                </td>
                                <td><strong>71%</strong></td>
                                <td>28 / 40</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="widget-footer-link">
                <a asp-controller="AcademicYears" asp-action="Index">Xem tất cả lớp học <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>

        <!-- Widget 2: Nội dung học tập -->
        <div class="card-widget widget-content-stats">
            <div class="widget-header">
                <h3>Nội dung học tập</h3>
            </div>
            <!-- Grid 4 stats nhỏ trên cùng -->
            <div class="content-stats-top-grid">
                <div class="content-stat-item">
                    <div class="cs-icon bg-primary-light text-primary">
                        <i class="bi bi-journal-album"></i>
                    </div>
                    <div class="cs-info">
                        <span class="cs-title">Khóa học</span>
                        <span class="cs-val">@ViewBag.TotalCoursesCount</span>
                        <span class="cs-sub">@ViewBag.ActiveCoursesCount đang hoạt động</span>
                    </div>
                </div>

                <div class="content-stat-item">
                    <div class="cs-icon bg-success-light text-success">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div class="cs-info">
                        <span class="cs-title">Bài học</span>
                        <span class="cs-val">@ViewBag.TotalLessonsCount</span>
                        <span class="cs-sub">@ViewBag.ActiveLessonsCount đã xuất bản</span>
                    </div>
                </div>

                <div class="content-stat-item">
                    <div class="cs-icon bg-warning-light text-warning">
                        <i class="bi bi-question-circle"></i>
                    </div>
                    <div class="cs-info">
                        <span class="cs-title">Quiz</span>
                        <span class="cs-val">@ViewBag.TotalQuizzesCount</span>
                        <span class="cs-sub">@ViewBag.ActiveQuizzesCount đang hoạt động</span>
                    </div>
                </div>

                <div class="content-stat-item">
                    <div class="cs-icon bg-secondary-light text-secondary">
                        <i class="bi bi-controller"></i>
                    </div>
                    <div class="cs-info">
                        <span class="cs-title">Mini Game</span>
                        <span class="cs-val">@ViewBag.TotalMinigamesCount</span>
                        <span class="cs-sub">@ViewBag.ActiveMinigamesCount đang hoạt động</span>
                    </div>
                </div>
            </div>

            <!-- List Top khóa học -->
            <div class="top-courses-usage">
                <h4>Top khóa học theo mức độ sử dụng</h4>
                <div class="course-usage-list">
                    @if (ViewBag.TopCoursesByUse != null && ((List<CourseUseViewModel>)ViewBag.TopCoursesByUse).Any())
                    {
                        int rank = 1;
                        foreach (var cu in (List<CourseUseViewModel>)ViewBag.TopCoursesByUse)
                        {
                            <div class="course-usage-item">
                                <span class="course-rank">@rank</span>
                                <div class="course-use-details">
                                    <div class="course-use-header">
                                        <span class="course-use-name">@cu.CourseName</span>
                                        <span class="course-use-stats">@cu.StudentCount học sinh <strong>(@cu.UsagePercentage%)</strong></span>
                                    </div>
                                    <div class="progress custom-progress-small">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(cu.UsagePercentage)%;" aria-valuenow="@cu.UsagePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        // Mock data preview matching reference UI
                        <div class="course-usage-item">
                            <span class="course-rank">1</span>
                            <div class="course-use-details">
                                <div class="course-use-header">
                                    <span class="course-use-name">Starter English</span>
                                    <span class="course-use-stats">186 học sinh <strong>(92%)</strong></span>
                                </div>
                                <div class="progress custom-progress-small">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: 92%;" aria-valuenow="92" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                        <div class="course-usage-item">
                            <span class="course-rank">2</span>
                            <div class="course-use-details">
                                <div class="course-use-header">
                                    <span class="course-use-name">Basic Grammar</span>
                                    <span class="course-use-stats">112 học sinh <strong>(84%)</strong></span>
                                </div>
                                <div class="progress custom-progress-small">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: 84%;" aria-valuenow="84" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                        <div class="course-usage-item">
                            <span class="course-rank">3</span>
                            <div class="course-use-details">
                                <div class="course-use-header">
                                    <span class="course-use-name">Daily Conversation</span>
                                    <span class="course-use-stats">75 học sinh <strong>(61%)</strong></span>
                                </div>
                                <div class="progress custom-progress-small">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: 61%;" aria-valuenow="61" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- Thao tác nhanh -->
    <div class="quick-actions-section">
        <h3>Thao tác nhanh</h3>
        <div class="quick-actions-grid">
            <!-- Action 1 -->
            <a asp-controller="Admin" asp-action="UserManagement" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-users">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Thêm người dùng</span>
                    <span class="btn-desc">Tạo tài khoản người dùng mới</span>
                </div>
            </a>

            <!-- Action 2 -->
            <a asp-controller="AcademicYears" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-classes">
                    <i class="bi bi-house-door-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Tạo lớp học</span>
                    <span class="btn-desc">Tạo lớp học mới</span>
                </div>
            </a>

            <!-- Action 3 -->
            <a asp-controller="SystemNotifications" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-notif">
                    <i class="bi bi-megaphone-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Tạo thông báo</span>
                    <span class="btn-desc">Gửi thông báo hệ thống</span>
                </div>
            </a>

            <!-- Action 4 -->
            <a asp-controller="AcademicYears" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-year">
                    <i class="bi bi-calendar-plus-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">+ Tạo năm học</span>
                    <span class="btn-desc">Thiết lập năm học mới</span>
                </div>
            </a>

            <!-- Action 5 -->
            <a asp-controller="Reports" asp-action="Index" class="quick-action-btn-custom" style="text-decoration: none;">
                <div class="btn-icon-wrapper btn-icon-report">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div class="btn-text-content">
                    <span class="btn-title">Xem báo cáo</span>
                    <span class="btn-desc">Xem báo cáo & thống kê</span>
                </div>
            </a>
        </div>
    </div>
</div>

@section Scripts
{
    <!-- Load Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Retrieve dynamic data from ViewBag
            const trendMonths = @Html.Raw(Json.Serialize(ViewBag.TrendMonths)) || ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6'];
            const lessonTrend = @Html.Raw(Json.Serialize(ViewBag.LessonTrend)) || [620, 780, 850, 980, 1150, 1254];
            const quizTrend = @Html.Raw(Json.Serialize(ViewBag.QuizTrend)) || [1800, 2100, 2300, 2700, 3200, 3912];

            const pctCompleted = @(ViewBag.PctCompleted ?? 58);
            const pctInProgress = @(ViewBag.PctInProgress ?? 31);
            const pctNotStarted = @(ViewBag.PctNotStarted ?? 11);

            // Chart 1: Completion Trend (Line Chart)
            const trendCtx = document.getElementById('trendLineChart').getContext('2d');
            
            // Adjust mock trend line data if real data is empty
            const finalLessonData = lessonTrend.every(v => v === 0) ? [620, 780, 850, 980, 1150, 1254] : lessonTrend;
            const finalQuizData = quizTrend.every(v => v === 0) ? [1800, 2100, 2300, 2700, 3200, 3912] : quizTrend;

            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: trendMonths,
                    datasets: [
                        {
                            label: 'Bài học hoàn thành',
                            data: finalLessonData,
                            borderColor: '#3b82f6',
                            backgroundColor: '#eff6ff',
                            borderWidth: 2,
                            tension: 0.3,
                            pointBackgroundColor: '#3b82f6',
                            pointRadius: 4
                        },
                        {
