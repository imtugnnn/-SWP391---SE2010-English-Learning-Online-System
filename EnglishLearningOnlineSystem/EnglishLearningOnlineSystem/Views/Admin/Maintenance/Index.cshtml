@{
    ViewData["Title"] = "Cấu hình bảo trì hệ thống";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";

    bool isEnabled = ViewBag.IsEnabled;
    DateTime? startAt = ViewBag.StartAt;
    bool isScheduled = ViewBag.IsScheduled;
    bool isMaintenanceActive = ViewBag.IsMaintenanceActive;
    var auditLogs = ViewBag.AuditLogs as List<EnglishLearningOnlineSystem.Models.AuditLog>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/maintenance.css" asp-append-version="true" />
}

<div class="maintenance-page">
    <div class="page-header">
        <div class="header-title-section">
            <h2>Cấu hình Bảo trì Hệ thống</h2>
            <p>Quản lý lịch trình bảo trì hệ thống và kiểm soát quyền truy cập của người dùng khi nâng cấp hệ thống.</p>
        </div>
    </div>

    <!-- Hộp thông báo TempData -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Trạng thái và Thao tác -->
        <div class="col-lg-6">
            <div class="card status-card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="card-title d-flex align-items-center mb-4">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i> Trạng thái hiện tại
                    </h4>

                    <div class="status-indicator-box mb-4 text-center p-4 rounded-3">
                        @if (isMaintenanceActive)
                        {
                            <div class="status-badge status-active mb-3">
                                <i class="bi bi-exclamation-octagon-fill pulse-icon"></i>
                                <span>ĐANG BẢO TRÌ</span>
                            </div>
                            <p class="status-desc text-danger font-monospace fw-bold">
                                Hệ thống đang tạm ngưng phục vụ người học & giáo viên.
                            </p>
                            @if (startAt.HasValue)
                            {
                                <div class="text-muted small mt-2">
                                    Bắt đầu tự động từ: @startAt.Value.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                        }
                        else if (isScheduled)
                        {
                            <div class="status-badge status-scheduled mb-3">
                                <i class="bi bi-calendar-event-fill"></i>
                                <span>ĐÃ LÊN LỊCH BẢO TRÌ</span>
                            </div>
                            <p class="status-desc text-primary font-monospace fw-bold">
                                Hệ thống đã được đặt lịch bảo trì.
                            </p>
                            <div class="scheduled-time-badge bg-light p-2 rounded border mt-2">
                                <i class="bi bi-clock-fill text-warning me-1"></i> Bắt đầu lúc: <strong>@startAt.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        }
                        else
                        {
                            <div class="status-badge status-normal mb-3">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>HOẠT ĐỘNG BÌNH THƯỜNG</span>
                            </div>
                            <p class="status-desc text-success font-monospace fw-bold">
                                Tất cả người dùng có thể truy cập hệ thống bình thường.
                            </p>
                        }
                    </div>

                    <!-- Khu vực Hành động -->
                    <div class="action-section border-top pt-4">
                        @if (isMaintenanceActive)
                        {
                            <!-- Đang bảo trì -> Cho phép tắt -->
                            <div class="alert alert-warning mb-4">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                                <strong>Lưu ý:</strong> Khi kết thúc bảo trì, hệ thống sẽ khôi phục truy cập ngay lập tức cho tất cả người dùng.
                            </div>
                            <form asp-controller="Maintenance" asp-action="ToggleImmediate" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn kết thúc bảo trì hệ thống và khôi phục truy cập cho mọi người dùng ngay bây giờ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="enable" value="false" />
                                <button type="submit" class="btn btn-success w-100 btn-lg shadow-sm">
                                    <i class="bi bi-play-fill me-1"></i> Kết thúc bảo trì ngay
                                </button>
                            </form>
                        }
                        else if (isScheduled)
                        {
                            <!-- Đã lên lịch -> Cho phép Hủy hoặc Bật ngay -->
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <form asp-controller="Maintenance" asp-action="ToggleImmediate" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn kích hoạt bảo trì hệ thống NGAY LẬP TỨC mà không đợi đến lịch hẹn?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="enable" value="true" />
                                        <button type="submit" class="btn btn-danger w-100 shadow-sm">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Bảo trì ngay lập tức
                                        </button>
                                    </form>
                                </div>
                                <div class="col-sm-6">
                                    <form asp-controller="Maintenance" asp-action="CancelSchedule" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch bảo trì đã đặt trước?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary w-100">
                                            <i class="bi bi-x-circle me-1"></i> Hủy lịch hẹn
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Bình thường -> Cho phép Bật ngay hoặc Lên lịch -->
                            <div class="card bg-light border-0 rounded-3 mb-4">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-clock-history text-secondary me-1"></i> Lên lịch bảo trì mới</h6>
                                    <form asp-controller="Maintenance" asp-action="Schedule" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label for="startAt" class="form-label small text-muted">Thời gian bắt đầu:</label>
                                            <input type="datetime-local" id="startAt" name="startAt" class="form-control" required />
                                        </div>
                                        <div class="alert alert-info py-2 px-3 mb-3" style="font-size: 0.85rem;">
                                            <i class="bi bi-info-circle me-1"></i> Hệ thống sẽ tự động phát thông báo tới tất cả người dùng khi tạo lịch thành công.
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100 shadow-sm">
                                            <i class="bi bi-calendar-plus me-1"></i> Lên lịch & Phát thông báo
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <form asp-controller="Maintenance" asp-action="ToggleImmediate" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn chuyển hệ thống sang chế độ bảo trì và chặn toàn bộ truy cập NGAY LẬP TỨC?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="enable" value="true" />
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Vào chế độ bảo trì ngay lập tức
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Lịch sử bảo trì gần đây -->
        <div class="col-lg-6">
            <div class="card history-card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="card-title d-flex align-items-center mb-4">
                        <i class="bi bi-clock-history text-success me-2"></i> Lịch sử bảo trì gần đây
                    </h4>

                    @if (auditLogs == null || auditLogs.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-clipboard-data fs-1 mb-2"></i>
                            <p class="mb-0">Chưa ghi nhận hoạt động bảo trì nào trong nhật ký.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Người thực hiện</th>
                                        <th>Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in auditLogs)
                                    {
                                        <tr>
                                            <td class="text-nowrap small text-muted">
                                                @log.Timestamp.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")
                                            </td>
                                            <td>
                                                <div class="fw-bold">@log.Username</div>
                                                <div class="text-muted small">@log.UserRole</div>
                                            </td>
                                            <td>
                                                <span class="badge @(log.Action.Contains("Bắt đầu") || log.Action.Contains("ngay lập tức") ? "bg-danger" : log.Action.Contains("Lên lịch") ? "bg-primary" : log.Action.Contains("Hủy") ? "bg-secondary" : "bg-success")">
                                                    @log.Action
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set default minimum datetime input to today
        document.addEventListener("DOMContentLoaded", function () {
            const dateInput = document.getElementById("startAt");
            if (dateInput) {
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                
                const minDatetime = `${year}-${month}-${day}T${hours}:${minutes}`;
                dateInput.setAttribute("min", minDatetime);
            }
        });
    </script>
}
