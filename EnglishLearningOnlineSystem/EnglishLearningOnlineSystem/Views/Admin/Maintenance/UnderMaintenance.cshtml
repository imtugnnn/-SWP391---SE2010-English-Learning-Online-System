@* Last Update: 7/17/2026 *@
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ thống đang bảo trì - EduLearn</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/maintenance-public.css" asp-append-version="true" />
</head>
<body>
    <div class="maintenance-container">
        <!-- Nền chuyển màu chuyển động và các hạt trôi nổi -->
        <div class="bg-glow-1"></div>
        <div class="bg-glow-2"></div>
        
        <div class="glass-card shadow-lg text-center p-5">
            <!-- Logo và biểu tượng -->
            <div class="logo-wrapper mb-4">
                <img src="/images/logo/els logo.png" alt="EduLearn Logo" class="brand-logo" onerror="this.style.display='none';">
                <div class="brand-name mt-2">EduLearn</div>
            </div>
            
            <div class="icon-illustration mb-4">
                <div class="gear-container">
                    <i class="bi bi-gear-fill gear-large spin-slow text-primary"></i>
                    <i class="bi bi-gear-fill gear-small spin-reverse text-warning"></i>
                    <i class="bi bi-wrench wrench-icon pulse-icon text-info"></i>
                </div>
            </div>
            
            <!-- Tiêu đề chính -->
            <h1 class="maintenance-title mb-3">Hệ Thống Đang Bảo Trì</h1>
            
            <!-- Lời nhắn thuyết minh -->
            <p class="maintenance-subtitle text-muted mb-4 mx-auto">
                Chúng tôi hiện đang tiến hành nâng cấp hệ thống định kỳ để cải thiện chất lượng dịch vụ và bổ sung các tính năng học tập mới. Toàn bộ tính năng sẽ sớm được phục hồi.
            </p>
            
            <!-- Chỉ báo thanh tiến trình ảo động -->
            <div class="progress-container mb-4 mx-auto">
                <div class="progress-bar-animated"></div>
            </div>
            
            <!-- Lời khuyên cho người dùng -->
            <div class="info-alert p-3 rounded-3 mb-4 mx-auto text-start">
                <div class="d-flex">
                    <i class="bi bi-info-circle-fill text-warning fs-4 me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-1 text-light">Bạn cần truy cập gấp?</h6>
                        <p class="mb-0 text-muted small">Hãy liên hệ với Giáo viên quản lý lớp hoặc Quản trị viên của trường để biết thêm chi tiết về lịch hoàn tất.</p>
                    </div>
                </div>
            </div>
            
            <!-- Liên hệ hỗ trợ -->
            <div class="support-section pt-3 border-top border-secondary border-opacity-25">
                <div class="text-muted small mb-2">Trung tâm Hỗ trợ kỹ thuật EduLearn</div>
                <div class="d-flex justify-content-center gap-3">
                    <a href="mailto:support@edulearn.com" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-envelope-fill me-1"></i> support@edulearn.com
                    </a>
                    <a href="tel:19001234" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-telephone-fill me-1"></i> 1900 1234
                    </a>
                </div>
                <div class="mt-3">
                    <a href="/login" class="text-secondary text-decoration-none small hover-link">
                        <i class="bi bi-shield-lock-fill me-1"></i> Đăng nhập dành cho Quản trị viên
                    </a>
                </div>
            </div>
        </div>
        
        <div class="copyright text-center text-muted mt-4">
            &copy; 2026 EduLearn. All rights reserved.
        </div>
    </div>
    
    <!-- Bootstrap JS Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
