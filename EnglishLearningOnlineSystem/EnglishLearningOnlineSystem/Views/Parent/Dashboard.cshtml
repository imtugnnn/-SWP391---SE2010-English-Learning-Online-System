@model EnglishLearningOnlineSystem.ViewModels.ParentDashboardViewModel

@{
    Layout = "_ParentLayout";
    ViewData["Title"] = "Bảng điều khiển";
    ViewData["Subtitle"] = "Tổng quan tình hình học tập của con bạn.";
    ViewData["ActiveNav"] = "dashboard";
    var ov = Model.Overview;
}

@section Styles {
    <style>
        .state-card {
            background: #fff; border-radius: 20px;
            box-shadow: 0 4px 20px rgba(15,23,42,.06);
            padding: 48px 32px; text-align: center;
        }
        .state-icon { font-size: 3rem; margin-bottom: 12px; }
        .state-title { font-size: 1.3rem; font-weight: 900; color: #1e293b; margin-bottom: 8px; }
        .state-desc { color: #64748b; font-weight: 600; margin-bottom: 22px; }
        .btn-primary-soft {
            display: inline-block; background: #2563eb; color: #fff;
            padding: 13px 28px; border-radius: 14px;
            font-weight: 800; text-decoration: none; transition: background .15s;
        }
        .btn-primary-soft:hover { background: #1d4ed8; color: #fff; }

        .child-selector { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 26px; }
        .child-chip {
            display: flex; align-items: center; gap: 10px;
            background: #fff; border: 2px solid #e2e8f0;
            border-radius: 14px; padding: 10px 16px;
            text-decoration: none; color: #1e293b; font-weight: 700;
            transition: border-color .15s, box-shadow .15s;
        }
        .child-chip:hover { border-color: #93c5fd; color: #1e293b; }
        .child-chip.active { border-color: #2563eb; box-shadow: 0 4px 14px rgba(37,99,235,.18); }
        .child-chip-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: #fce7f3; display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
        }
        .child-chip-rel { font-size: .76rem; color: #64748b; font-weight: 600; }

        .child-banner {
            background: linear-gradient(135deg, #2563eb, #1e40af);
            color: #fff; border-radius: 20px; padding: 24px 28px;
            display: flex; align-items: center; gap: 18px; margin-bottom: 24px;
        }
        .child-banner-avatar {
            width: 64px; height: 64px; border-radius: 50%;
            background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center;
            font-size: 2rem; flex-shrink: 0;
        }
        .child-banner-name { font-size: 1.5rem; font-weight: 900; }
        .child-banner-meta { opacity: .9; font-weight: 600; font-size: .92rem; margin-top: 4px; }

        .metric-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 18px; margin-bottom: 28px; }
        .metric-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 4px 16px rgba(15,23,42,.05);
            padding: 22px; display: flex; align-items: center; gap: 16px;
        }
        .metric-icon {
            width: 50px; height: 50px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; flex-shrink: 0;
        }
        .metric-val { font-size: 1.7rem; font-weight: 900; color: #1e293b; line-height: 1; }
        .metric-lbl { font-size: .82rem; color: #64748b; font-weight: 700; margin-top: 4px; }

        .panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
        .panel {
            background: #fff; border-radius: 20px;
            box-shadow: 0 4px 20px rgba(15,23,42,.06); padding: 26px;
        }
        .panel-title { font-size: 1.15rem; font-weight: 900; color: #1e293b; margin-bottom: 18px; }
        .activity-row, .task-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 13px 0; border-bottom: 1px solid #f1f5f9;
        }
        .activity-row:last-child, .task-row:last-child { border-bottom: none; }
        .activity-name { font-weight: 700; color: #1e293b; }
        .activity-meta { font-size: .8rem; color: #64748b; font-weight: 600; margin-top: 2px; }
        .activity-score {
            font-weight: 900; font-size: 1.05rem; flex-shrink: 0;
        }
        .score-good { color: #16a34a; }
        .score-mid { color: #d97706; }
        .score-low { color: #dc2626; }
        .task-badge {
            background: #eff6ff; color: #2563eb;
            font-size: .76rem; font-weight: 800; padding: 4px 10px; border-radius: 99px; flex-shrink: 0;
        }
        .panel-empty { color: #94a3b8; font-weight: 600; text-align: center; padding: 24px 0; }

        .badge-strip { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
        .badge-pill {
            display: flex; align-items: center; gap: 8px;
            background: #fefce8; border: 1.5px solid #fde68a;
            border-radius: 99px; padding: 6px 14px; font-weight: 800; font-size: .85rem; color: #92400e;
        }

        @@media (max-width: 992px) { .panel-grid { grid-template-columns: 1fr; } }
    </style>
}

@if (Model.LoadFailed)
{
    <div class="state-card">
        <div class="state-icon">⚠️</div>
        <div class="state-title">Không thể tải dữ liệu bảng điều khiển</div>
        <div class="state-desc">Đã xảy ra lỗi tạm thời. Vui lòng thử lại sau.</div>
        <a href="/Parent/Dashboard" class="btn-primary-soft">Thử lại</a>
    </div>
}
else if (!Model.HasLinkedChildren)
{
    <div class="state-card">
        <div class="state-icon">👨‍👩‍👧</div>
        <div class="state-title">Bạn chưa liên kết với học sinh nào</div>
        <div class="state-desc">Hãy liên kết tài khoản với hồ sơ học tập của con để bắt đầu theo dõi.</div>
        <a href="/Parent" class="btn-primary-soft">🔗 Liên kết con ngay</a>
    </div>
}
else if (ov != null)
{
    @if (Model.Children.Count > 1)
    {
        <div class="child-selector">
            @foreach (var child in Model.Children)
            {
                <a href="/Parent/Dashboard?studentId=@child.StudentId" class="child-chip @(child.IsSelected ? "active" : "")">
                    <span class="child-chip-avatar">👧</span>
                    <span>
                        @child.DisplayName
                        <span class="child-chip-rel d-block">@(child.Relationship ?? "Con")</span>
                    </span>
                </a>
            }
        </div>
    }

    <div class="child-banner">
        <div class="child-banner-avatar">👧</div>
        <div>
            <div class="child-banner-name">@ov.DisplayName</div>
            <div class="child-banner-meta">
                @@@ov.Username
                @if (!string.IsNullOrWhiteSpace(ov.StudentCode))
                {
                    <span> · Mã: @ov.StudentCode</span>
                }
                @if (ov.LastActiveDate.HasValue)
                {
                    <span> · Hoạt động gần nhất: @ov.LastActiveDate.Value.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </div>
    </div>

    @if (!ov.HasLearningData)
    {
        <div class="state-card" style="margin-bottom:24px;">
            <div class="state-icon">📚</div>
            <div class="state-title">Chưa có dữ liệu học tập</div>
            <div class="state-desc">Con bạn chưa hoàn thành bài học nào. Dữ liệu sẽ hiển thị khi con bắt đầu học.</div>
        </div>
    }

    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-icon" style="background:#dbeafe; color:#2563eb;">📘</div>
            <div>
                <div class="metric-val">@ov.LessonsCompleted</div>
                <div class="metric-lbl">Bài học hoàn thành</div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background:#fef9c3; color:#ca8a04;">⭐</div>
            <div>
                <div class="metric-val">@ov.XP</div>
                <div class="metric-lbl">Tổng XP</div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background:#ffedd5; color:#ea580c;">🔥</div>
            <div>
                <div class="metric-val">@ov.CurrentStreakDays</div>
                <div class="metric-lbl">Chuỗi ngày học</div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background:#ede9fe; color:#7c3aed;">🏅</div>
            <div>
                <div class="metric-val">@ov.BadgesEarned</div>
                <div class="metric-lbl">Huy hiệu</div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background:#dcfce7; color:#16a34a;">📊</div>
            <div>
                <div class="metric-val">@ov.AverageQuizScore%</div>
                <div class="metric-lbl">Điểm quiz TB</div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon" style="background:#e0f2fe; color:#0284c7;">🎯</div>
            <div>
                <div class="metric-val">@ov.Level</div>
                <div class="metric-lbl">Cấp độ</div>
            </div>
        </div>
    </div>

    @if (ov.RecentBadges.Any())
    {
        <div class="panel" style="margin-bottom:24px;">
            <div class="panel-title">Huy hiệu gần đây</div>
            <div class="badge-strip">
                @foreach (var b in ov.RecentBadges)
                {
                    <div class="badge-pill">🏅 @b.BadgeName</div>
                }
            </div>
        </div>
    }

    <div class="panel-grid">
        <div class="panel">
            <div class="panel-title">Hoạt động gần đây</div>
            @if (!ov.RecentActivities.Any())
            {
                <div class="panel-empty">Chưa có hoạt động nào.</div>
            }
            else
            {
                @foreach (var a in ov.RecentActivities)
                {
                    var cls = a.QuizScore >= 80 ? "score-good" : (a.QuizScore >= 50 ? "score-mid" : "score-low");
                    <div class="activity-row">
                        <div>
                            <div class="activity-name">@a.LessonTitle</div>
                            <div class="activity-meta">
                                @a.CompletionStatus
                                @if (a.CompletedAt.HasValue) { <span>· @a.CompletedAt.Value.ToString("dd/MM/yyyy")</span> }
                                · +@a.XPEarned XP
                            </div>
                        </div>
                        <div class="activity-score @cls">@a.QuizScore%</div>
                    </div>
                }
            }
        </div>

        <div class="panel">
            <div class="panel-title">Bài tập sắp tới</div>
            @if (!ov.UpcomingTasks.Any())
            {
                <div class="panel-empty">Không có bài tập sắp tới.</div>
            }
            else
            {
                @foreach (var t in ov.UpcomingTasks)
                {
                    <div class="task-row">
                        <div>
                            <div class="activity-name">@t.LessonTitle</div>
                            <div class="activity-meta">@t.Topic · Hạn: @t.DueDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="task-badge">+@t.XPReward XP</div>
                    </div>
                }
            }
        </div>
    </div>
}
