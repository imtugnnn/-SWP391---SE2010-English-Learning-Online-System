@model EnglishLearningOnlineSystem.ViewModels.TeacherStudentsNeedSupportViewModel

@{
    ViewData["Title"] = "Học sinh cần hỗ trợ";
}

<style>
    body {
        background: #f0f9ff;
    }

    .teacher-class-shell {
        min-height: 100vh;
        padding: 40px 16px;
        background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 60%, #e0f2fe 100%);
    }

    .teacher-class-container {
        max-width: 1180px;
        margin: 0 auto;
    }

    .page-card, .section-card {
        background: #ffffff;
        border: 1.5px solid #bae6fd;
        box-shadow: 0 8px 24px rgba(14,165,233,.08);
        overflow: hidden;
    }

    .page-card {
        border-radius: 28px;
        box-shadow: 0 20px 60px rgba(14,165,233,.16), 0 2px 8px rgba(14,165,233,.08);
    }

    .section-card {
        border-radius: 22px;
    }

    .page-card-stripe {
        height: 6px;
        background: linear-gradient(90deg, #0ea5e9 0%, #38bdf8 50%, #7dd3fc 100%);
    }

    .page-card-body {
        padding: 36px;
    }

    .page-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e0f2fe;
        color: #0369a1;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 99px;
        margin-bottom: 14px;
    }

    .page-badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #0ea5e9;
    }

    .page-title {
        font-size: 1.9rem;
        font-weight: 900;
        color: #1e3a5f;
        margin-bottom: 8px;
    }

    .page-title span {
        color: #0284c7;
    }

    .page-subtitle {
        color: #64748b;
        font-size: .95rem;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .summary-card {
        background: #f0f9ff;
        border: 1.5px solid #bae6fd;
        border-radius: 18px;
        padding: 20px;
        height: 100%;
    }

    .summary-label {
        font-size: .78rem;
        font-weight: 900;
        color: #0369a1;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .summary-value {
        font-size: 1.7rem;
        font-weight: 900;
        color: #1e3a5f;
        margin: 0;
    }

    .section-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e0f2fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .section-title {
        font-weight: 900;
        color: #1e3a5f;
        margin: 0;
        font-size: 1.05rem;
    }

    .btn-teacher {
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
        color: #fff;
        font-weight: 800;
        padding: 10px 16px;
        box-shadow: 0 6px 20px rgba(14,165,233,.28);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-teacher:hover {
        color: #fff;
        opacity: .92;
    }

    .btn-teacher-outline {
        border: 1.5px solid #38bdf8;
        border-radius: 14px;
        color: #0369a1;
        font-weight: 800;
        padding: 8px 14px;
        text-decoration: none;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-teacher-outline:hover {
        background: #e0f2fe;
        color: #0369a1;
    }

    .form-control, .form-select {
        border-radius: 14px;
        border: 1.5px solid #bae6fd;
        padding: 10px 12px;
    }

    .form-label {
        color: #0369a1;
        font-size: .78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #f0f9ff;
        color: #0369a1;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-bottom: 1px solid #bae6fd;
        padding: 14px 18px;
    }

    .table tbody td {
        padding: 16px 18px;
        vertical-align: middle;
        color: #334155;
    }

    .badge-soft-primary, .badge-soft-warning, .badge-soft-danger, .badge-soft-secondary {
        border-radius: 99px;
        padding: 7px 11px;
        font-weight: 800;
        display: inline-flex;
        margin: 2px;
        white-space: nowrap;
    }

    .badge-soft-primary {
        background: #e0f2fe;
        color: #0369a1;
    }

    .badge-soft-warning {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-soft-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-soft-secondary {
        background: #e2e8f0;
        color: #475569;
    }

    .empty-state {
        padding: 32px;
        text-align: center;
        color: #64748b;
        background: #ffffff;
    }
</style>

<div class="teacher-class-shell">
    <div class="teacher-class-container">
        <div class="page-card mb-4">
            <div class="page-card-stripe"></div>

            <div class="page-card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                    <div>
                        <div class="page-badge">
                            <span class="page-badge-dot"></span>
                            Teacher Support
                        </div>

                        <h1 class="page-title">
                            Học sinh <span>cần hỗ trợ</span>
                        </h1>

                        <p class="page-subtitle">
                            Danh sách học sinh có dấu hiệu cần giáo viên theo dõi dựa trên điểm quiz, bài quá hạn, mức độ hoạt động và bài chưa bắt đầu.
                        </p>
                    </div>

                    <a asp-controller="Teacher"
                       asp-action="Dashboard"
                       class="btn-teacher-outline">
                        Quay lại Dashboard
                    </a>
                </div>

                <div class="row g-3">
                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Cần hỗ trợ</div>
                            <p class="summary-value">@Model.TotalNeedSupport</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Điểm thấp</div>
                            <p class="summary-value">@Model.LowScoreCount</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Quá hạn</div>
                            <p class="summary-value">@Model.OverdueCount</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Không hoạt động</div>
                            <p class="summary-value">@Model.InactiveCount</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Chưa bắt đầu</div>
                            <p class="summary-value">@Model.NotStartedCount</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card mb-4">
            <div class="section-header">
                <h2 class="section-title">Bộ lọc</h2>
            </div>

            <div class="p-4">
                <form method="get" asp-controller="Teacher" asp-action="StudentsNeedSupport">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label" for="teacher-support-class">Lớp</label>
                            <select name="classFilter" id="teacher-support-class" class="form-select">
                                <option value="all" selected="@(Model.ClassFilter == "all")">Tất cả lớp</option>
                                @foreach (var classItem in Model.Classes)
                                {
                                    <option value="@classItem.ClassId" selected="@(Model.ClassFilter == classItem.ClassId.ToString())">
                                        @classItem.ClassName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label" for="teacher-support-reason">Lý do</label>
                            <select name="reason" id="teacher-support-reason" class="form-select">
                                <option value="all" selected="@(Model.ReasonFilter == "all")">Tất cả</option>
                                <option value="low-score" selected="@(Model.ReasonFilter == "low-score")">Điểm quiz thấp</option>
                                <option value="overdue" selected="@(Model.ReasonFilter == "overdue")">Bài quá hạn</option>
                                <option value="inactive" selected="@(Model.ReasonFilter == "inactive")">Không hoạt động</option>
                                <option value="not-started" selected="@(Model.ReasonFilter == "not-started")">Chưa bắt đầu</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label" for="teacher-support-sort">Sắp xếp</label>
                            <select name="sortBy" id="teacher-support-sort" class="form-select">
                                <option value="risk" selected="@(Model.SortBy == "risk")">Mức độ rủi ro</option>
                                <option value="score" selected="@(Model.SortBy == "score")">Điểm thấp nhất</option>
                                <option value="overdue" selected="@(Model.SortBy == "overdue")">Quá hạn nhiều nhất</option>
                                <option value="last-active" selected="@(Model.SortBy == "last-active")">Ít hoạt động nhất</option>
                            </select>
                        </div>

                        <div class="col-md-2 d-grid">
                            <button type="submit" class="btn-teacher">Lọc</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <h2 class="section-title">Danh sách học sinh</h2>
                <span class="page-badge mb-0">
                    <span class="page-badge-dot"></span>
                    @Model.Students.Count kết quả
                </span>
            </div>

            @if (Model.Students.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Học sinh</th>
                                <th>Lớp</th>
                                <th>Điểm TB</th>
                                <th>Quá hạn</th>
                                <th>Chưa bắt đầu</th>
                                <th>Hoạt động gần nhất</th>
                                <th>Lý do</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>
                                        <strong>@student.StudentName</strong>
                                        <div class="text-muted small">@student.Email</div>
                                    </td>
                                    <td>@student.ClassName</td>
                                    <td>@student.AverageQuizScoreText</td>
                                    <td>@student.OverdueLessonCount</td>
                                    <td>@student.NotStartedLessonCount</td>
                                    <td>@student.LastActiveText</td>
                                    <td>
                                        @foreach (var reason in student.Reasons)
                                        {
                                            var badgeClass = reason switch
                                            {
                                                "Điểm quiz thấp" => "badge-soft-danger",
                                                "Bài quá hạn" => "badge-soft-warning",
                                                "Không hoạt động" => "badge-soft-secondary",
                                                _ => "badge-soft-primary"
                                            };
                                            <span class="@badgeClass">@reason</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a asp-controller="Teacher"
                                               asp-action="StudentDetail"
                                               asp-route-classId="@student.ClassId"
                                               asp-route-studentId="@student.StudentId"
                                               class="btn-teacher-outline">
                                                Xem chi tiết
                                            </a>

                                            <a asp-controller="Teacher"
                                               asp-action="ProvideFeedback"
                                               asp-route-classId="@student.ClassId"
                                               asp-route-studentId="@student.StudentId"
                                               class="btn-teacher">
                                                Gửi phản hồi
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    Không có học sinh nào phù hợp với điều kiện lọc.
                </div>
            }
        </div>
    </div>
</div>
