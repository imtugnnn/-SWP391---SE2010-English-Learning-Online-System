@model EnglishLearningOnlineSystem.ViewModels.AssignWeeklyLessonViewModel

@{
    ViewData["Title"] = "Giao bài học theo tuần";
}

<style>
    body {
        background: #f0f9ff;
    }

    .teacher-class-shell {
        min-height: 100vh;
        padding: 40px 16px;
        background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 60%, #e0f2fe 100%);
    }

    .teacher-class-container {
        max-width: 1180px;
        margin: 0 auto;
    }

    .page-card, .section-card {
        background: #ffffff;
        border: 1.5px solid #bae6fd;
        box-shadow: 0 8px 24px rgba(14,165,233,.08);
        overflow: hidden;
    }

    .page-card {
        border-radius: 28px;
        box-shadow: 0 20px 60px rgba(14,165,233,.16), 0 2px 8px rgba(14,165,233,.08);
    }

    .section-card {
        border-radius: 22px;
    }

    .page-card-stripe {
        height: 6px;
        background: linear-gradient(90deg, #0ea5e9 0%, #38bdf8 50%, #7dd3fc 100%);
    }

    .page-card-body {
        padding: 36px;
    }

    .page-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e0f2fe;
        color: #0369a1;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 99px;
        margin-bottom: 14px;
    }

    .page-badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #0ea5e9;
    }

    .page-title {
        font-size: 1.9rem;
        font-weight: 900;
        color: #1e3a5f;
        margin-bottom: 8px;
    }

        .page-title span {
            color: #0284c7;
        }

    .page-subtitle {
        color: #64748b;
        font-size: .95rem;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .summary-card {
        background: #f0f9ff;
        border: 1.5px solid #bae6fd;
        border-radius: 18px;
        padding: 20px;
        height: 100%;
    }

    .summary-label {
        font-size: .78rem;
        font-weight: 900;
        color: #0369a1;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .summary-value {
        font-size: 1rem;
        font-weight: 800;
        color: #1e3a5f;
        margin: 0;
    }

    .section-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e0f2fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .section-title {
        font-weight: 900;
        color: #1e3a5f;
        margin: 0;
        font-size: 1.05rem;
    }

    .form-label {
        color: #0369a1;
        font-size: .78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .form-control {
        border-radius: 14px;
        border: 1.5px solid #bae6fd;
        padding: 10px 12px;
    }

        .form-control:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 .2rem rgba(14,165,233,.15);
        }


    .form-select {
        border-radius: 14px;
        border: 1.5px solid #bae6fd;
        padding: 10px 12px;
    }

        .form-select:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 .2rem rgba(14,165,233,.15);
        }

    .btn-teacher {
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
        color: #fff;
        font-weight: 800;
        padding: 10px 16px;
        box-shadow: 0 6px 20px rgba(14,165,233,.28);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-teacher:hover {
            color: #fff;
            opacity: .92;
        }

    .btn-teacher-outline {
        border: 1.5px solid #38bdf8;
        border-radius: 14px;
        color: #0369a1;
        font-weight: 800;
        padding: 8px 14px;
        text-decoration: none;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-teacher-outline:hover {
            background: #e0f2fe;
            color: #0369a1;
        }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background: #f0f9ff;
            color: #0369a1;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            border-bottom: 1px solid #bae6fd;
            padding: 14px 18px;
        }

        .table tbody td {
            padding: 16px 18px;
            vertical-align: middle;
            color: #334155;
        }

    .lesson-check {
        width: 18px;
        height: 18px;
        border: 1.5px solid #38bdf8;
    }

    .badge-soft-primary {
        background: #e0f2fe;
        color: #0369a1;
        border-radius: 99px;
        padding: 7px 11px;
        font-weight: 800;
    }

    .empty-state {
        padding: 32px;
        text-align: center;
        color: #64748b;
        background: #ffffff;
    }

    .validation-summary-errors {
        background: #fee2e2;
        color: #991b1b;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 18px;
        font-weight: 700;
    }

    .assignment-content-picker {
        display: none;
        border: 1px solid #bae6fd;
        border-radius: 14px;
        background: #f8fcff;
        padding: 14px;
    }

    .assignment-content-picker.is-open {
        display: block;
    }

    .assignment-content-group + .assignment-content-group {
        border-top: 1px solid #dbeafe;
        margin-top: 12px;
        padding-top: 12px;
    }

    .assignment-content-items {
        display: grid;
        gap: 8px;
        margin: 8px 0 0 24px;
        max-height: 220px;
        overflow-y: auto;
    }

    .assignment-content-items.is-disabled {
        display: none;
    }

    .assignment-content-option {
        align-items: flex-start;
        display: flex;
        gap: 8px;
        color: #334155;
        cursor: pointer;
        font-size: .9rem;
    }
</style>

<div class="teacher-class-shell">
    <div class="teacher-class-container">

        <div class="page-card mb-4">
            <div class="page-card-stripe"></div>

            <div class="page-card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                    <div>
                        <div class="page-badge">
                            <span class="page-badge-dot"></span>
                            Teacher Assignment
                        </div>

                        <h1 class="page-title">
                            Giao bài học cho lớp <span>@Model.ClassName</span>
                        </h1>

                        <p class="page-subtitle">
                            Chọn bài học, ngày bắt đầu và hạn hoàn thành để tạo bài giao theo tuần.
                        </p>
                    </div>

                    <a asp-controller="Teacher"
                       asp-action="AssignmentOverview"
                       asp-route-classId="@Model.ClassId"
                       class="btn-teacher-outline">
                        Quay lại bài giao tuần
                    </a>
                </div>

                <form asp-controller="Teacher"
                      asp-action="AssignWeeklyLessons"
                      method="post"
                      id="weeklyAssignmentForm"
                      data-class-name="@Model.ClassName"
                      data-student-count="@Model.ActiveStudentCount">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="ClassId" />
                    <input type="hidden" asp-for="ClassName" />
                    <input type="hidden" asp-for="CourseId" />

                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="summary-card">
                                <label asp-for="WeekStartDate" class="form-label">Ngày bắt đầu</label>
                                <input asp-for="WeekStartDate" type="date" class="form-control" />
                                <span asp-validation-for="WeekStartDate" class="text-danger small fw-semibold"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="summary-card">
                                <label asp-for="DueDate" class="form-label">Hạn hoàn thành</label>
                                <input asp-for="DueDate" type="date" class="form-control" />
                                <span asp-validation-for="DueDate" class="text-danger small fw-semibold"></span>
                            </div>
                        </div>
                    </div>

                    <div class="summary-card mb-4">
                        <label asp-for="Status" class="form-label">Trạng thái bài giao</label>
                        <select asp-for="Status" class="form-select" id="assignmentStatus">
                            <option value="Published">Xuất bản ngay</option>
                            <option value="Draft">Lưu bản nháp</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small fw-semibold"></span>
                        <div class="text-muted small mt-2" id="assignmentStatusHelp">
                            Bản nháp không hiển thị cho học sinh và không gửi thông báo.
                        </div>
                    </div>

                    @if (Model.HasCourse)
                    {
                        <div class="summary-card mb-4">
                            <div class="summary-label">Chương trình học</div>
                            <p class="summary-value">@Model.CourseName</p>
                        </div>

                        <input type="hidden" asp-for="SelectedCourseId" />
                    }
                    else
                    {
                        <div class="section-card mb-4">
                            <div class="section-header">
                                <h2 class="section-title">Chương trình học</h2>
                            </div>

                            <div class="p-4">
                                <label asp-for="SelectedCourseId" class="form-label">
                                    Chọn chương trình học
                                </label>

                                <select asp-for="SelectedCourseId"
                                        class="form-select"
                                        id="selectedCourseId">
                                    <option value="">-- Chọn chương trình học --</option>

                                    @foreach (var course in Model.Courses)
                                    {
                                        <option value="@course.CourseId">
                                            @course.CourseName - @course.GradeLevel
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="SelectedCourseId"
                                      class="text-danger small fw-semibold"></span>

                                <div class="alert alert-warning mt-3 mb-0">
                                    Lớp này chưa có chương trình học. Vui lòng chọn chương trình học để tải danh sách bài học.
                                </div>
                            </div>
                        </div>
                    }
                    <div class="section-card mb-4">
                        <div class="section-header">
                            <div>
                                <h2 class="section-title">Danh sách bài học</h2>
                                <p class="section-subtitle mb-0">
                                    Xem nội dung trước khi chọn bài để giao cho học sinh.
                                </p>
                            </div>

                            <label class="lesson-select-all">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="selectAllLessons"
                                       aria-label="Chọn tất cả bài học" />
                                Chọn tất cả
                            </label>
                        </div>

                        @if (Model.Lessons.Count > 0)
                        {
                            <div class="p-4">
                                <div class="row g-4 align-items-start">
                                    <div class="col-xl-8">
                                        <div class="lesson-selection-list">
                                        @for (var lessonIndex = 0; lessonIndex < Model.Lessons.Count; lessonIndex++)
                                        {
                                            var lesson = Model.Lessons[lessonIndex];
                                            var previewUrl = Url.Action(
                                                "LessonPreview",
                                                "Teacher",
                                                new
                                                {
                                                    classId = Model.ClassId,
                                                    lessonId = lesson.LessonId,
                                                    selectedCourseId = Model.SelectedCourseId
                                                });

                                            <article class="lesson-selection-card">
                                                <input type="hidden"
                                                       name="Lessons[@lessonIndex].LessonId"
                                                       value="@lesson.LessonId" />
                                                <div class="lesson-selection-card__check">
                                                    <input class="form-check-input lesson-check"
                                                           type="checkbox"
                                                           name="SelectedLessonIds"
                                                           value="@lesson.LessonId"
                                                           data-title="@lesson.Title"
                                                           data-duration="@lesson.EstimatedMinutes"
                                                           data-xp="@lesson.XPReward"
                                                           data-vocabulary="@lesson.VocabularyCount"
                                                           data-quiz="@lesson.QuizCount"
                                                           data-games="@lesson.MiniGameCount"
                                                           data-preview-url="@previewUrl"
                                                           @(Model.SelectedLessonIds.Contains(lesson.LessonId) ? "checked" : null) />
                                                </div>
                                                <div class="lesson-selection-card__body">
                                                    <div class="d-flex justify-content-between gap-3 flex-wrap">
                                                        <div>
                                                            <h3>@lesson.Title</h3>
                                                            <p>@lesson.Topic</p>
                                                        </div>
                                                        <div class="lesson-selection-card__meta">
                                                            <span>@lesson.EstimatedMinutes phút</span>
                                                            <span>@lesson.XPReward XP</span>
                                                        </div>
                                                    </div>

                                                    <div class="lesson-content-counts">
                                                        <span>@lesson.VocabularyCount từ vựng</span>
                                                        <span>@lesson.QuizCount câu quiz</span>
                                                        <span>@lesson.MiniGameCount mini game</span>
                                                    </div>

                                                    <div class="assignment-content-picker mt-3"
                                                         data-content-picker="@lesson.LessonId">
                                                        <div class="fw-bold text-primary mb-2">
                                                            Chọn nội dung cần giao
                                                        </div>

                                                        @if (lesson.Vocabularies.Count > 0)
                                                        {
                                                            <div class="assignment-content-group">
                                                                <label class="form-check fw-bold">
                                                                    <input asp-for="Lessons[lessonIndex].IncludeVocabulary"
                                                                           class="form-check-input activity-type-check"
                                                                           data-target="vocabulary-@lesson.LessonId" />
                                                                    Từ vựng / Flashcard
                                                                </label>
                                                                <div id="vocabulary-@lesson.LessonId"
                                                                     class="assignment-content-items">
                                                                    <div class="small text-muted mb-2">
                                                                        Chọn từng từ mới học sinh cần ôn tập:
                                                                    </div>
                                                                    @foreach (var vocabulary in lesson.Vocabularies)
                                                                    {
                                                                        <label class="assignment-content-option">
                                                                            <input type="checkbox"
                                                                                   class="form-check-input content-item-check"
                                                                                   data-kind="vocabulary"
                                                                                   name="Lessons[@lessonIndex].SelectedVocabularyIds"
                                                                                   value="@vocabulary.VocabularyId"
                                                                                   @(lesson.SelectedVocabularyIds.Contains(vocabulary.VocabularyId) ? "checked" : null) />
                                                                            <span>
                                                                                <strong>@vocabulary.Word</strong>
                                                                                — @vocabulary.Meaning
                                                                            </span>
                                                                        </label>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (lesson.Quizzes.Count > 0)
                                                        {
                                                            <div class="assignment-content-group">
                                                                <label class="form-check fw-bold">
                                                                    <input asp-for="Lessons[lessonIndex].IncludeQuiz"
                                                                           class="form-check-input activity-type-check"
                                                                           data-target="quiz-@lesson.LessonId" />
                                                                    Quiz
                                                                </label>
                                                                <div id="quiz-@lesson.LessonId"
                                                                     class="assignment-content-items">
                                                                    @foreach (var quiz in lesson.Quizzes)
                                                                    {
                                                                        <label class="assignment-content-option">
                                                                            <input type="checkbox"
                                                                                   class="form-check-input content-item-check"
                                                                                   data-kind="quiz"
                                                                                   name="Lessons[@lessonIndex].SelectedQuizIds"
                                                                                   value="@quiz.QuizId"
                                                                                   @(lesson.SelectedQuizIds.Contains(quiz.QuizId) ? "checked" : null) />
                                                                            <span>
                                                                                @quiz.Question
                                                                                <small class="text-muted">(@quiz.QuizType)</small>
                                                                            </span>
                                                                        </label>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (lesson.MiniGames.Count > 0)
                                                        {
                                                            <div class="assignment-content-group">
                                                                <label class="form-check fw-bold">
                                                                    <input asp-for="Lessons[lessonIndex].IncludeMiniGame"
                                                                           class="form-check-input activity-type-check"
                                                                           data-target="game-@lesson.LessonId" />
                                                                    Mini game
                                                                </label>
                                                                <div id="game-@lesson.LessonId"
                                                                     class="assignment-content-items">
                                                                    @foreach (var game in lesson.MiniGames)
                                                                    {
                                                                        <label class="assignment-content-option">
                                                                            <input type="checkbox"
                                                                                   class="form-check-input content-item-check"
                                                                                   data-kind="game"
                                                                                   name="Lessons[@lessonIndex].SelectedMiniGameIds"
                                                                                   value="@game.GameId"
                                                                                   @(lesson.SelectedMiniGameIds.Contains(game.GameId) ? "checked" : null) />
                                                                            <span>@game.Title <small class="text-muted">(@game.GameType)</small></span>
                                                                        </label>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="d-flex gap-2 flex-wrap mt-3">
                                                        <button type="button"
                                                                class="btn-teacher-outline"
                                                                data-toggle-content-picker="@lesson.LessonId">
                                                            Tùy chọn nội dung
                                                        </button>
                                                        <button type="button"
                                                                class="btn-teacher-outline"
                                                                data-lesson-preview-url="@previewUrl">
                                                            Xem nội dung
                                                        </button>
                                                    </div>
                                                </div>
                                            </article>
                                        }
                                        </div>
                                    </div>

                                    <div class="col-xl-4">
                                        <aside class="selected-lessons-panel">
                                            <div class="selected-lessons-panel__header">
                                                <div>
                                                    <span>Bài học đã chọn</span>
                                                    <strong><span id="selectedLessonCount">@Model.SelectedLessonIds.Count</span> bài</strong>
                                                </div>
                                            </div>

                                            <div id="selectedLessonsEmpty" class="selected-lessons-empty">
                                                Chưa chọn bài học nào.
                                            </div>

                                            <ol id="selectedLessonsList" class="selected-lessons-list"></ol>

                                            <div class="selected-lessons-totals">
                                                <div><strong id="selectedVocabularyTotal">0</strong><span>Từ vựng</span></div>
                                                <div><strong id="selectedQuizTotal">0</strong><span>Quiz</span></div>
                                                <div><strong id="selectedGameTotal">0</strong><span>Mini game</span></div>
                                                <div><strong id="selectedDurationTotal">0</strong><span>Phút</span></div>
                                                <div><strong id="selectedXpTotal">0</strong><span>XP</span></div>
                                            </div>
                                        </aside>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                @if (!Model.SelectedCourseId.HasValue)
                                {
                                    <div>Vui lòng chọn chương trình học để hiển thị danh sách bài học.</div>
                                }
                                else
                                {
                                    <div>Chương trình học này chưa có bài học đã xuất bản.</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                        <a asp-controller="Teacher"
                           asp-action="AssignmentOverview"
                           asp-route-classId="@Model.ClassId"
                           class="btn-teacher-outline">
                            Hủy
                        </a>

                        @if (Model.Lessons.Count > 0)
                        {
                            <button type="submit" class="btn-teacher" id="assignmentSubmitButton">
                                @(Model.Status == EnglishLearningOnlineSystem.Models.AssignmentStatus.Draft
                                    ? "Lưu bản nháp"
                                    : "Giao bài ngay")
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>

        <partial name="_LessonPreviewDrawer" />
        <partial name="_PublishAssignmentConfirmation" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/teacher/lesson-preview.js" asp-append-version="true"></script>
    <script src="~/js/teacher/weekly-assignment-selection.js" asp-append-version="true"></script>

    @if (!Model.HasCourse)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const courseSelect = document.getElementById("selectedCourseId");

                if (!courseSelect) {
                    return;
                }

                courseSelect.addEventListener("change", function () {
                    if (this.value === "") {
                        return;
                    }

                    const targetUrl = new URL(
                        '@Url.Action("AssignWeeklyLessons", "Teacher")',
                        window.location.origin);
                    targetUrl.searchParams.set("classId", "@Model.ClassId");
                    targetUrl.searchParams.set("selectedCourseId", this.value);
                    window.location.assign(targetUrl.toString());
                });
            });
        </script>
    }
}
