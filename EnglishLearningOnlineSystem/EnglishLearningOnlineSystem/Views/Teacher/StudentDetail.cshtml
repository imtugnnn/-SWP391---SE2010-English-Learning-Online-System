@model EnglishLearningOnlineSystem.ViewModels.TeacherStudentDetailViewModel

@{
    ViewData["Title"] = "Chi tiết học sinh";
}

<style>
    body {
        background: #f0f9ff;
    }

    .teacher-class-shell {
        min-height: 100vh;
        padding: 40px 16px;
        background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 60%, #e0f2fe 100%);
    }

    .teacher-class-container {
        max-width: 1180px;
        margin: 0 auto;
    }

    .page-card, .section-card {
        background: #ffffff;
        border: 1.5px solid #bae6fd;
        box-shadow: 0 8px 24px rgba(14,165,233,.08);
        overflow: hidden;
    }

    .page-card {
        border-radius: 28px;
        box-shadow: 0 20px 60px rgba(14,165,233,.16), 0 2px 8px rgba(14,165,233,.08);
    }

    .section-card {
        border-radius: 22px;
    }

    .page-card-stripe {
        height: 6px;
        background: linear-gradient(90deg, #0ea5e9 0%, #38bdf8 50%, #7dd3fc 100%);
    }

    .page-card-body {
        padding: 36px;
    }

    .page-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e0f2fe;
        color: #0369a1;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 99px;
        margin-bottom: 14px;
    }

    .page-badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #0ea5e9;
    }

    .page-title {
        font-size: 1.9rem;
        font-weight: 900;
        color: #1e3a5f;
        margin-bottom: 8px;
    }

        .page-title span {
            color: #0284c7;
        }

    .page-subtitle {
        color: #64748b;
        font-size: .95rem;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .student-avatar {
        width: 92px;
        height: 92px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #bae6fd;
        background: #e0f2fe;
    }

    .summary-card {
        background: #f0f9ff;
        border: 1.5px solid #bae6fd;
        border-radius: 18px;
        padding: 20px;
        height: 100%;
    }

    .summary-label {
        font-size: .78rem;
        font-weight: 900;
        color: #0369a1;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .summary-value {
        font-size: 1.7rem;
        font-weight: 900;
        color: #1e3a5f;
        margin: 0;
    }

    .info-label {
        font-size: .75rem;
        font-weight: 900;
        color: #0369a1;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .info-value {
        font-size: .98rem;
        color: #334155;
        font-weight: 700;
        margin: 0;
    }

    .section-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e0f2fe;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .section-title {
        font-weight: 900;
        color: #1e3a5f;
        margin: 0;
        font-size: 1.05rem;
    }

    .btn-teacher {
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
        color: #fff;
        font-weight: 800;
        padding: 10px 16px;
        box-shadow: 0 6px 20px rgba(14,165,233,.28);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-teacher:hover {
            color: #fff;
            opacity: .92;
        }

    .btn-teacher-outline {
        border: 1.5px solid #38bdf8;
        border-radius: 14px;
        color: #0369a1;
        font-weight: 800;
        padding: 8px 14px;
        text-decoration: none;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-teacher-outline:hover {
            background: #e0f2fe;
            color: #0369a1;
        }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background: #f0f9ff;
            color: #0369a1;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            border-bottom: 1px solid #bae6fd;
            padding: 14px 18px;
        }

        .table tbody td {
            padding: 16px 18px;
            vertical-align: middle;
            color: #334155;
        }

    .badge-soft-success {
        background: #dcfce7;
        color: #166534;
        border-radius: 99px;
        padding: 7px 11px;
        font-weight: 800;
    }

    .badge-soft-primary {
        background: #e0f2fe;
        color: #0369a1;
        border-radius: 99px;
        padding: 7px 11px;
        font-weight: 800;
    }

    .badge-soft-secondary {
        background: #e2e8f0;
        color: #475569;
        border-radius: 99px;
        padding: 7px 11px;
        font-weight: 800;
    }

    .empty-state {
        padding: 32px;
        text-align: center;
        color: #64748b;
        background: #ffffff;
    }

    .feedback-box {
        background: #f8fafc;
        border: 1px solid #e0f2fe;
        border-radius: 18px;
        padding: 18px;
        margin-bottom: 14px;
    }

    .feedback-content {
        color: #334155;
        margin-bottom: 10px;
        line-height: 1.6;
    }
</style>

<div class="teacher-class-shell">
    <div class="teacher-class-container">

        <div class="page-card mb-4">
            <div class="page-card-stripe"></div>

            <div class="page-card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
                    <div class="d-flex gap-3 align-items-center">
                        <img src="@Model.AvatarUrl" alt="Ảnh đại diện học sinh" class="student-avatar" />

                        <div>
                            <div class="page-badge">
                                <span class="page-badge-dot"></span>
                                Student Detail
                            </div>

                            <h1 class="page-title">
                                Hồ sơ học sinh <span>@Model.StudentName</span>
                            </h1>

                            <p class="page-subtitle">
                                Theo dõi thông tin cá nhân, tiến độ bài học và phản hồi của học sinh trong lớp @Model.ClassName.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Teacher"
                           asp-action="ManageStudentList"
                           asp-route-classId="@Model.ClassId"
                           class="btn-teacher-outline">
                            Danh sách học sinh
                        </a>

                        <a asp-controller="Teacher"
                           asp-action="ClassDetail"
                           asp-route-classId="@Model.ClassId"
                           class="btn-teacher-outline">
                            Chi tiết lớp
                        </a>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="summary-card">
                            <div class="info-label">Tên học sinh</div>
                            <p class="info-value">@Model.StudentName</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="summary-card">
                            <div class="info-label">Biệt danh</div>
                            <p class="info-value">@Model.Nickname</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="summary-card">
                            <div class="info-label">Email</div>
                            <p class="info-value">@Model.Email</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="summary-card">
                            <div class="info-label">Hoạt động gần nhất</div>
                            <p class="info-value">
                                @(Model.LastActiveDate.HasValue
                                    ? Model.LastActiveDate.Value.ToString("dd/MM/yyyy")
                                    : "Chưa cập nhật")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="summary-card">
                            <div class="summary-label">Level</div>
                            <p class="summary-value">@Model.Level</p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-card">
                            <div class="summary-label">XP hiện tại</div>
                            <p class="summary-value">@Model.XP</p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-card">
                            <div class="summary-label">Streak</div>
                            <p class="summary-value">@Model.CurrentStreakDays</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-card mb-4">
            <div class="page-card-stripe"></div>

            <div class="page-card-body">
                <div class="section-header px-0 pt-0">
                    <h2 class="section-title">Tổng quan học tập</h2>

                    <a href="#feedback-compose" class="btn-teacher">
                        Gửi phản hồi
                    </a>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Bài đã hoàn thành</div>
                            <p class="summary-value">@Model.CompletedLessons</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Đang học</div>
                            <p class="summary-value">@Model.InProgressLessons</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Điểm quiz TB</div>
                            <p class="summary-value">@Model.AverageQuizScore</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">XP đã nhận</div>
                            <p class="summary-value">@Model.TotalXPEarned</p>
                        </div>
                    </div>

                    <div class="col-md">
                        <div class="summary-card">
                            <div class="summary-label">Thời lượng ước tính đã học</div>
                            <p class="summary-value">@Model.StudyDurationMinutes phút</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card mb-4">
            <div class="section-header">
                <h2 class="section-title">Tiến độ bài học</h2>
            </div>

            @if (Model.LessonProgresses.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Bài học</th>
                                <th>Chủ đề</th>
                                <th>Điểm quiz</th>
                                <th>Hoạt động</th>
                                <th>Hạn nộp</th>
                                <th>Trạng thái</th>
                                <th>Ngày hoàn thành</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.LessonProgresses)
                            {
                                <tr>
                                    <td class="fw-bold">@item.LessonTitle</td>
                                    <td>@item.Topic</td>
                                    <td>@item.QuizScore</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (item.FlashcardStatus != "NotAssigned") { <span class="badge-soft-secondary">Flashcard: @item.FlashcardStatus</span> }
                                            @if (item.QuizStatus != "NotAssigned") { <span class="badge-soft-primary">Quiz: @item.QuizStatus</span> }
                                            @if (item.MiniGameStatus != "NotAssigned") { <span class="badge-soft-secondary">Game: @item.MiniGameStatus</span> }
                                        </div>
                                    </td>
                                    <td>@(item.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>
                                        @if (item.CompletionStatus.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-soft-success">@(item.IsCompletedLate ? "Hoàn thành muộn" : "Hoàn thành")</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft-primary">@item.CompletionStatus</span>
                                        }
                                </td>
                                <td>
                                    @(item.CompletedAt.HasValue
                                                                    ? item.CompletedAt.Value.ToString("dd/MM/yyyy")
                                                                    : "Chưa hoàn thành")
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    Học sinh chưa có dữ liệu tiến độ bài học.
                </div>
            }
        </div>

        <div class="section-card">
            <div class="section-header">
                <h2 class="section-title">Lịch sử phản hồi</h2>

                <a href="#feedback-compose" class="btn-teacher">
                    Thêm phản hồi
                </a>
            </div>

            <div class="p-4">
                @if (Model.Feedbacks.Count > 0)
                {
                    foreach (var feedback in Model.Feedbacks)
                    {
                        <div class="feedback-box">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                <div>
                                    <strong>@feedback.TeacherName</strong>
                                    <div class="text-muted small">
                                        @feedback.CreateAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>

                                @if (feedback.IsRead)
                                {
                                    <span class="badge-soft-success">@feedback.ReadStatus</span>
                                }
                                else
                                {
                                    <span class="badge-soft-secondary">@feedback.ReadStatus</span>
                                }
                            </div>

                            <p class="feedback-content mt-3">@feedback.Content</p>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        Chưa có phản hồi nào cho học sinh này.
                    </div>
                }
            </div>
        </div>

        <div class="section-card mt-4" id="feedback-compose">
            <div class="section-header">
                <div>
                    <h2 class="section-title">Gửi phản hồi học tập</h2>
                    <p class="mb-0 text-muted">Phản hồi sẽ được lưu vào hồ sơ của học sinh và tạo thông báo mới.</p>
                </div>
            </div>
            <form asp-controller="Teacher" asp-action="ProvideFeedback" method="post" class="p-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClassId" value="@Model.ClassId" />
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <div class="mb-3">
                    <label for="student-feedback-content" class="form-label fw-bold">Nội dung phản hồi</label>
                    <textarea id="student-feedback-content" name="Content" class="form-control" rows="5" maxlength="1000" required placeholder="Nêu điểm học sinh làm tốt và một hành động cụ thể cần cải thiện..."></textarea>
                    <div class="d-flex justify-content-between mt-2 text-muted small"><span>Tối đa 1000 ký tự</span><span id="student-feedback-count">0/1000</span></div>
                </div>
                <div class="d-flex justify-content-end"><button type="submit" class="btn-teacher">Gửi phản hồi</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById('student-feedback-content');
            const count = document.getElementById('student-feedback-count');
            if (!input || !count) return;
            const update = () => count.textContent = `${input.value.length}/1000`;
            input.addEventListener('input', update);
            update();
        })();
    </script>
}
