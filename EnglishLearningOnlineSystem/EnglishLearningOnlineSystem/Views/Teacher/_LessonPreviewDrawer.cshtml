<div class="offcanvas offcanvas-end lesson-preview-drawer"
     tabindex="-1"
     id="teacherLessonPreviewDrawer"
     aria-labelledby="teacherLessonPreviewDrawerLabel">
    <div class="offcanvas-header border-bottom">
        <div>
            <div class="teacher-topbar__eyebrow">Nội dung chỉ đọc</div>
            <h2 class="offcanvas-title fs-5" id="teacherLessonPreviewDrawerLabel">
                Xem trước bài học
            </h2>
        </div>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Đóng"></button>
    </div>

    <div class="offcanvas-body" id="teacherLessonPreviewContent">
        <div class="lesson-preview-state">
            Chọn một bài học để xem nội dung.
        </div>
    </div>
</div>
