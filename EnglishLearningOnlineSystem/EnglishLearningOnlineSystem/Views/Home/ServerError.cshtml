@model EnglishLearningOnlineSystem.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "System Error - 500";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    .error-container {
        font-family: 'Plus Jakarta Sans', sans-serif;
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .error-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(245, 158, 11, 0.15);
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
        padding: 3.5rem;
        text-align: center;
        max-width: 700px;
        width: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .error-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(245, 158, 11, 0.08), 0 2px 10px rgba(0, 0, 0, 0.02);
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .icon-wrapper {
        position: relative;
        display: inline-flex;
        margin-bottom: 2rem;
    }

    .gears-svg {
        width: 130px;
        height: 130px;
        fill: none;
    }

    .gear-main {
        animation: spinGear 12s linear infinite;
        transform-origin: 65px 65px;
    }

    .gear-sub {
        animation: spinGearRev 8s linear infinite;
        transform-origin: 90px 85px;
    }

    @@keyframes spinGear {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@keyframes spinGearRev {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(-360deg); }
    }

    .error-code {
        font-size: 5rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
    }

    .error-title {
        font-weight: 800;
        color: #1e293b;
        font-size: 1.8rem;
        margin-bottom: 0.75rem;
        letter-spacing: -0.02em;
    }

    .error-description {
        color: #64748b;
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 2.5rem;
    }

    .btn-login {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.8rem 2rem;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(245, 158, 11, 0.6);
        color: white;
    }

    /* Terminal Console Style for Stack Trace */
    .technical-details {
        margin-top: 3rem;
        text-align: left;
    }

    .accordion-button-custom {
        width: 100%;
        text-align: left;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-weight: 600;
        padding: 0.75rem 1.25rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .accordion-button-custom:hover {
        background: #f1f5f9;
    }

    .terminal-window {
        background: #0f172a;
        border-radius: 12px;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.8);
        border: 1px solid #334155;
        padding: 1.5rem;
        font-family: 'Fira Code', 'Courier New', Courier, monospace;
        font-size: 0.85rem;
        color: #e2e8f0;
        margin-top: 1rem;
        overflow-x: auto;
        max-height: 300px;
    }

    .terminal-header {
        display: flex;
        gap: 6px;
        margin-bottom: 1rem;
        border-bottom: 1px solid #1e293b;
        padding-bottom: 0.5rem;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }
    .dot-red { background: #ef4444; }
    .dot-yellow { background: #f59e0b; }
    .dot-green { background: #10b981; }

    .terminal-content {
        line-height: 1.6;
    }

    .terminal-prompt {
        color: #38bdf8;
    }

    .terminal-error-msg {
        color: #f87171;
        font-weight: bold;
    }

    .terminal-stack {
        color: #94a3b8;
    }
    
    .request-id-badge {
        font-family: monospace;
        background: #fef3c7;
        color: #d97706;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    /* Auto-redirect progress bar styling */
    .redirect-progress-container {
        margin-top: 1.5rem;
        width: 100%;
        background-color: #e2e8f0;
        border-radius: 9999px;
        height: 4px;
        overflow: hidden;
    }

    .redirect-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #f59e0b, #d97706);
        width: 100%;
        animation: countdownProgress 8s linear forwards;
    }

    @@keyframes countdownProgress {
        from { width: 100%; }
        to { width: 0%; }
    }
</style>

<div class="error-container">
    <div class="error-card">
        <!-- System Warning Gears -->
        <div class="icon-wrapper">
            <svg class="gears-svg" viewBox="0 0 130 130">
                <!-- Outer glow -->
                <circle cx="65" cy="65" r="50" stroke="#fef3c7" stroke-width="4" />
                
                <!-- Main Gear -->
                <g class="gear-main" stroke="#f59e0b" stroke-width="3">
                    <circle cx="65" cy="65" r="22" fill="#fffbeb" stroke-width="4" />
                    <!-- Teeth -->
                    <rect x="61" y="33" width="8" height="12" rx="2" fill="#f59e0b" />
                    <rect x="61" y="85" width="8" height="12" rx="2" fill="#f59e0b" />
                    <rect x="33" y="61" width="12" height="8" rx="2" fill="#f59e0b" />
                    <rect x="85" y="61" width="12" height="8" rx="2" fill="#f59e0b" />
                    <!-- Diagonal Teeth -->
                    <g transform="rotate(45 65 65)">
                        <rect x="61" y="33" width="8" height="12" rx="2" fill="#f59e0b" />
                        <rect x="61" y="85" width="8" height="12" rx="2" fill="#f59e0b" />
                        <rect x="33" y="61" width="12" height="8" rx="2" fill="#f59e0b" />
                        <rect x="85" y="61" width="12" height="8" rx="2" fill="#f59e0b" />
                    </g>
                </g>

                <!-- Sub Gear -->
                <g class="gear-sub" stroke="#d97706" stroke-width="2.5">
                    <circle cx="90" cy="85" r="14" fill="#fffbeb" stroke-width="3" />
                    <!-- Teeth -->
                    <rect x="87" y="65" width="6" height="8" rx="1.5" fill="#d97706" />
                    <rect x="87" y="97" width="6" height="8" rx="1.5" fill="#d97706" />
                    <rect x="69" y="82" width="8" height="6" rx="1.5" fill="#d97706" />
                    <rect x="103" y="82" width="8" height="6" rx="1.5" fill="#d97706" />
                    <!-- Diagonal Teeth -->
                    <g transform="rotate(45 90 85)">
                        <rect x="87" y="65" width="6" height="8" rx="1.5" fill="#d97706" />
                        <rect x="87" y="97" width="6" height="8" rx="1.5" fill="#d97706" />
                        <rect x="69" y="82" width="8" height="6" rx="1.5" fill="#d97706" />
                        <rect x="103" y="82" width="8" height="6" rx="1.5" fill="#d97706" />
                    </g>
                </g>
            </svg>
        </div>

        <div class="error-code">500</div>
        <div class="error-title">Sự Cố Hệ Thống</div>
        
        <p class="error-description">
            Đã xảy ra lỗi bất thường ngoài ý muốn trên máy chủ.
            Hệ thống đã tự động ghi nhận ngoại lệ và lưu thông tin kỹ thuật lại cho quản trị viên.<br />
            Nếu lỗi tiếp tục xảy ra, vui lòng cung cấp mã yêu cầu: <span class="request-id-badge">@Model?.RequestId</span>
        </p>

        <!-- Safe Navigation Options -->
        <div class="d-flex justify-content-center">
            <a href="/login" class="btn-login">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                </svg>
                <span>Đăng Nhập Tài Khoản</span>
            </a>
        </div>

        <!-- Auto-redirect message -->
        <div class="mt-4 text-muted" style="font-size: 0.9rem;">
            Hệ thống tự động chuyển hướng đến trang đăng nhập sau <span id="countdown" class="fw-bold text-primary">8</span> giây...
            <div class="redirect-progress-container mx-auto" style="max-width: 250px;">
                <div class="redirect-progress-bar"></div>
            </div>
        </div>

        <!-- Technical Trace Section for Admins / Developers -->
        @if (Model != null && (!string.IsNullOrEmpty(Model.StackTrace) || !string.IsNullOrEmpty(Model.ErrorMessage)))
        {
            <div class="technical-details">
                <button class="accordion-button-custom" type="button" data-bs-toggle="collapse" data-bs-target="#technicalInfo" aria-expanded="false" aria-controls="technicalInfo">
                    <span>
                        <svg class="me-1" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:inline-block; vertical-align:-3px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        Thông tin kỹ thuật lỗi (Dành cho Quản trị viên)
                    </span>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                
                <div class="collapse" id="technicalInfo">
                    <div class="terminal-window">
                        <div class="terminal-header">
                            <span class="dot dot-red"></span>
                            <span class="dot dot-yellow"></span>
                            <span class="dot dot-green"></span>
                            <span class="ms-2 text-muted" style="font-size: 0.75rem;">el-system-debugger.sh</span>
                        </div>
                        <div class="terminal-content text-start">
                            <div><span class="terminal-prompt">$</span> cat /var/log/system_error.log</div>
                            <div class="text-warning mt-1">[WARNING] Exception caught safely in Server Pipeline.</div>
                            <div><span class="text-info">Request ID:</span> @Model.RequestId</div>
                            @if (!string.IsNullOrEmpty(Model.OriginalPath))
                            {
                                <div><span class="text-info">Target Path:</span> @Model.OriginalPath</div>
                            }
                            <div class="mt-2"><span class="text-info">Exception Message:</span></div>
                            <div class="terminal-error-msg">@Model.ErrorMessage</div>
                            
                            @if (!string.IsNullOrEmpty(Model.StackTrace))
                            {
                                <div class="mt-2"><span class="text-info">Stack Trace:</span></div>
                                <pre class="terminal-stack mt-1 mb-0" style="white-space: pre-wrap; font-family: inherit; font-size: inherit;">@Model.StackTrace</pre>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let seconds = 8;
        const countdownEl = document.getElementById('countdown');
        const interval = setInterval(() => {
            seconds--;
            if (countdownEl) countdownEl.textContent = seconds;
            if (seconds <= 0) {
                clearInterval(interval);
                window.location.href = '/login';
            }
        }, 1000);
    });
</script>
