@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Access Denied - 403";
    
    // Resolve the dashboard URL dynamically based on user role
    var roleIdStr = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var userIdStr = HttpContextAccessor.HttpContext?.Session.GetString("UserId");
    bool isAuthenticated = !string.IsNullOrEmpty(userIdStr);
    
    string dashboardUrl = "/homepage";
    string roleName = "Guest / Anonymous";
    
    if (isAuthenticated && !string.IsNullOrEmpty(roleIdStr))
    {
        dashboardUrl = roleIdStr switch
        {
            "1" => "/student/dashboard",
            "2" => "/Admin/Dashboard",
            "3" => "/Teacher/Dashboard",
            "5" => "/contentmanager/dashboard",
            _ => "/homepage"
        };
        
        roleName = roleIdStr switch
        {
            "1" => "Student (Học sinh)",
            "2" => "Administrator (Quản trị viên)",
            "3" => "Teacher (Giáo viên)",
            "5" => "Content Manager (Quản lý nội dung)",
            _ => "User (Người dùng)"
        };
    }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    .error-container {
        font-family: 'Plus Jakarta Sans', sans-serif;
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .error-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(220, 53, 69, 0.15);
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
        padding: 3rem;
        text-align: center;
        max-width: 600px;
        width: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .error-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(220, 53, 69, 0.08), 0 2px 10px rgba(0, 0, 0, 0.02);
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .icon-wrapper {
        position: relative;
        display: inline-flex;
        margin-bottom: 2rem;
    }

    .lock-svg {
        width: 120px;
        height: 120px;
        fill: none;
        stroke: #dc3545;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .shackle {
        animation: lockPulse 2s infinite ease-in-out;
        transform-origin: 60px 45px;
    }

    @@keyframes lockPulse {
        0%, 100% {
            transform: scale(1) translateY(0);
        }
        50% {
            transform: scale(0.96) translateY(2px);
            stroke: #bd2130;
        }
    }

    .restricted-shield {
        position: absolute;
        bottom: -5px;
        right: -5px;
        background: #dc3545;
        color: white;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        box-shadow: 0 4px 10px rgba(220, 53, 69, 0.4);
        border: 3px solid white;
        animation: pulseShield 2s infinite;
    }

    @@keyframes pulseShield {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.6);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }

    .error-title {
        font-weight: 800;
        color: #1e293b;
        font-size: 2.2rem;
        margin-bottom: 0.75rem;
        letter-spacing: -0.02em;
    }

    .error-subtitle {
        color: #dc3545;
        font-weight: 700;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1.5rem;
    }

    .error-description {
        color: #64748b;
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    /* Simulation log styling */
    .evaluation-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        text-align: left;
        margin-bottom: 2.5rem;
        font-size: 0.9rem;
    }

    .evaluation-title {
        font-weight: 700;
        color: #475569;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .evaluation-step {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
        color: #64748b;
    }

    .evaluation-step:last-child {
        margin-bottom: 0;
    }

    .step-icon {
        width: 16px;
        height: 16px;
        margin-right: 8px;
    }

    .step-success {
        color: #10b981;
    }

    .step-failed {
        color: #dc3545;
        font-weight: 600;
    }

    .btn-dashboard {
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.8rem 2rem;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .btn-dashboard:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(79, 70, 229, 0.6);
        color: white;
    }

    .btn-secondary-custom {
        background: transparent;
        color: #64748b;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        margin-left: 10px;
    }

    .btn-secondary-custom:hover {
        background: #f1f5f9;
        color: #334155;
    }
</style>

<div class="error-container">
    <div class="error-card">
        <!-- Secure Animated Icon -->
        <div class="icon-wrapper">
            <svg class="lock-svg" viewBox="0 0 120 120">
                <!-- Outer Ring -->
                <circle cx="60" cy="60" r="50" stroke="#fecdd3" stroke-width="6" />
                <circle cx="60" cy="60" r="50" stroke="#dc3545" stroke-width="1.5" stroke-dasharray="8 6" />
                <!-- Shackle / Lock loop -->
                <path class="shackle" d="M40 55 V40 A20 20 0 0 1 80 40 V55" />
                <!-- Lock Body -->
                <rect x="34" y="55" width="52" height="38" rx="8" fill="#ffe4e6" stroke="#dc3545" stroke-width="2" />
                <!-- Keyhole -->
                <circle cx="60" cy="70" r="5" fill="#dc3545" />
                <path d="M60 74 L60 83" stroke="#dc3545" stroke-width="3" stroke-linecap="round" />
            </svg>
            <div class="restricted-shield">!</div>
        </div>

        <div class="error-title">Truy Cập Bị Từ Chối</div>
        <div class="error-subtitle">403 Forbidden</div>
        <p class="error-description">
            Rất tiếc, bạn không có quyền truy cập vào tài nguyên hoặc đường dẫn này. Hệ thống đã chặn yêu cầu của bạn để bảo vệ dữ liệu nội bộ.
        </p>

        <!-- Simulated Evaluation Flow -->
        <div class="evaluation-box">
            <div class="evaluation-title">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                Trình đánh giá bảo mật hệ thống
            </div>
            
            <div class="evaluation-step">
                <span class="step-icon step-success">✓</span>
                <span>Xác thực danh tính người dùng: <strong>Thành công</strong></span>
            </div>
            <div class="evaluation-step">
                <span class="step-icon step-success">✓</span>
                <span>Vai trò hiện tại: <strong>@roleName</strong></span>
            </div>
            <div class="evaluation-step">
                <span class="step-icon step-failed">✗</span>
                <span class="step-failed">Kiểm tra quyền hạn yêu cầu: Thiếu vai trò hoặc quyền tương thích</span>
            </div>
            <div class="evaluation-step">
                <span class="step-icon step-failed">✗</span>
                <span class="step-failed">Trạng thái: Quyền truy cập bị từ chối</span>
            </div>
        </div>

        <!-- Safe Navigation Options -->
        <div class="d-flex justify-content-center align-items-center">
            @if (isAuthenticated)
            {
                <a href="@dashboardUrl" class="btn-dashboard">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    Quay lại Bảng điều khiển
                </a>
            }
            else
            {
                <a href="/login" class="btn-dashboard">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                    </svg>
                    Đăng nhập tài khoản
                </a>
            }
            <a href="javascript:history.back()" class="btn-secondary-custom">Quay lại trang trước</a>
        </div>
    </div>
</div>
