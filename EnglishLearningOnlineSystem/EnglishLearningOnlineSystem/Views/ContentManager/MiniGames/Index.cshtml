@* ============================================================
   ORIGINAL LOGIC: 100% preserved — filter form (lessonId, searchTitle,
   GET), table rows, Details/Edit links, Delete form (asp-route-id,
   asp-route-lessonId, AntiForgeryToken, confirm dialog), pagination
   Url.Action, TotalCount — all unchanged.
   CHANGED: HTML structure (layout only) + CSS, to match the redesigned
   Create/Edit/Details pages and the Content Manager admin theme.
   ============================================================ *@

@model EnglishLearningOnlineSystem.ViewModels.ContentManager.Minigames.MiniGameListViewModel
@{
    Layout = "_ContentManagerLayout";
    ViewData["Title"] = "Quản lý Mini Game";
}

@* ── ADDED: scoped styles, consistent with mg-* tokens used across the module ── *@
<style>
    .mg-page-header {
        display: flex;
        align-items: center;
        gap: .9rem;
        margin-bottom: 1.5rem;
    }

    .mg-header-icon {
        width: 46px;
        height: 46px;
        border-radius: .65rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .mg-page-header h4 {
        margin: 0;
        font-weight: 600;
    }

    .mg-page-header .subtitle {
        font-size: .82rem;
        color: #6c757d;
    }

    .mg-filter-card {
        border: none;
        border-radius: .9rem;
    }

    .mg-table-card {
        border: none;
        border-radius: .9rem;
        overflow: hidden;
    }

    .mg-table thead th {
        background: #f8f9fc;
        font-size: .74rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #6c757d;
        font-weight: 600;
        border-bottom: 1px solid #eef0f3;
        padding: .8rem 1.1rem;
    }

    .mg-table tbody td {
        padding: .8rem 1.1rem;
        vertical-align: middle;
        font-size: .9rem;
    }

    .mg-type-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: #eef4ff;
        border: 1px solid #dce8ff;
        color: #3557a6;
        font-weight: 600;
        font-size: .78rem;
        padding: .28rem .7rem;
        border-radius: .5rem;
    }

    .mg-xp-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        background: linear-gradient(90deg,#f59e0b,#fbbf24);
        color: #1e2340;
        font-weight: 700;
        font-size: .78rem;
        padding: .28rem .7rem;
        border-radius: 99px;
    }

    .btn-mg-primary {
        background: linear-gradient(90deg, #4f6ef7, #7c3aed);
        border: none;
        color: #fff;
        font-weight: 600;
        transition: box-shadow .15s, transform .15s;
    }

        .btn-mg-primary:hover {
            box-shadow: 0 4px 14px rgba(79,110,247,.35);
            transform: translateY(-1px);
            color: #fff;
        }
</style>
@* ── END ADDED styles ──────────────────────────────────────── *@

<div class="container-fluid py-4">

    @* ── CHANGED: header restyled with icon chip, matches module pages ── *@
    <div class="mg-page-header">
        <div class="mg-header-icon bg-primary-subtle">
            <i class="bi bi-controller text-primary fs-5"></i>
        </div>
        <div>
            <h4>Mini Game — Word Scramble</h4>
            <div class="subtitle">Quản lý trò chơi luyện tập cho tất cả bài học</div>
        </div>
    </div>

    @* ── ORIGINAL: TempData alerts — logic unchanged ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── ORIGINAL: filter form, GET, lessonId/searchTitle names — UNCHANGED ── *@
    <div class="card shadow-sm mb-4 mg-filter-card">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Bài học</label>
                    <select name="lessonId" class="form-select">
                        <option value="">— Tất cả bài học —</option>
                        @foreach (var lesson in Model.Lessons)
                        {
                            <option value="@lesson.LessonId"
                                    selected="@(Model.FilterLessonId == lesson.LessonId)">
                                @lesson.Title
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Tìm theo tiêu đề</label>
                    <input type="text" name="searchTitle" value="@Model.SearchTitle"
                           class="form-control" placeholder="Nhập tiêu đề..." />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-mg-primary me-2">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    @* ── CHANGED: table restyled (mg-table classes); rows/links/logic UNCHANGED ── *@
    <div class="card shadow-sm mg-table-card">
        <div class="card-body p-0">
            @if (!Model.Items.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-controller fs-1 d-block mb-2"></i>
                    Chưa có trò chơi nào. Hãy mở bài học và tạo trò chơi từ đó.
                </div>
            }
            else
            {
                <table class="table table-hover mb-0 mg-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tiêu đề</th>
                            <th>Loại game</th>
                            <th>Bài học</th>
                            <th class="text-center">XP Thưởng</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-muted">@item.GameId</td>
                                <td class="fw-semibold">@item.Title</td>
                                <td><span class="mg-type-badge">@item.GameType</span></td>
                                <td class="text-muted">@item.LessonTitle</td>
                                <td class="text-center">
                                    <span class="mg-xp-badge"><i class="bi bi-star-fill"></i>+@item.XPReward XP</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.GameId"
                                       class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.GameId"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.GameId"
                                          asp-route-lessonId="@item.LessonId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa trò chơi này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* ── ORIGINAL: pagination, Url.Action params — UNCHANGED ── *@
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { lessonId = Model.FilterLessonId, searchTitle = Model.SearchTitle, page = i })">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }

    <div class="text-muted small mt-2">
        Tổng cộng: @Model.TotalCount trò chơi
    </div>
</div>
