@* ============================================================
   ORIGINAL LOGIC: 100% preserved — asp-action="Create", method="post",
   AntiForgeryToken, hidden LessonId, asp-for bindings (GameType, Title,
   XPReward), GameTypeOptions.All loop + selected logic, asp-validation-for,
   ModelOnly validation summary, ValidationScriptsPartial — all unchanged.
   CHANGED: HTML structure (layout only) + CSS, to match the Content
   Manager admin visual language (card, subtle icon chip, badges).
   ============================================================ *@

@model EnglishLearningOnlineSystem.ViewModels.ContentManager.Minigames.CreateMiniGameViewModel
@using EnglishLearningOnlineSystem.ViewModels.ContentManager.Minigames
@{
    Layout = "_ContentManagerLayout";
    ViewData["Title"] = "Tạo Mini Game";
}

@* ── ADDED: scoped styles, consistent with Content Manager admin theme ── *@
<style>
    .mg-form-wrap {
        max-width: 680px;
        margin: 0 auto;
    }

    /* ── Header row ── */
    .mg-header {
        display: flex;
        align-items: center;
        gap: .9rem;
        margin-bottom: 1.5rem;
    }

    .mg-header-icon {
        width: 46px;
        height: 46px;
        border-radius: .65rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .mg-header h4 {
        margin: 0;
        font-weight: 600;
    }

    .mg-header .subtitle {
        font-size: .82rem;
        color: #6c757d;
    }

    /* ── Card ── */
    .mg-card {
        border: none;
        border-radius: .9rem;
    }

        .mg-card .card-header {
            background: #fff;
            border-bottom: 1px solid #eef0f3;
            font-weight: 600;
            padding: 1rem 1.5rem;
            font-size: .92rem;
        }

        .mg-card .card-body {
            padding: 1.5rem;
        }

    /* ── Lesson readonly chip block ── */
    .mg-lesson-chip {
        display: flex;
        align-items: center;
        gap: .65rem;
        background: #f8f9fc;
        border: 1px solid #eef0f3;
        border-radius: .6rem;
        padding: .7rem .9rem;
    }

        .mg-lesson-chip i {
            font-size: 1.1rem;
            color: #6f42c1;
        }

        .mg-lesson-chip .label {
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #9099a3;
            margin-bottom: .1rem;
        }

        .mg-lesson-chip .value {
            font-weight: 600;
            font-size: .93rem;
            color: #212529;
        }

    /* ── Field group ── */
    .mg-field {
        margin-bottom: 1.15rem;
    }

        .mg-field label {
            font-weight: 600;
            font-size: .86rem;
            margin-bottom: .35rem;
            display: block;
        }

        .mg-field .form-text {
            font-size: .78rem;
        }

    /* ── Game type radio-style select cards ── */
    .mg-hint {
        background: #eef4ff;
        border: 1px solid #dce8ff;
        border-radius: .5rem;
        padding: .65rem .85rem;
        font-size: .8rem;
        color: #3557a6;
        display: flex;
        gap: .55rem;
        align-items: flex-start;
    }

        .mg-hint i {
            margin-top: .1rem;
        }

    /* ── XP input group ── */
    .mg-xp-input {
        position: relative;
    }

        /* Hide native number spinner so it can't collide with the XP badge */
        .mg-xp-input input[type="number"] {
            -moz-appearance: textfield;
            padding-right: 4rem;
        }

            .mg-xp-input input[type="number"]::-webkit-outer-spin-button,
            .mg-xp-input input[type="number"]::-webkit-inner-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }

        .mg-xp-input .xp-suffix {
            position: absolute;
            right: .9rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: .78rem;
            font-weight: 700;
            color: #f59e0b;
            pointer-events: none;
        }

    /* ── Actions ── */
    .mg-actions {
        display: flex;
        gap: .6rem;
        padding-top: .5rem;
        border-top: 1px solid #eef0f3;
        margin-top: .5rem;
    }

    .btn-mg-primary {
        background: linear-gradient(90deg, #4f6ef7, #7c3aed);
        border: none;
        color: #fff;
        font-weight: 600;
        padding: .55rem 1.4rem;
        border-radius: .55rem;
        transition: box-shadow .15s, transform .15s;
    }

        .btn-mg-primary:hover {
            box-shadow: 0 4px 14px rgba(79,110,247,.35);
            transform: translateY(-1px);
            color: #fff;
        }
</style>
@* ── END ADDED styles ──────────────────────────────────────── *@

<div class="mg-form-wrap">

    @* ── CHANGED: header replaces the old plain back-button + h2 row ── *@
    <div class="mg-header">
        <a asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.LessonId"
           class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <div class="mg-header-icon bg-primary-subtle">
            <i class="bi bi-controller text-primary fs-5"></i>
        </div>
        <div>
            <h4>Tạo Mini Game</h4>
            <div class="subtitle">Thêm một trò chơi luyện tập mới cho bài học</div>
        </div>
    </div>

    <div class="card shadow-sm mg-card">
        <div class="card-header">
            <i class="bi bi-pencil-square me-1 text-muted"></i> Thông tin trò chơi
        </div>
        <div class="card-body">

            @* ── ORIGINAL: form asp-action="Create", AntiForgeryToken, hidden LessonId — UNCHANGED ── *@
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LessonId" />

                @* ── CHANGED: lesson name shown as a readonly info chip instead of a disabled input ── *@
                <div class="mg-field">
                    <label>Bài học</label>
                    <div class="mg-lesson-chip">
                        <i class="bi bi-journal-bookmark-fill"></i>
                        <div>
                            <div class="label">Đang tạo game cho</div>
                            <div class="value">@Model.LessonTitle</div>
                        </div>
                    </div>
                </div>

                @* ── ORIGINAL: asp-for="GameType" select + GameTypeOptions.All loop — UNCHANGED ── *@
                <div class="mg-field">
                    <label asp-for="GameType">Loại game <span class="text-danger">*</span></label>
                    <select asp-for="GameType" class="form-select">
                        @foreach (var opt in GameTypeOptions.All)
                        {
                            <option value="@opt.Value" selected="@(Model.GameType == opt.Value)">@opt.Label</option>
                        }
                    </select>
                    <span asp-validation-for="GameType" class="text-danger small"></span>

                    @* ── CHANGED: form-text replaced with a styled hint callout ── *@
                    <div class="mg-hint mt-2">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>
                            <strong>Word Scramble</strong> cần ít nhất 1 từ vựng trong bài học.
                            <strong>Matching</strong> cần ít nhất 2 từ vựng để ghép cặp.
                        </div>
                    </div>
                </div>

                @* ── ORIGINAL: asp-for="Title" — UNCHANGED ── *@
                <div class="mg-field">
                    <label asp-for="Title">Tiêu đề <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề trò chơi..." />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                @* ── ORIGINAL: asp-for="XPReward" — UNCHANGED ── *@
                <div class="mg-field">
                    <label asp-for="XPReward">XP Thưởng</label>
                    <div class="mg-xp-input">
                        <input asp-for="XPReward" type="number" class="form-control" min="0" max="9999" />
                        <span class="xp-suffix"><i class="bi bi-star-fill"></i> XP</span>
                    </div>
                    <span asp-validation-for="XPReward" class="text-danger small"></span>
                    <div class="form-text text-muted">Số XP học sinh nhận được khi trả lời đúng.</div>
                </div>

                @* ── CHANGED: action row restyled; button text/type unchanged ── *@
                <div class="mg-actions">
                    <button type="submit" class="btn btn-mg-primary">
                        <i class="bi bi-check-lg"></i> Tạo trò chơi
                    </button>
                    <a asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.LessonId"
                       class="btn btn-outline-secondary">Hủy</a>
                </div>

                @* ── ORIGINAL: validation summary — UNCHANGED ── *@
                <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        @* ── ORIGINAL: ValidationScriptsPartial — UNCHANGED ── *@
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
