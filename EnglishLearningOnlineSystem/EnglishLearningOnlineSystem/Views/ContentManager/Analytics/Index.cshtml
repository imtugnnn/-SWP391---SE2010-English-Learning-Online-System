@model EnglishLearningOnlineSystem.ViewModels.ContentManager.LessonAnalytics.LessonAnalyticsDashboardViewModel
@{
    ViewData["Title"] = "Phân tích bài học";
    Layout = "~/Views/Shared/_ContentManagerLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-semibold">Phân tích bài học</h4>
        <p class="text-muted small mb-0">Tổng quan tất cả bài học trong các khóa học</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary-subtle">
                    <i class="bi bi-journal-richtext fs-4 text-primary"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalLessons</div>
                    <div class="text-muted small">Tổng số bài học</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success-subtle">
                    <i class="bi bi-people-fill fs-4 text-success"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalStudentsAll</div>
                    <div class="text-muted small">Tổng lượt học viên tham gia</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-info-subtle">
                    <i class="bi bi-bar-chart-fill fs-4 text-info"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">
                        @Model.OverallAvgScore
                        <span class="fs-6 fw-normal text-muted">%</span>
                    </div>
                    <div class="text-muted small">Điểm quiz trung bình</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning-subtle">
                    <i class="bi bi-star-fill fs-4 text-warning"></i>
                </div>
                <div>
                    <div class="fs-3 fw-bold lh-1">@Model.TotalXpAll.ToString("N0")</div>
                    <div class="text-muted small">Tổng XP đã trao</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Lọc theo khóa học</label>

                <select name="courseId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">— Tất cả khóa học —</option>

                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.CourseId"
                                selected="@(Model.FilterCourseId == c.CourseId ? "selected" : null)">
                            @c.CourseName
                        </option>
                    }
                </select>
            </div>

            @if (Model.FilterCourseId.HasValue)
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-lg me-1"></i>Xóa bộ lọc
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold py-3">
        Danh sách bài học
        <span class="badge bg-secondary ms-1">@Model.Items.Count</span>
    </div>

    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                Không tìm thấy dữ liệu bài học.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Bài học</th>
                            <th>Khóa học</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thời lượng</th>
                            <th class="text-center">Học viên</th>
                            <th class="text-center">Điểm TB</th>
                            <th class="text-center">Flashcard %</th>
                            <th class="text-center">XP đã trao</th>
                            <th class="text-center">Chi tiết</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Title</td>
                                <td class="small text-muted">@item.CourseName</td>

                                <td class="text-center">
                                    @if (item.IsPublished)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            Chưa hoạt động
                                        </span>
                                    }
                                </td>

                                <td class="text-center small">@item.EstimatedMinutes phút</td>

                                <td class="text-center fw-semibold">@item.TotalStudents</td>

                                <td class="text-center">
                                    <span class="badge border @item.ScoreBadgeClass">
                                        @item.AvgQuizScore%
                                    </span>
                                </td>

                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px;max-width:70px;">
                                            <div class="progress-bar bg-info"
                                                 style="width:@item.FlashcardCompletionRate%">
                                            </div>
                                        </div>

                                        <small class="text-muted">@item.FlashcardCompletionRate%</small>
                                    </div>
                                </td>

                                <td class="text-center small">
                                    @item.TotalXpAwarded.ToString("N0") XP
                                </td>

                                <td class="text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.LessonId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-graph-up me-1"></i>Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>