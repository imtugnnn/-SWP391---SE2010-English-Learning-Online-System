@model List<EnglishLearningOnlineSystem.ViewModels.ContentManager.Vocabularies.VocabularyListItemViewModel>
@{
    Layout = "_ContentManagerLayout";
    ViewData["Title"] = "Quản lý từ vựng";
    ViewData["ActiveNav"] = "vocabulary";
    ViewData["Breadcrumb"] = "Từ vựng";

    var keyword = ViewBag.Keyword as string;
    int? lessonId = ViewBag.LessonId as int?;
    int pageNumber = ViewBag.PageNumber;
    int totalPages = ViewBag.TotalPages;
}

<div class="cm-page-header">
    <div>
        <div class="cm-page-title">Quản lý từ vựng</div>
        <div class="cm-page-subtitle">Tạo và quản lý danh sách từ vựng cho các bài học</div>
    </div>
    <a asp-action="Create" asp-route-lessonId="@lessonId" class="cm-btn cm-btn-primary">+ Thêm từ vựng</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="cm-alert" style="background:var(--cm-success-bg);color:var(--cm-success);border:1px solid #86efac;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="cm-alert cm-alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="cm-card" style="padding:16px 20px; margin-bottom:16px;">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="keyword" value="@keyword" class="cm-input" placeholder="Tìm theo từ vựng hoặc nghĩa..." />
        </div>
        <div class="col-md-5">
            <select name="lessonId" class="cm-select" asp-items="ViewBag.LessonSelectList">
                <option value="">-- Tất cả bài học --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="cm-btn cm-btn-secondary" style="width:100%;justify-content:center;">Tìm kiếm</button>
        </div>
    </form>
</div>

<div class="cm-card">
    <table class="table align-middle mb-0">
        <thead>
            <tr style="background:var(--cm-surface);">
                <th style="padding:12px 16px;">#</th>
                <th>Từ vựng</th>
                <th>Nghĩa</th>
                <th>Bài học</th>
                <th>Khoá học</th>
                <th class="text-end" style="padding-right:16px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-4" style="color:var(--cm-ink-muted);">Không có từ vựng nào.</td></tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td style="padding:12px 16px;">@item.VocabularyId</td>
                        <td style="font-weight:600; color:var(--cm-accent);">@item.Word</td>
                        <td>@item.Meaning</td>
                        <td>@item.LessonTitle</td>
                        <td><span class="cm-badge cm-badge-muted">@item.CourseName</span></td>
                        <td class="text-end" style="padding-right:16px;">
                            <a asp-action="Edit" asp-route-id="@item.VocabularyId" class="cm-btn cm-btn-ghost cm-btn-sm">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.VocabularyId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xoá từ vựng này?');">
                                <button type="submit" class="cm-btn cm-btn-ghost cm-btn-sm" style="color:var(--cm-danger);">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p"
                       asp-route-keyword="@keyword" asp-route-lessonId="@lessonId">@p</a>
                </li>
            }
        </ul>
    </nav>
}
