@model List<EnglishLearningOnlineSystem.ViewModels.ContentManager.Courses.CourseListItemViewModel>
@{
    Layout = "_ContentManagerLayout";
    ViewData["Title"] = "Quản lý khoá học";
    ViewData["ActiveNav"] = "courses";
    ViewData["Breadcrumb"] = "Khoá học";

    var keyword = ViewBag.Keyword as string;
    bool? isActive = ViewBag.IsActive as bool?;
    int pageNumber = ViewBag.PageNumber;
    int totalPages = ViewBag.TotalPages;
}

<div class="cm-page-header">
    <div>
        <div class="cm-page-title">Quản lý khoá học</div>
        <div class="cm-page-subtitle">Tạo và quản lý các khoá học tiếng Anh cho học sinh</div>
    </div>
    <a asp-action="Create" class="cm-btn cm-btn-primary">+ Thêm khoá học</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="cm-alert" style="background:var(--cm-success-bg);color:var(--cm-success);border:1px solid #86efac;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="cm-alert cm-alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="cm-card" style="padding:16px 20px; margin-bottom:16px;">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="keyword" value="@keyword" class="cm-input" placeholder="Tìm theo tên khoá học..." />
        </div>
        <div class="col-md-4">
            <select name="isActive" class="cm-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="true" selected="@(isActive == true)">Đang hoạt động</option>
                <option value="false" selected="@(isActive == false)">Chưa kích hoạt</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="cm-btn cm-btn-secondary" style="width:100%;justify-content:center;">Tìm kiếm</button>
        </div>
    </form>
</div>

<div class="cm-card">
    <table class="table align-middle mb-0">
        <thead>
            <tr style="background:var(--cm-surface);">
                <th style="padding:12px 16px;">#</th>
                <th>Tên khoá học</th>
                <th>Khối lớp</th>
                <th>Số bài học</th>
                <th>Trạng thái</th>
                <th class="text-end" style="padding-right:16px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-4" style="color:var(--cm-ink-muted);">Không có khoá học nào.</td></tr>
            }
            else
            {
                foreach (var course in Model)
                {
                    <tr>
                        <td style="padding:12px 16px;">@course.CourseId</td>
                        <td>@course.CourseName</td>
                        <td>@course.GradeLevel</td>
                        <td>@course.LessonCount</td>
                        <td>
                            @if (course.IsPublished)
                            {
                                <span class="cm-badge cm-badge-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="cm-badge cm-badge-muted">Chưa kích hoạt</span>
                            }
                        </td>
                        <td class="text-end" style="padding-right:16px;">
                            <a href="/contentmanager/lessons?courseId=@course.CourseId" class="cm-btn cm-btn-secondary cm-btn-sm" style="margin-right:8px;">Bài học</a>
                            <a asp-action="Edit" asp-route-id="@course.CourseId" class="cm-btn cm-btn-ghost cm-btn-sm">Sửa</a>
                            <form asp-action="ToggleStatus" asp-route-id="@course.CourseId" method="post" class="d-inline">
                                <button type="submit" class="cm-btn cm-btn-ghost cm-btn-sm">
                                    @(course.IsPublished ? "Vô hiệu hoá" : "Kích hoạt")
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@course.CourseId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xoá khoá học này?');">
                                <button type="submit" class="cm-btn cm-btn-ghost cm-btn-sm" style="color:var(--cm-danger);">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p"
                       asp-route-keyword="@keyword" asp-route-isActive="@isActive">@p</a>
                </li>
            }
        </ul>
    </nav>
}