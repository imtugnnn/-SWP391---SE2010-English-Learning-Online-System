@model List<EnglishLearningOnlineSystem.ViewModels.ContentManager.Lessons.LessonListItemViewModel>
@{
    Layout = "_ContentManagerLayout";
    ViewData["Title"] = "Quản lý bài học (Lessons)";
    ViewData["ActiveNav"] = "lessons";
    ViewData["Breadcrumb"] = "Bài học";

    var keyword = ViewBag.Keyword as string;
    int? courseId = ViewBag.CourseId as int?;
    int pageNumber = ViewBag.PageNumber;
    int totalPages = ViewBag.TotalPages;
}

<div class="cm-page-header">
    <div>
        <div class="cm-page-title">Quản lý bài học</div>
        <div class="cm-page-subtitle">Tạo và quản lý các bài học thuộc khoá học</div>
    </div>
    <a asp-action="Create" asp-route-courseId="@courseId" class="cm-btn cm-btn-primary">+ Thêm bài học</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="cm-alert" style="background:var(--cm-success-bg);color:var(--cm-success);border:1px solid #86efac;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="cm-alert cm-alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="cm-card" style="padding:16px 20px; margin-bottom:16px;">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="keyword" value="@keyword" class="cm-input" placeholder="Tìm theo tiêu đề bài học..." />
        </div>
        <div class="col-md-5">
            <select name="courseId" class="cm-select" asp-items="ViewBag.CourseSelectList">
                <option value="">-- Tất cả khoá học --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="cm-btn cm-btn-secondary" style="width:100%;justify-content:center;">Tìm kiếm</button>
        </div>
    </form>
</div>

<div class="cm-card">
    <table class="table align-middle mb-0">
        <thead>
            <tr style="background:var(--cm-surface);">
                <th style="padding:12px 16px;">#</th>
                <th>Tiêu đề bài học</th>
                <th>Chủ đề</th>
                <th>Khoá học</th>
                <th>Thời lượng</th>
                <th class="text-end" style="padding-right:16px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-4" style="color:var(--cm-ink-muted);">Không có bài học nào.</td></tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td style="padding:12px 16px;">@item.LessonId</td>
                        <td style="font-weight:600; color:var(--cm-accent);">@item.Title</td>
                        <td><span class="cm-badge cm-badge-warning">@item.Topic</span></td>
                        <td>@item.CourseName</td>
                        <td>@item.EstimatedMinutes phút</td>
                        <td class="text-end" style="padding-right:16px;">
                            <a asp-action="Details" asp-route-id="@item.LessonId"
                               class="cm-btn cm-btn-secondary cm-btn-sm" style="margin-right:4px;">Chi tiết</a>
                            <a href="/contentmanager/vocabularies?lessonId=@item.LessonId"
                               class="cm-btn cm-btn-secondary cm-btn-sm" style="margin-right:4px;">Từ vựng</a>
                            <a href="/contentmanager/quizzes?lessonId=@item.LessonId"
                               class="cm-btn cm-btn-secondary cm-btn-sm" style="margin-right:8px;">Quizzes</a>
                            <a asp-action="Edit" asp-route-id="@item.LessonId"
                               class="cm-btn cm-btn-ghost cm-btn-sm">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.LessonId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xoá bài học này?');">
                                <button type="submit" class="cm-btn cm-btn-ghost cm-btn-sm" style="color:var(--cm-danger);">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p"
                       asp-route-keyword="@keyword" asp-route-courseId="@courseId">@p</a>
                </li>
            }
        </ul>
    </nav>
}
