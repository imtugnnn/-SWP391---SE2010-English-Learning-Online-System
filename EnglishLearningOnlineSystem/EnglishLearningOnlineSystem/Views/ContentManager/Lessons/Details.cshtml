@model EnglishLearningOnlineSystem.ViewModels.ContentManager.Lessons.LessonDetailsViewModel

@{
    Layout = "_ContentManagerLayout";
    ViewData["Title"] = "Chi tiết bài học";
}

<div class="cm-page-header">
    <div>
        <div class="cm-page-title">@Model.Title</div>
        <div class="cm-page-subtitle">@Model.CourseName</div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.LessonId"
           class="cm-btn cm-btn-secondary">
            Chỉnh sửa
        </a>

        <a asp-action="Index"
           asp-route-courseId="@Model.CourseId"
           class="cm-btn cm-btn-ghost">
            Quay lại
        </a>
    </div>
</div>

<div class="cm-card" style="padding:24px;">
    <dl class="row mb-0">

        <dt class="col-sm-3">Tiêu đề</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Chủ đề</dt>
        <dd class="col-sm-9">@Model.Topic</dd>

        <dt class="col-sm-3">Khóa học</dt>
        <dd class="col-sm-9">@Model.CourseName</dd>

        <dt class="col-sm-3">Cấp độ</dt>
        <dd class="col-sm-9">@Model.CourseGradeLevel</dd>

        <dt class="col-sm-3">Thứ tự</dt>
        <dd class="col-sm-9">@Model.OrderIndex</dd>

        <dt class="col-sm-3">Thời lượng</dt>
        <dd class="col-sm-9">@Model.EstimatedMinutes phút</dd>

        <dt class="col-sm-3">Điểm XP</dt>
        <dd class="col-sm-9">@Model.XPReward</dd>

        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">
            @if (Model.IsPublished)
            {
                <span class="cm-badge cm-badge-success">Đang hiển thị</span>
            }
            else
            {
                <span class="cm-badge cm-badge-muted">Bản nháp</span>
            }
        </dd>

    </dl>
</div>