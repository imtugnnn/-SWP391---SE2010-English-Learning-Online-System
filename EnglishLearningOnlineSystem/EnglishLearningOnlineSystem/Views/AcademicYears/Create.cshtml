@model EnglishLearningOnlineSystem.ViewModels.Admin.AcademicYears.AcademicYearCreateViewModel

@{
    ViewData["Title"] = "Create Academic Year";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid py-3" style="max-width: 860px;">
    <div class="mb-4">
        <h2 class="mb-1">Create Academic Year</h2>
        <p class="text-muted mb-0">Create a new school year before adding classes.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="YearLabel" class="form-label">Year label</label>
                    <input asp-for="YearLabel" class="form-control" placeholder="2025 - 2026" />
                    <span asp-validation-for="YearLabel" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label">Start date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label">End date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check form-switch mt-3">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label">Set as active academic year</label>
                </div>
                <div class="form-text">If this is the first academic year, it will be active automatically.</div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
