@model EnglishLearningOnlineSystem.ViewModels.Admin.AcademicYears.AcademicYearEditViewModel

@{
    ViewData["Title"] = "Manage Academic Year";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">@Model.YearLabel</h2>
            <p class="text-muted mb-0">
                @if (Model.StartDate.HasValue || Model.EndDate.HasValue)
                {
                    <span>@Model.StartDate?.ToString("yyyy-MM-dd")</span>
                    <span> - </span>
                    <span>@Model.EndDate?.ToString("yyyy-MM-dd")</span>
                }
                else
                {
                    <span>No date range set yet.</span>
                }
            </p>
            <div class="mt-2">
                @if (Model.IsActive)
                {
                    <span class="badge text-bg-success">Active</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Inactive</span>
                }
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Classes</h4>
                        <span class="badge text-bg-secondary">@Model.Classes.Count</span>
                    </div>

                    @if (!Model.Classes.Any())
                    {
                        <div class="alert alert-light border mb-0">No classes have been added yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Class</th>
                                        <th>Grade</th>
                                        <th>Teacher</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Classes)
                                    {
                                        var selectedUrl = Url.Action("Edit", "AcademicYears", new { id = Model.AcademicYearId, selectedClassId = item.ClassId });
                                        var defaultUrl = Url.Action("Edit", "AcademicYears", new { id = Model.AcademicYearId });
                                        <tr role="button"
                                            style="cursor:pointer;"
                                            class="@(Model.SelectedClassId == item.ClassId ? "table-primary" : "")"
                                            onclick="handleClassRowClick('@selectedUrl', '@defaultUrl', @(Model.SelectedClassId == item.ClassId ? "true" : "false"))">
                                            <td class="fw-semibold">@item.ClassName</td>
                                            <td>@item.GradeLevel</td>
                                            <td>
                                                <div>@item.TeacherName</div>
                                                @if (!string.IsNullOrWhiteSpace(item.TeacherEmail))
                                                {
                                                    <small class="text-muted">@item.TeacherEmail</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    @if (Model.SelectedClass != null)
                    {
                        <div class="mb-4">
                            <div>
                                <h4 class="mb-1">@Model.SelectedClass.ClassName</h4>
                                <div class="text-muted">Grade @Model.SelectedClass.GradeLevel</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="text-muted small mb-1">Teacher</div>
                            <div class="fw-semibold">@Model.SelectedClass.TeacherName</div>
                            @if (!string.IsNullOrWhiteSpace(Model.SelectedClass.TeacherEmail))
                            {
                                <div class="text-muted">@Model.SelectedClass.TeacherEmail</div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Students</h5>
                            <span class="badge text-bg-secondary">@Model.SelectedClass.StudentEmails.Count</span>
                        </div>

                        @if (Model.SelectedClass.StudentEmails.Count == 0)
                        {
                            <div class="alert alert-light border mb-4">No students have been assigned to this class.</div>
                        }
                        else
                        {
                            <div class="list-group mb-4">
                                @foreach (var email in Model.SelectedClass.StudentEmails)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@email</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mt-auto pt-2">
                            <a asp-action="Edit" asp-route-id="@Model.AcademicYearId" class="btn btn-outline-secondary w-100">
                                Add Class
                            </a>
                        </div>
                    }
                    else
                    {
                        <h4 class="mb-3">Add Class</h4>

                        <form asp-action="AddClass"
                              asp-route-id="@Model.AcademicYearId"
                              method="post"
                              enctype="multipart/form-data">
                            <input type="hidden" asp-for="SelectedClassId" />
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <a asp-action="DownloadClassTemplate"
                                   asp-route-id="@Model.AcademicYearId"
                                   class="btn btn-outline-primary">
                                    Download Student Template
                                </a>
                                <button type="submit"
                                        class="btn btn-outline-success"
                                        formaction="@Url.Action("LoadStudentsFromExcel", "AcademicYears", new { id = Model.AcademicYearId })"
                                        formnovalidate>
                                    Load Students
                                </button>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImportFile" class="form-label">Student Excel file</label>
                                <input asp-for="ImportFile" type="file" class="form-control" accept=".xlsx" />
                                <div class="form-text">File only needs 2 columns: No and Student Email.</div>
                                <span asp-validation-for="ImportFile" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewClass.ClassName" class="form-label">Class name</label>
                                <input asp-for="NewClass.ClassName" class="form-control" placeholder="Class 10A1" />
                                <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewClass.GradeLevel" class="form-label">Grade level</label>
                                <input asp-for="NewClass.GradeLevel" class="form-control" placeholder="Grade 10" />
                                <span asp-validation-for="NewClass.GradeLevel" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewClass.TeacherId" class="form-label">Teacher</label>
                                <select asp-for="NewClass.TeacherId" class="form-select" asp-items="ViewBag.TeacherId">
                                    <option value="">Choose teacher</option>
                                </select>
                                <span asp-validation-for="NewClass.TeacherId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewClass.StudentEmails" class="form-label">Student emails</label>
                                <textarea asp-for="NewClass.StudentEmails"
                                          class="form-control"
                                          rows="6"
                                          placeholder="student1@email.com&#10;student2@email.com"
                                          readonly></textarea>
                                <div class="form-text">Student emails are loaded from Excel and cannot be edited here.</div>
                                <span asp-validation-for="NewClass.StudentEmails" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary">Add Class</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function handleClassRowClick(selectedUrl, defaultUrl, isSelected) {
            window.location = isSelected ? defaultUrl : selectedUrl;
        }
    </script>
}
