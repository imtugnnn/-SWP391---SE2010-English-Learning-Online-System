@model IEnumerable<EnglishLearningOnlineSystem.ViewModels.Admin.AcademicYears.AcademicYearListItemViewModel>

@{
    ViewData["Title"] = "Academic Years";
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">Academic Years</h2>
            <p class="text-muted mb-0">View all school years and manage their classes.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create Academic Year
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Year</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Active</th>
                            <th>Classes</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No academic years yet.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.YearLabel</td>
                                    <td>@item.StartDate?.ToString("yyyy-MM-dd")</td>
                                    <td>@item.EndDate?.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@item.ClassCount</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.AcademicYearId" class="btn btn-sm btn-outline-secondary">
                                                Manage
                                            </a>
                                            @if (!item.IsActive)
                                            {
                                                <form asp-action="SetActive" asp-route-id="@item.AcademicYearId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
