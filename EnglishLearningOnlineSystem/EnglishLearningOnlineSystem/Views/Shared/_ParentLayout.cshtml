@{
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
    var parentName = ViewBag.ParentName as string ?? "Phụ huynh";
    var streakDays = ViewBag.StreakDays is int s ? s : 3;
    var xp = ViewBag.XP is int x ? x : 120;

    string Nav(string key) => activeNav == key ? "p-nav-item active" : "p-nav-item";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ELS</title>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --p-blue:      #2563eb;
            --p-blue-d:    #1d4ed8;
            --p-green:     #16a34a;
            --p-green-d:   #15803d;
            --p-bg:        #f1f5f9;
            --p-card:      #ffffff;
            --p-border:    #e2e8f0;
            --p-muted:     #64748b;
            --p-text:      #1e293b;
            --p-sb-width:  248px;
            --p-radius:    20px;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: var(--p-bg);
            color: var(--p-text);
            min-height: 100vh;
            display: flex;
        }

        .p-sidebar {
            width: var(--p-sb-width);
            min-height: 100vh;
            background: linear-gradient(180deg, #2563eb 0%, #1e40af 100%);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 100;
        }
        .p-logo {
            padding: 26px 24px 22px;
            color: #fff;
        }
        .p-logo-title { font-size: 1.6rem; font-weight: 900; line-height: 1; }
        .p-logo-sub { font-size: .82rem; font-weight: 600; opacity: .85; margin-top: 4px; }

        .p-nav { flex: 1; padding: 14px 14px; display: flex; flex-direction: column; gap: 6px; }
        .p-nav-item {
            display: flex; align-items: center; gap: 14px;
            padding: 13px 16px;
            border-radius: 14px;
            color: rgba(255,255,255,.9);
            font-weight: 700; font-size: .96rem;
            text-decoration: none;
            transition: background .15s;
            border: none; background: none; width: 100%; text-align: left;
            cursor: pointer;
        }
        .p-nav-item:hover { background: rgba(255,255,255,.15); color: #fff; }
        .p-nav-item.active { background: #fff; color: var(--p-blue); box-shadow: 0 6px 16px rgba(0,0,0,.12); }
        .p-nav-icon { font-size: 1.2rem; width: 24px; text-align: center; flex-shrink: 0; }
        .p-nav-divider { height: 1px; background: rgba(255,255,255,.18); margin: 10px 6px; }

        .p-main {
            margin-left: var(--p-sb-width);
            flex: 1;
            display: flex; flex-direction: column;
            min-height: 100vh;
        }
        .p-topbar {
            background: #fff;
            padding: 20px 36px;
            display: flex; align-items: flex-start; justify-content: space-between;
            border-bottom: 1px solid var(--p-border);
            gap: 16px;
        }
        .p-topbar-title { font-size: 1.9rem; font-weight: 900; color: var(--p-text); line-height: 1.1; }
        .p-topbar-sub { color: var(--p-muted); font-size: .98rem; margin-top: 6px; }
        .p-topbar-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
        .p-pill {
            border-radius: 99px; padding: 8px 16px;
            font-size: .9rem; font-weight: 800;
            display: flex; align-items: center; gap: 6px;
        }
        .p-pill-streak { background: #fff7ed; border: 1.5px solid #fed7aa; color: #c2410c; }
        .p-pill-xp { background: #fefce8; border: 1.5px solid #fde68a; color: #92400e; }
        .p-avatar {
            width: 46px; height: 46px; border-radius: 50%;
            background: #cbd5e1; object-fit: cover;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; color: #fff;
        }

        .p-content { padding: 32px 36px; flex: 1; }

        .p-card {
            background: var(--p-card);
            border-radius: var(--p-radius);
            box-shadow: 0 4px 20px rgba(15,23,42,.06);
            padding: 30px;
        }

        @@media (max-width: 992px) {
            :root { --p-sb-width: 72px; }
            .p-logo-title, .p-logo-sub, .p-nav-item > span:not(.p-nav-icon) { display: none; }
            .p-nav-item { justify-content: center; padding: 13px; }
            .p-logo { padding: 22px 12px; text-align: center; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<aside class="p-sidebar">
    <div class="p-logo">
        <div class="p-logo-title">ELS</div>
        <div class="p-logo-sub">Tiếng Anh cho Trẻ Em</div>
    </div>

    <nav class="p-nav" aria-label="Menu phụ huynh">
        <a href="/Parent/Dashboard" class="@Nav("dashboard")">
            <span class="p-nav-icon">🏠</span><span>Bảng điều khiển</span>
        </a>
        <a href="/Parent" class="@Nav("link")">
            <span class="p-nav-icon">🔗</span><span>Liên kết con</span>
        </a>
        <a href="/Parent/Reports" class="@Nav("reports")">
            <span class="p-nav-icon">📊</span><span>Báo cáo học tập</span>
        </a>
        <a href="/Parent/Notifications" class="@Nav("notifications")">
            <span class="p-nav-icon">🔔</span><span>Thông báo</span>
        </a>

        <div class="p-nav-divider"></div>

        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="p-nav-item">
                <span class="p-nav-icon">↪</span><span>Đăng xuất</span>
            </button>
        </form>
    </nav>
</aside>

<div class="p-main">
    <div class="p-topbar">
        <div>
            <div class="p-topbar-title">@(ViewData["Title"] ?? "ELS")</div>
            @if (ViewData["Subtitle"] != null)
            {
                <div class="p-topbar-sub">@ViewData["Subtitle"]</div>
            }
        </div>
        <div class="p-topbar-right">
            <div class="p-pill p-pill-streak">🔥 @streakDays ngày</div>
            <div class="p-pill p-pill-xp">⭐ @xp XP</div>
            <div class="p-avatar">👤</div>
        </div>
    </div>

    <div class="p-content">
        @RenderBody()
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
