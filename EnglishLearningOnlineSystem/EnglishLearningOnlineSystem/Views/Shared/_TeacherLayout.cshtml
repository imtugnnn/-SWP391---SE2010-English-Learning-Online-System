<!DOCTYPE html>
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isDashboardSection = currentAction is "Dashboard" or "ClassDetail";
    var isAssignmentSection = currentAction is "AssignmentOverview" or "AssignWeeklyLessons";
    var isStudentSection = currentAction is "StudentsNeedSupport" or "ManageStudentList" or "StudentDetail" or "ProvideFeedback";
}
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishLearningOnlineSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teacher/teacher-common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnglishLearningOnlineSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="teacher-skip-link" href="#teacher-main-content">Đi tới nội dung chính</a>
    <header class="teacher-navbar">
        <nav class="teacher-navbar__inner" aria-label="Điều hướng giáo viên">
            <a class="teacher-brand" asp-controller="Teacher" asp-action="Dashboard">
                English Learning
                <span>Teacher</span>
            </a>

            <button class="teacher-nav-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#teacherNavigation"
                    aria-controls="teacherNavigation"
                    aria-expanded="false"
                    aria-label="Mở hoặc đóng menu giáo viên">
                <span></span><span></span><span></span>
            </button>

            <div class="teacher-nav-links collapse" id="teacherNavigation">
                <a asp-controller="Teacher"
                   asp-action="Dashboard"
                   class="@(isDashboardSection ? "active" : null)"
                   aria-current="@(isDashboardSection ? "page" : null)">Tổng quan</a>
                <a asp-controller="Teacher"
                   asp-action="AssignmentOverview"
                   class="@(isAssignmentSection ? "active" : null)"
                   aria-current="@(isAssignmentSection ? "page" : null)">Bài đã giao</a>
                <a asp-controller="Teacher"
                   asp-action="StudentsNeedSupport"
                   class="@(isStudentSection ? "active" : null)"
                   aria-current="@(isStudentSection ? "page" : null)">Học sinh cần hỗ trợ</a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="teacher-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="teacher-logout">Đăng xuất</button>
                </form>
            </div>
        </nav>
    </header>

    <main id="teacher-main-content" role="main" class="teacher-main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="teacher-footer">
        <div class="teacher-footer__inner">
            &copy; 2026 English Learning Online System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
