<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishLearningOnlineSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teacher/teacher-common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnglishLearningOnlineSystem.styles.css" asp-append-version="true" />
</head>
<body class="teacher-layout">
    <a class="teacher-skip-link" href="#teacher-main-content">Đi tới nội dung chính</a>

    <aside class="teacher-sidebar">
        <a class="teacher-sidebar__brand"
           asp-controller="Teacher"
           asp-action="Dashboard"
           aria-label="English Learning Teacher">
            <span class="teacher-sidebar__logo" aria-hidden="true">EL</span>
            <span class="teacher-sidebar__brand-copy">
                <strong>English Learning</strong>
                <small>Teacher workspace</small>
            </span>
        </a>

        @await Component.InvokeAsync("TeacherNavigation")

        <div class="teacher-sidebar__footer">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="teacher-sidebar__item teacher-sidebar__logout"
                        title="Đăng xuất">
                    <svg class="teacher-sidebar__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10" />
                    </svg>
                    <span class="teacher-sidebar__label">Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="teacher-page">
        <header class="teacher-topbar">
            <div>
                <div class="teacher-topbar__eyebrow">Teacher workspace</div>
                <div class="teacher-topbar__title">@(ViewData["Title"] ?? "Teacher")</div>
            </div>
            <span class="teacher-topbar__role">Teacher</span>
        </header>

        <main id="teacher-main-content" role="main" class="teacher-main" tabindex="-1">
            @RenderBody()
        </main>

        <footer class="teacher-footer">
            &copy; 2026 English Learning Online System
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
