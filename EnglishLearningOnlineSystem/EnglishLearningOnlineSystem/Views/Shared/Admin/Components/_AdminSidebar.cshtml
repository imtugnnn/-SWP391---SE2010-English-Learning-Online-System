@inject EnglishLearningOnlineSystem.Repositories.Interfaces.IAcademicYearRepository _academicYearRepository
<div class="admin-sidebar">
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        int? activeYearId = ViewBag.ActiveAcademicYearId is int id ? id : null;
        if (!activeYearId.HasValue)
        {
            activeYearId = (await _academicYearRepository.GetActiveAcademicYearsAsync()).FirstOrDefault()?.AcademicYearId;
        }
    }
    <!-- Logo -->
    <div class="sidebar-logo">
        <img src="/images/logo/els logo.png" alt="ELS Logo">
        <div class="logo-text">
            <h4>EduLearn</h4>
            <span>Trang quản trị</span>
        </div>
        <button type="button" class="collapse-toggle-btn" id="sidebarCollapseBtn" title="Thu gọn sidebar">
            <i class="bi bi-chevron-double-left"></i>
        </button>
    </div>

    <!-- Profile -->
    <div class="sidebar-profile">
        <div class="profile-avatar">
            A
        </div>
        <div class="profile-info">
            <h5>Quản trị viên</h5>
            <span>Quản trị hệ thống</span>
        </div>
    </div>

    <!-- Menu -->
    <ul class="sidebar-menu">
        <li>
            <a class="@(controller == "Admin" && action == "Dashboard" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Dashboard"
               title="Bảng điều khiển">
                <i class="bi bi-grid-fill"></i>
                <span>Bảng điều khiển</span>
            </a>
        </li>

        <li>
            <a class="@(controller == "Admin" && action == "UserManagement" ? "active" : "")"
               asp-controller="Admin"
               asp-action="UserManagement"
               title="Quản lý người dùng">
                <i class="bi bi-people-fill"></i>
                <span>Quản lý người dùng</span>
            </a>
        </li>

        <li>
            <a class="@(controller == "AcademicYears" && (action == "Index" || action == "Create") ? "active" : "")"
               asp-controller="AcademicYears"
               asp-action="Index"
               title="Quản lý năm học">
                <i class="bi bi-calendar3"></i>
                <span>Quản lý năm học</span>
            </a>
        </li>

        <li>
            @if (activeYearId.HasValue)
            {
                <a class="@(controller == "AcademicYears" && action == "Edit" ? "active" : "")"
                   asp-controller="AcademicYears"
                   asp-action="Edit"
                   asp-route-id="@activeYearId.Value"
                   title="Quản lý lớp học">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Quản lý lớp học</span>
                </a>
            }
            else
            {
                <a class="@(controller == "AcademicYears" && action == "Edit" ? "active" : "")"
                   asp-controller="AcademicYears"
                   asp-action="Index"
                   title="Quản lý lớp học">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Quản lý lớp học</span>
                </a>
            }
        </li>

        <li>
            <a class="@(controller == "SystemNotifications" && action == "Index" ? "active" : "")"
               asp-controller="SystemNotifications"
               asp-action="Index"
               title="Quản lý thông báo">
                <i class="bi bi-bell-fill"></i>
                <span>Quản lý thông báo</span>
            </a>
        </li>

        <li>
            <a class="@(controller == "AuditLog" ? "active" : "")"
               asp-controller="AuditLog"
               asp-action="Index"
               title="Nhật ký hệ thống">
                <i class="bi bi-clock-history"></i>
                <span>Nhật ký hệ thống</span>
            </a>
        </li>

        <li>
            <a class="@(controller == "Maintenance" && action == "Index" ? "active" : "")"
               asp-controller="Maintenance"
               asp-action="Index"
               title="Cấu hình bảo trì">
                <i class="bi bi-gear-wide-connected"></i>
                <span>Cấu hình bảo trì</span>
            </a>
        </li>
    </ul>

    <!-- Footer / Logout -->
    <div class="sidebar-footer">
        <form asp-controller="Auth"
              asp-action="Logout"
              method="post"
              class="logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" title="Đăng xuất">
                <i class="bi bi-box-arrow-right"></i>
                <span>Đăng xuất</span>
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector(".admin-sidebar");
        const toggleBtn = document.getElementById("sidebarCollapseBtn");
        
        if (sidebar && toggleBtn) {
            // Restore state from localStorage
            const isCollapsed = localStorage.getItem("admin-sidebar-collapsed") === "true";
            if (isCollapsed) {
                sidebar.classList.add("collapsed");
                toggleBtn.innerHTML = '<i class="bi bi-chevron-double-right"></i>';
                toggleBtn.setAttribute("title", "Mở rộng sidebar");
            }

            toggleBtn.addEventListener("click", function () {
                const collapsed = sidebar.classList.toggle("collapsed");
                localStorage.setItem("admin-sidebar-collapsed", collapsed);
                
                if (collapsed) {
                    toggleBtn.innerHTML = '<i class="bi bi-chevron-double-right"></i>';
                    toggleBtn.setAttribute("title", "Mở rộng sidebar");
                } else {
                    toggleBtn.innerHTML = '<i class="bi bi-chevron-double-left"></i>';
                    toggleBtn.setAttribute("title", "Thu gọn sidebar");
                }
            });
        }
    });
</script>
