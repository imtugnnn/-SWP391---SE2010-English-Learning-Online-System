<nav class="admin-navbar">

    <div class="navbar-left">
        <h3>@ViewData["Title"]</h3>
    </div>

    <div class="navbar-right">

        <div style="position: relative;">
            <button type="button" class="icon-btn" id="topbarBell" title="Thông báo" onclick="toggleNotificationDropdown(event)">
                <i class="bi bi-bell"></i>
                <span class="navbar-badge d-none" id="bellDot"></span>
            </button>
            <div class="notif-dropdown d-none" id="notifDropdown">
                <div class="notif-dropdown-header">
                    Thông báo hệ thống
                </div>
                <div class="notif-dropdown-body" id="notifDropdownBody">
                    <div class="notif-loading">Đang tải...</div>
                </div>
            </div>
        </div>

        <div class="user-avatar">
            A
        </div>

    </div>

</nav>

<script>
    async function loadNotifications() {
        try {
            const response = await fetch('/admin/notifications/api');
            if (!response.ok) return;
            const data = await response.json();
            
            const body = document.getElementById('notifDropdownBody');
            const dot = document.getElementById('bellDot');
            
            if (!data || data.length === 0) {
                body.innerHTML = '<div class="notif-empty">Không có thông báo nào</div>';
                dot.classList.add('d-none');
                return;
            }
            
            // So sánh ID mới nhất với ID đã xem lần cuối
            const lastSeenId = parseInt(localStorage.getItem('lastSeenAdminNotifId') || '0', 10);
            const latestId = data[0].id;
            
            // Đếm số thông báo mới chưa xem
            const unreadCount = data.filter(n => n.id > lastSeenId).length;
            if (unreadCount > 0) {
                dot.textContent = unreadCount;
                dot.classList.remove('d-none');
            } else {
                dot.classList.add('d-none');
            }
            
            body.innerHTML = '';
            data.forEach(n => {
                const item = document.createElement('div');
                item.className = 'notif-item';
                
                const timeFormatted = formatDateTimeStr(n.publishTime);
                
                item.innerHTML = `
                    <div class="notif-item-title">${escapeHtmlStr(n.title)}</div>
                    <div class="notif-item-content">${escapeHtmlStr(n.content)}</div>
                    <div class="notif-item-time">🕒 ${timeFormatted}</div>
                `;
                body.appendChild(item);
            });
            
            window.latestAdminNotifId = latestId;
        } catch (err) {
            console.error(err);
            document.getElementById('notifDropdownBody').innerHTML = '<div class="notif-empty">Không thể tải thông báo</div>';
        }
    }
    
    function toggleNotificationDropdown(e) {
        e.stopPropagation();
        const panel = document.getElementById('notifDropdown');
        const isOpen = !panel.classList.contains('d-none');
        
        if (isOpen) {
            panel.classList.add('d-none');
        } else {
            panel.classList.remove('d-none');
            // Ẩn chấm đỏ và lưu ID thông báo cuối cùng làm mốc đã xem
            if (window.latestAdminNotifId) {
                localStorage.setItem('lastSeenAdminNotifId', window.latestAdminNotifId);
                document.getElementById('bellDot').classList.add('d-none');
            }
        }
    }
    
    // Đóng dropdown khi click ra ngoài
    document.addEventListener('click', function(e) {
        const panel = document.getElementById('notifDropdown');
        const bell = document.getElementById('topbarBell');
        if (panel && !panel.contains(e.target) && !bell.contains(e.target)) {
            panel.classList.add('d-none');
        }
    });
    
    function formatDateTimeStr(dateStr) {
        if (!dateStr) return '';
        try {
            const d = new Date(dateStr);
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            const hours = String(d.getHours()).padStart(2, '0');
            const minutes = String(d.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${minutes}`;
        } catch {
            return '';
        }
    }
    
    function escapeHtmlStr(text) {
        if (!text) return '';
        return text.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
    
    document.addEventListener('DOMContentLoaded', loadNotifications);
</script>
