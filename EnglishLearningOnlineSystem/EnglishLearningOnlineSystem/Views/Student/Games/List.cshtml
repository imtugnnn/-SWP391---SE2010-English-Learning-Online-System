@model EnglishLearningOnlineSystem.ViewModels.Student.Games.StudentMiniGameListViewModel
@{
    ViewData["Title"] = "Mini Game";
}

<div class="container py-4" style="max-width: 700px;">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-controller="StudentLessons" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <div>
            <h2 class="mb-0">Mini Game</h2>
            <span class="text-muted small">Bài học: @Model.LessonTitle</span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Games.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-controller fs-1 d-block mb-2"></i>
            Bài học này chưa có trò chơi nào.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var game in Model.Games)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <i class="bi bi-puzzle text-primary me-2"></i>@game.Title
                            </h5>
                            <p class="text-muted small mb-3">Word Scramble</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="badge bg-warning text-dark fs-6">
                                    <i class="bi bi-star-fill me-1"></i>+@game.XPReward XP
                                </span>
                                <a asp-controller="WordScramble" asp-action="Play"
                                   asp-route-id="@game.GameId"
                                   class="btn btn-primary btn-sm">
                                    <i class="bi bi-play-fill"></i> Chơi ngay
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
