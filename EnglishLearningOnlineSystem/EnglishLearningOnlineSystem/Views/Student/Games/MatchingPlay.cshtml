@model EnglishLearningOnlineSystem.ViewModels.Student.Games.MatchingPlayViewModel
@{
    Layout = "_StudentLayout"; @* Đổi tên layout nếu project bạn dùng tên khác *@
    ViewData["Title"] = "Ghép từ";
}

<div class="container py-4" style="max-width: 720px;">
    <h2 class="mb-1">@Model.GameTitle</h2>
    <p class="text-muted">
        Bài học: <strong>@Model.LessonTitle</strong> · Ghép mỗi từ ở cột trái với nghĩa đúng ở danh sách thả xuống.
    </p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="Matching" asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="GameId" value="@Model.GameId" />

        <div class="card">
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%;">Từ</th>
                            <th>Chọn nghĩa tương ứng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Words.Count; i++)
                        {
                            var word = Model.Words[i];
                            <tr>
                                <td class="fw-semibold">@word.Text</td>
                                <td>
                                    <input type="hidden" name="Answers[@i].VocabularyId" value="@word.VocabularyId" />
                                    <select name="Answers[@i].SelectedMeaningVocabularyId" class="form-select" required>
                                        <option value="">— Chọn nghĩa —</option>
                                        @foreach (var meaning in Model.Meanings)
                                        {
                                            <option value="@meaning.VocabularyId">@meaning.Text</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="badge bg-warning text-dark">Tối đa +@Model.XPReward XP</span>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Nộp đáp án
            </button>
        </div>
    </form>
</div>
