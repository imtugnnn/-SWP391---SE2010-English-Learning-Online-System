@model EnglishLearningOnlineSystem.ViewModels.Student.Games.WordScramblePlayViewModel
@{
    ViewData["Title"] = "Word Scramble";
    Layout = "_StudentLayout";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a href="/student/lesson/@Model.LessonId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại bài học
        </a>
        <div>
            <h2 class="mb-0">@Model.GameTitle</h2>
            <span class="text-muted small">Bài học: @Model.LessonTitle</span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body text-center">

            <!-- Gợi ý hình ảnh -->
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Gợi ý"
                     class="img-fluid rounded mb-3"
                     style="max-height: 180px; object-fit: contain;" />
            }

            <!-- Nghĩa của từ -->
            <p class="text-muted mb-2">Nghĩa:</p>
            <h5 class="mb-4">@Model.Meaning</h5>

            <!-- Phát âm -->
            @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
            {
                <audio controls class="mb-4 w-100">
                    <source src="@Model.AudioUrl" />
                    Trình duyệt của bạn không hỗ trợ phát âm.
                </audio>
            }

            <!-- Chữ đã xáo trộn -->
            <div class="mb-4">
                <p class="text-muted mb-1">Sắp xếp lại các chữ cái:</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @foreach (var letter in Model.ScrambledWord)
                    {
                        <span class="badge bg-primary fs-5 px-3 py-2" style="letter-spacing: 2px;">
                            @letter
                        </span>
                    }
                </div>
            </div>

            <!-- Form nhập đáp án -->
            <form action="/WordScramble/Submit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="GameId" value="@Model.GameId" />
                <input type="hidden" name="VocabularyId" value="@Model.VocabularyId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nhập đáp án của bạn:</label>
                    <input type="text" name="Answer"
                           class="form-control form-control-lg text-center"
                           placeholder="Gõ từ vào đây..."
                           autofocus autocomplete="off" />
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="badge bg-warning text-dark fs-6">
                        <i class="bi bi-star-fill me-1"></i>Phần thưởng: +@Model.XPReward XP
                    </span>
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-check2-circle me-1"></i> Xác nhận
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
