@* ============================================================
   ORIGINAL LOGIC: 100% preserved — model binding, form action (/WordScramble/Submit),
   hidden inputs (GameId, VocabularyId), answer input name, AntiForgery, TempData,
   conditional image/audio blocks — all unchanged.
   CHANGED: HTML structure (layout only), all CSS in <style> block below.
   ============================================================ *@

@model EnglishLearningOnlineSystem.ViewModels.Student.Games.WordScramblePlayViewModel
@{
    ViewData["Title"] = "Word Scramble";
    Layout = "_StudentLayout";
}

@* ── ADDED: scoped styles ─────────────────────────────────── *@
<style>
    :root {
        --primary: #4f6ef7;
        --accent: #f59e0b;
        --success: #22c55e;
        --radius: 14px;
        --shadow: 0 4px 28px rgba(79,110,247,.12);
    }

    .scramble-page {
        min-height: 100vh;
        background: linear-gradient(160deg, #eef2ff 0%, #f5f3ff 100%);
        padding: 2rem 1rem 3rem;
    }

    /* ── Top nav bar ── */
    .scramble-topbar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.75rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .btn-back-lesson {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #fff;
        color: #4f6ef7;
        border: 1.5px solid #c7d2fe;
        border-radius: 9px;
        padding: .45rem 1rem;
        font-size: .88rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background .15s;
    }

        .btn-back-lesson:hover {
            background: #eef2ff;
            color: #4f6ef7;
        }

    .scramble-topbar-title h2 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e2340;
        margin: 0 0 .1rem;
    }

    .scramble-topbar-title span {
        font-size: .82rem;
        color: #6b7280;
    }

    /* ── Main card ── */
    .scramble-card {
        max-width: 600px;
        margin: 0 auto;
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    /* ── Card header strip ── */
    .scramble-card-header {
        background: linear-gradient(120deg, #4f6ef7, #7c3aed);
        padding: .85rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .scramble-card-header .game-label {
            color: rgba(255,255,255,.85);
            font-size: .8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

    .xp-chip {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        background: linear-gradient(90deg,#f59e0b,#fbbf24);
        color: #1e2340;
        font-weight: 700;
        font-size: .82rem;
        padding: .28rem .75rem;
        border-radius: 99px;
    }

    /* ── Card body ── */
    .scramble-body {
        padding: 1.75rem 1.5rem 1.5rem;
        text-align: center;
    }

    /* ── Image hint ── */
    .hint-image {
        max-height: 170px;
        object-fit: contain;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    /* ── Meaning section ── */
    .meaning-label {
        font-size: .78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: #9ca3af;
        margin-bottom: .35rem;
    }

    .meaning-text {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1e2340;
        margin-bottom: 1.25rem;
    }

    /* ── Audio ── */
    .scramble-audio {
        width: 100%;
        border-radius: 9px;
        margin-bottom: 1.5rem;
        accent-color: var(--primary);
    }

    /* ── Tile strip ── */
    .tiles-label {
        font-size: .78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: #9ca3af;
        margin-bottom: .6rem;
    }

    .tiles-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: .5rem;
        margin-bottom: 1.75rem;
    }
    /* ── CHANGED: each letter is a 3-D game tile ── */
    .letter-tile {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 52px;
        background: linear-gradient(160deg, #4f6ef7 0%, #3730a3 100%);
        color: #fff;
        font-size: 1.25rem;
        font-weight: 800;
        border-radius: 9px;
        box-shadow: 0 4px 0 #2e27a0, 0 6px 12px rgba(79,110,247,.3);
        letter-spacing: 0;
        user-select: none;
        transition: transform .12s;
    }

        .letter-tile:hover {
            transform: translateY(-2px);
        }

    /* ── Answer input ── */
    .answer-input-wrap {
        position: relative;
        margin-bottom: 1.25rem;
    }

    .answer-input {
        width: 100%;
        border: 2px solid #d1d5db;
        border-radius: 10px;
        padding: .75rem 1rem;
        font-size: 1.2rem;
        font-weight: 700;
        text-align: center;
        color: #1e2340;
        background: #f8faff;
        letter-spacing: .12em;
        transition: border-color .2s, box-shadow .2s;
        box-sizing: border-box;
    }

        .answer-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79,110,247,.18);
            outline: none;
            background: #fff;
        }

    /* ── Submit button ── */
    .btn-submit-scramble {
        width: 100%;
        background: linear-gradient(90deg,#22c55e,#16a34a);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .8rem 1rem;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        box-shadow: 0 3px 0 #15803d, 0 5px 14px rgba(34,197,94,.3);
        transition: transform .12s, box-shadow .12s;
    }

        .btn-submit-scramble:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 0 #15803d, 0 8px 20px rgba(34,197,94,.35);
        }

        .btn-submit-scramble:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 #15803d;
        }

    /* ── Alert ── */
    .scramble-alert {
        border-radius: 10px;
        margin: 1rem 1.5rem 0;
        background: #fee2e2;
        color: #991b1b;
        padding: .75rem 1rem;
        font-size: .9rem;
        display: flex;
        align-items: center;
        gap: .5rem;
        border: none;
    }


</style>
@* ── END ADDED styles ──────────────────────────────────────── *@

@* ── CHANGED: wrapper; was bare container ── *@
<div class="scramble-page">

    @* ── CHANGED: top bar layout; href/route UNCHANGED ── *@
    <div class="scramble-topbar">
        <a href="/student/lesson/@Model.LessonId?assignmentId=@Model.AssignmentId" class="btn-back-lesson">
            <i class="bi bi-arrow-left"></i> Quay lại bài học
        </a>
        <div class="scramble-topbar-title">
            <h2>@Model.GameTitle</h2>
            <span>Bài học: @Model.LessonTitle</span>
        </div>
    </div>

    <div class="scramble-card">

        @* ── CHANGED: gradient header strip with XP chip ── *@
        <div class="scramble-card-header">
            <span class="game-label"><i class="bi bi-puzzle-fill me-1"></i>Word Scramble</span>
            @* ── ORIGINAL: XPReward — unchanged ── *@
            <span class="xp-chip"><i class="bi bi-star-fill"></i>+@Model.XPReward XP</span>
        </div>

        @* ── ORIGINAL: TempData["ErrorMessage"] — logic unchanged ── *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="scramble-alert alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="scramble-body">

            @* ── ORIGINAL: conditional image — logic unchanged ── *@
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Gợi ý" class="hint-image img-fluid" />
            }

            @* ── ORIGINAL: Meaning display — unchanged ── *@
            <p class="meaning-label">Nghĩa</p>
            <h5 class="meaning-text">@Model.Meaning</h5>

            @* ── ORIGINAL: conditional audio — logic unchanged ── *@
            @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
            {
                <audio controls class="scramble-audio">
                    <source src="@Model.AudioUrl" />
                    Trình duyệt của bạn không hỗ trợ phát âm.
                </audio>
            }

            @* ── CHANGED: letters rendered as 3-D game tiles; logic unchanged ── *@
            <p class="tiles-label">Sắp xếp lại các chữ cái</p>
            <div class="tiles-row">
                @* ── ORIGINAL: foreach Model.ScrambledWord — unchanged ── *@
                @foreach (var letter in Model.ScrambledWord)
                {
                    <span class="letter-tile">@letter</span>
                }
            </div>

            @* ── ORIGINAL: form action, hidden inputs, answer input — all UNCHANGED ── *@
            <form action="/WordScramble/Submit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="GameId" value="@Model.GameId" />
                <input type="hidden" name="AssignmentId" value="@Model.AssignmentId" />
                <input type="hidden" name="VocabularyId" value="@Model.VocabularyId" />

                <div class="answer-input-wrap">
                    <label class="form-label fw-semibold text-start d-block mb-1" style="font-size:.88rem;color:#6b7280;">Nhập đáp án của bạn</label>
                    <input type="text"
                           name="Answer"
                           class="answer-input"
                           placeholder="Gõ từ vào đây..."
                           autofocus
                           autocomplete="off" />
                </div>

                @* ── CHANGED: submit button restyled; type/submit intent unchanged ── *@
                <button type="submit" class="btn-submit-scramble">
                    <i class="bi bi-check2-circle"></i> Xác nhận
                </button>
            </form>

        </div>@* /scramble-body *@
    </div>@* /scramble-card *@
</div>

@* ── ADDED: tile wiggle on page load to signal interactivity ── *@
<script>
    document.querySelectorAll('.letter-tile').forEach((tile, i) => {
        tile.style.animationDelay = `${i * 60}ms`;
        tile.style.animation = `tilePop .35s ease both`;
    });
</script>
