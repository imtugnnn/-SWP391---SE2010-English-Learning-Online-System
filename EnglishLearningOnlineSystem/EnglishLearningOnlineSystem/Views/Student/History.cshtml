@model EnglishLearningOnlineSystem.ViewModels.AttemptHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử học tập";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["ActiveNav"] = "history";
}

@section Styles {
    <style>
        .history-container {
            max-width: 1000px;
            margin: 0 auto;
        }
        .filter-bar {
            background: var(--card);
            border-radius: var(--radius);
            padding: 20px;
            margin-bottom: 30px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }
        .attempt-card {
            background: var(--card);
            border-radius: var(--radius);
            padding: 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
            border: 1px solid var(--border);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .attempt-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(14, 165, 233, 0.15);
        }
        .card-info h4 {
            font-weight: 800;
            color: var(--text);
            margin-bottom: 5px;
        }
        .card-meta {
            color: var(--muted);
            font-size: 0.9rem;
            display: flex;
            gap: 15px;
            align-items: center;
        }
        .score-pill {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 800;
            font-size: 1.2rem;
            color: white;
            min-width: 80px;
            text-align: center;
        }
        .score-high { background: var(--green); }
        .score-mid { background: var(--orange); }
        .score-low { background: var(--red); }
        .empty-state {
            text-align: center;
            padding: 50px 20px;
            background: var(--card);
            border-radius: var(--radius);
            border: 1px dashed var(--border);
        }
        .empty-state h3 {
            font-weight: 800;
            color: var(--muted);
            margin-top: 15px;
        }
    </style>
}

<div class="history-container">
    <h2 class="fw-bold mb-4" style="color: var(--text);">Lịch sử học tập </h2>

    <div class="filter-bar">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Bài học</label>
                <select name="LessonId" class="form-select" style="border-radius: 12px;">
                    <option value="">Tất cả bài học</option>
                    @if (Model.AvailableLessons != null)
                    {
                        foreach (var l in Model.AvailableLessons)
                        {
                            <option value="@l.LessonId" selected="@(Model.FilterLessonId == l.LessonId ? "selected" : null)">@l.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Từ ngày</label>
                <input type="date" name="from" class="form-control" style="border-radius: 12px;" value="@Model.FilterFrom" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Đến ngày</label>
                <input type="date" name="to" class="form-control" style="border-radius: 12px;" value="@Model.FilterTo" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Sắp xếp theo</label>
                <select name="SortBy" class="form-select" style="border-radius: 12px;">
                    <option value="date_desc">Mới nhất</option>
                    <option value="date_asc">Cũ nhất</option>
                    <option value="score_desc">Điểm cao nhất</option>
                    <option value="score_asc">Điểm thấp nhất</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100" style="border-radius: 12px; background: var(--sky-dark); border: none; height: 38px;">Lọc</button>
            </div>
        </form>
    </div>

    <div class="attempts-list">
        @if (Model.Attempts != null && Model.Attempts.Any())
        {
            foreach (var attempt in Model.Attempts)
            {
                <div class="attempt-card">
                    <div class="card-info">
                        <h4>@attempt.LessonTitle</h4>
                        <div class="card-meta">
                            <span><i class="bi bi-clock"></i> @(attempt.TimeSpentSec < 0 ? 0 : attempt.TimeSpentSec) s</span>
                            <span><i class="bi bi-calendar"></i> @attempt.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="card-score">
                        @{
                            string scoreClass = "score-high";
                            if (attempt.Score < 50) scoreClass = "score-low";
                            else if (attempt.Score < 80) scoreClass = "score-mid";
                        }
                        <div class="score-pill @scoreClass">
                            @attempt.Score%
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <span style="font-size: 3rem;"></span>
                <h3>Chưa có lịch sử</h3>
                <p class="text-muted">Bạn chưa hoàn thành bài kiểm tra nào phù hợp với bộ lọc này.</p>
            </div>
        }
    </div>
</div>
