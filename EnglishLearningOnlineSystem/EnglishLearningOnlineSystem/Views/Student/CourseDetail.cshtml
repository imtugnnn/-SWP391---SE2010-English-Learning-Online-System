@model EnglishLearningOnlineSystem.ViewModels.CourseDetailViewModel
@{
    ViewData["Title"] = Model.CourseName;
    ViewData["ActiveNav"] = "courses";
    Layout = "_StudentLayout";

    var total = Model.Lessons.Count;
    var completed = Model.Lessons.Count(l => l.CompletionStatus == "Completed");
    var inProg = Model.Lessons.Count(l => l.CompletionStatus == "In Progress");
    var pct = total > 0 ? (int)((double)completed / total * 100) : 0;

    var thumbClass = Model.GradeLevel switch
    {
        "1" => "grade-1",
        "2" => "grade-2",
        "3" => "grade-3",
        "4" => "grade-4",
        "5" => "grade-5",
        _ => "grade-other"
    };
    var emoji = Model.GradeLevel switch
    {
        "1" => "",
        "2" => "",
        "3" => "",
        "4" => "",
        "5" => "",
        _ => ""
    };
}

@section Styles {
    <style>
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: .85rem;
            font-weight: 800;
            color: var(--sky-d);
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 10px;
            background: #e0f2fe;
            transition: background .15s;
            margin-bottom: 20px;
        }

            .back-btn:hover {
                background: var(--border);
                color: var(--sky-d);
            }

        /* Hero */
        .course-hero {
            border-radius: 24px;
            padding: 28px 32px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 28px;
            box-shadow: 0 8px 32px rgba(99,102,241,.22);
            position: relative;
            overflow: hidden;
        }

            .course-hero::before {
                content: '';
                position: absolute;
                top: -50px;
                right: -50px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

        .course-hero.grade-1 { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
        .course-hero.grade-2 { background: linear-gradient(135deg, #3b82f6, #60a5fa); }
        .course-hero.grade-3 { background: linear-gradient(135deg, #22c55e, #4ade80); }
        .course-hero.grade-4 { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }
        .course-hero.grade-5 { background: linear-gradient(135deg, #ec4899, #f472b6); }
        .course-hero.grade-other { background: linear-gradient(135deg, #0ea5e9, #6366f1); }

        .hero-emoji {
            font-size: 3.5rem;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .hero-info {
            flex: 1;
            position: relative;
            z-index: 1;
        }

        .hero-grade {
            font-size: .78rem;
            font-weight: 800;
            opacity: .85;
            margin-bottom: 6px;
        }

        .hero-title {
            font-size: 1.6rem;
            font-weight: 900;
            margin-bottom: 10px;
            line-height: 1.2;
        }

        .hero-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .hero-tag {
            background: rgba(255,255,255,.22);
            padding: 3px 12px;
            border-radius: 99px;
            font-size: .75rem;
            font-weight: 800;
        }

        /* Progress overview */
        .progress-card {
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: var(--radius);
            padding: 20px 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
        }

        .prog-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

            .prog-header h3 {
                font-size: .95rem;
                font-weight: 900;
            }

        .prog-pct {
            font-size: .9rem;
            font-weight: 900;
            color: var(--sky-d);
        }

        .prog-bar {
            height: 10px;
            background: #e2e8f0;
            border-radius: 99px;
            overflow: hidden;
            margin-bottom: 12px;
        }

        .prog-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--sky), #6366f1);
            border-radius: 99px;
            transition: width .8s;
        }

        .prog-stats {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
        }

        .prog-stat {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: .78rem;
            font-weight: 700;
            color: var(--muted);
        }

        .ps-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .dot-done { background: var(--green); }
        .dot-doing { background: var(--yellow); }
        .dot-pending { background: #e2e8f0; }

        /* Lesson list */
        .lesson-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .lesson-row {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 16px 20px;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--shadow);
            transition: transform .15s, border-color .15s, box-shadow .15s;
        }

            .lesson-row:hover {
                transform: translateX(5px);
                border-color: var(--sky);
                box-shadow: 0 6px 20px rgba(14,165,233,.18);
                color: inherit;
            }

            .lesson-row.completed {
                border-color: #86efac;
            }

            .lesson-row.in-progress {
                border-color: #fde68a;
            }

        /* Order badge */
        .order-badge {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .82rem;
            font-weight: 900;
            flex-shrink: 0;
        }

        .ob-done {
            background: #dcfce7;
            color: #15803d;
        }

        .ob-doing {
            background: #fef9c3;
            color: #a16207;
        }

        .ob-pending {
            background: #f1f5f9;
            color: #64748b;
        }

        .lesson-info {
            flex: 1;
        }

        .lesson-title {
            font-size: .95rem;
            font-weight: 900;
            color: var(--text);
            margin-bottom: 5px;
        }

        .lesson-meta {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .meta-tag {
            font-size: .7rem;
            font-weight: 800;
            padding: 2px 9px;
            border-radius: 99px;
        }

        .tag-topic {
            background: #f3e8ff;
            color: #7c3aed;
        }

        .tag-time {
            background: #f0fdf4;
            color: #16a34a;
        }

        /* Right */
        .lesson-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 5px;
            flex-shrink: 0;
        }

        .xp-badge {
            background: #fef9c3;
            border: 1.5px solid #fde68a;
            color: #92400e;
            font-size: .75rem;
            font-weight: 900;
            padding: 3px 10px;
            border-radius: 99px;
        }

        .status-pill {
            font-size: .68rem;
            font-weight: 900;
            padding: 2px 10px;
            border-radius: 99px;
        }

        .pill-done { background: #dcfce7; color: #15803d; }
        .pill-doing { background: #fef9c3; color: #a16207; }
        .pill-pending { background: #f1f5f9; color: #475569; }

        .score-pill {
            font-size: .72rem;
            font-weight: 900;
            padding: 2px 10px;
            border-radius: 99px;
        }

        .score-high { background: #dcfce7; color: #15803d; }
        .score-mid  { background: #fef9c3; color: #a16207; }
        .score-low  { background: #fee2e2; color: #dc2626; }

        /* Arrow */
        .lesson-arrow {
            color: var(--muted);
            font-size: .9rem;
            flex-shrink: 0;
            transition: transform .15s, color .15s;
        }

        .lesson-row:hover .lesson-arrow {
            transform: translateX(3px);
            color: var(--sky-d);
        }

        /* Empty */
        .empty-box {
            background: var(--card);
            border: 2px dashed var(--border);
            border-radius: var(--radius);
            padding: 60px 20px;
            text-align: center;
            color: var(--muted);
        }

            .empty-box p {
                font-size: .95rem;
                font-weight: 700;
            }

        @@media (max-width: 600px) {
            .hero-emoji { display: none; }
            .hero-title { font-size: 1.2rem; }
        }
    </style>
}

<!-- Back -->
<a href="/student/courses" class="back-btn">← Khoá học</a>

<!-- Hero -->
<div class="course-hero @thumbClass">
    <div class="hero-emoji">@emoji</div>
    <div class="hero-info">
        <div class="hero-grade">Lớp @Model.GradeLevel</div>
        <div class="hero-title">@Model.CourseName</div>
        <div class="hero-tags">
            <span class="hero-tag">@total bài học</span>
            <span class="hero-tag">@completed hoàn thành</span>
            @if (Model.IsEnrolled)
            {
                <span class="hero-tag">✓ Đang học</span>
            }
        </div>
    </div>
</div>

<!-- Progress -->
<div class="progress-card">
    <div class="prog-header">
        <h3>Tiến độ khoá học</h3>
        <span class="prog-pct">@pct%</span>
    </div>
    <div class="prog-bar">
        <div class="prog-fill" style="width:@pct%"></div>
    </div>
    <div class="prog-stats">
        <span class="prog-stat"><span class="ps-dot dot-done"></span>Hoàn thành: @completed</span>
        <span class="prog-stat"><span class="ps-dot dot-doing"></span>Đang học: @inProg</span>
        <span class="prog-stat"><span class="ps-dot dot-pending"></span>Chưa học: @(total - completed - inProg)</span>
    </div>
</div>

<!-- Lesson list -->
@if (!Model.Lessons.Any())
{
    <div class="empty-box"><p>Khoá học này chưa có bài học nào.</p></div>
}
else
{
    <div class="lesson-list">
        @foreach (var l in Model.Lessons)
        {
            var rowClass = l.CompletionStatus == "Completed" ? "completed"
                         : l.CompletionStatus == "In Progress" ? "in-progress" : "";

            var obClass = l.CompletionStatus == "Completed" ? "ob-done"
                        : l.CompletionStatus == "In Progress" ? "ob-doing" : "ob-pending";

            var obText = l.CompletionStatus == "Completed" ? "✓"
                       : l.CompletionStatus == "In Progress" ? "▶" : l.OrderIndex.ToString();

            var pillClass = l.CompletionStatus == "Completed" ? "pill-done"
                          : l.CompletionStatus == "In Progress" ? "pill-doing" : "pill-pending";

            var pillText = l.CompletionStatus == "Completed" ? "Hoàn thành"
                         : l.CompletionStatus == "In Progress" ? "Đang học" : "Chưa học";

            var scoreClass = l.BestScore >= 80 ? "score-high" : l.BestScore >= 50 ? "score-mid" : "score-low";

            <a href="/student/lesson/@l.LessonId" class="lesson-row @rowClass">
                <div class="order-badge @obClass">@obText</div>
                <div class="lesson-info">
                    <div class="lesson-title">@l.Title</div>
                    <div class="lesson-meta">
                        @if (!string.IsNullOrEmpty(l.Topic))
                        {
                            <span class="meta-tag tag-topic">@l.Topic</span>
                        }
                        <span class="meta-tag tag-time">@l.EstimatedMinutes phút</span>
                    </div>
                </div>
                <div class="lesson-right">
                    <span class="xp-badge">+@l.XPReward XP</span>
                    <span class="status-pill @pillClass">@pillText</span>
                    @if (l.CompletionStatus == "Completed")
                    {
                        <span class="score-pill @scoreClass">@l.BestScore%</span>
                    }
                </div>
                <span class="lesson-arrow">→</span>
            </a>
        }
    </div>
}
