@model EnglishLearningOnlineSystem.ViewModels.FlashcardResultViewModel
@{
    ViewData["Title"] = "Kết quả ôn tập";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["ActiveNav"] = "vocabulary";
}

@section Styles {
    <style>
        .result-container {
            max-width: 800px;
            margin: 0 auto;
            padding-bottom: 50px;
        }
        .result-hero {
            background: linear-gradient(135deg, var(--sky), var(--purple));
            color: white;
            border-radius: var(--radius);
            padding: 40px 30px;
            text-align: center;
            box-shadow: var(--shadow);
            margin-bottom: 40px;
        }
        .hero-title {
            font-size: 2.2rem;
            font-weight: 900;
            margin-bottom: 10px;
        }
        .hero-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 25px;
        }
        .stat-box {
            background: rgba(255, 255, 255, 0.2);
            padding: 15px 30px;
            border-radius: 16px;
            backdrop-filter: blur(10px);
        }
        .stat-val {
            font-size: 2rem;
            font-weight: 900;
        }
        .stat-lbl {
            font-size: 0.85rem;
            font-weight: 700;
            opacity: 0.9;
        }
        
        .list-header {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 20px;
        }
        
        .word-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        
        .word-card {
            background: var(--card);
            border-radius: var(--radius);
            padding: 20px;
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--shadow);
            transition: transform 0.2s;
        }
        .word-card:hover {
            transform: translateY(-3px);
        }
        .word-card.knew {
            border-color: #bbf7d0;
            background: #f0fdf4;
        }
        .word-card.didnt-know {
            border-color: #fecaca;
            background: #fef2f2;
        }
        
        .word-info h4 {
            font-weight: 800;
            margin: 0 0 4px 0;
            color: var(--text);
            font-size: 1.1rem;
        }
        .word-info p {
            margin: 0;
            color: var(--muted);
            font-size: 0.85rem;
        }
        .word-icon {
            font-size: 1.5rem;
        }
        
        .btn-home {
            display: block;
            width: 100%;
            text-align: center;
            background: var(--sky);
            color: white;
            font-weight: 800;
            padding: 15px;
            border-radius: 99px;
            text-decoration: none;
            transition: all 0.2s;
        }
        .btn-home:hover {
            background: var(--sky-d);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(14, 165, 233, 0.3);
        }
    </style>
}

<div class="result-container">
    <div class="result-hero">
        <div class="hero-title">Hoàn thành ôn tập!</div>
        <p class="fs-5">Bạn đã ôn lại @Model.TotalCards từ vựng của bài "@Model.LessonTitle"</p>
        
        <div class="hero-stats">
            <div class="stat-box">
                <div class="stat-val">@Model.KnewCards</div>
                <div class="stat-lbl">Từ đã thuộc</div>
            </div>
            <div class="stat-box">
                <div class="stat-val">@(Model.TotalCards - Model.KnewCards)</div>
                <div class="stat-lbl">Cần ôn thêm</div>
            </div>
        </div>
    </div>

    <div class="list-header">Những từ bạn đã thuộc</div>
    <div class="word-grid">
        @foreach(var item in Model.Items.Where(i => i.KnewIt))
        {
            <div class="word-card knew">
                <div class="word-info">
                    <h4>@item.Word</h4>
                    <p>@item.Meaning</p>
                </div>
                <div class="word-icon text-success">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
        }
        @if(!Model.Items.Any(i => i.KnewIt))
        {
            <p class="text-muted w-100">Không có</p>
        }
    </div>

    <div class="list-header">Những từ cần ôn lại</div>
    <div class="word-grid">
        @foreach(var item in Model.Items.Where(i => !i.KnewIt))
        {
            <div class="word-card didnt-know">
                <div class="word-info">
                    <h4>@item.Word</h4>
                    <p>@item.Meaning</p>
                </div>
                <div class="word-icon text-danger">
                    <i class="fas fa-times-circle"></i>
                </div>
            </div>
        }
        @if(!Model.Items.Any(i => !i.KnewIt))
        {
            <p class="text-muted w-100">Không có! Tuyệt vời!</p>
        }
    </div>

    <a href="/student/dashboard" class="btn-home mt-5">Về trang chủ</a>
</div>
