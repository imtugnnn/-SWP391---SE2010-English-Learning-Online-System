@model EnglishLearningOnlineSystem.ViewModels.LessonDetailViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveNav"] = "lessons";
    Layout = "_StudentLayout";

    var hasVocab = Model.Vocabularies.Any();
    var hasQuiz = Model.Quizzes.Any();
    var hasGame = Model.MiniGames.Any();
}

@section Styles {
    <style>
        /* Back button */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: .85rem;
            font-weight: 800;
            color: var(--sky-d);
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 10px;
            background: #e0f2fe;
            transition: background .15s;
            margin-bottom: 20px;
        }

            .back-btn:hover {
                background: var(--border);
                color: var(--sky-d);
            }

        /* Hero card */
        .lesson-hero {
            background: linear-gradient(135deg, #0ea5e9, #6366f1);
            border-radius: 24px;
            padding: 28px 32px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
            box-shadow: 0 8px 32px rgba(99,102,241,.25);
            position: relative;
            overflow: hidden;
        }

            .lesson-hero::before {
                content: '';
                position: absolute;
                top: -40px;
                right: -40px;
                width: 180px;
                height: 180px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

        .hero-info {
            position: relative;
            z-index: 1;
        }

        .hero-breadcrumb {
            font-size: .78rem;
            opacity: .8;
            margin-bottom: 8px;
        }

        .hero-title {
            font-size: 1.5rem;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .hero-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .hero-tag {
            background: rgba(255,255,255,.2);
            padding: 3px 12px;
            border-radius: 99px;
            font-size: .75rem;
            font-weight: 800;
        }

        .hero-stats {
            display: flex;
            gap: 16px;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .hero-stat {
            text-align: center;
            background: rgba(255,255,255,.15);
            border-radius: 16px;
            padding: 14px 18px;
        }

            .hero-stat .hs-val {
                font-size: 1.4rem;
                font-weight: 900;
            }

            .hero-stat .hs-lbl {
                font-size: .7rem;
                opacity: .85;
                margin-top: 2px;
            }

        /* Progress section */
        .progress-section {
            background: var(--card);
            border-radius: var(--radius);
            border: 2px solid var(--border);
            padding: 20px 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
        }

        .progress-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

            .progress-header h3 {
                font-size: .95rem;
                font-weight: 900;
            }

        .progress-pct {
            font-size: .9rem;
            font-weight: 900;
            color: var(--sky-d);
        }

        .prog-bar {
            height: 12px;
            background: #e2e8f0;
            border-radius: 99px;
            overflow: hidden;
        }

        .prog-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--sky), #6366f1);
            border-radius: 99px;
            transition: width .8s;
        }

        .progress-steps {
            display: flex;
            gap: 8px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .step-chip {
            padding: 6px 14px;
            border-radius: 99px;
            font-size: .75rem;
            font-weight: 800;
            border: 2px solid var(--border);
            color: var(--muted);
            background: var(--bg);
        }

            .step-chip.done {
                background: #dcfce7;
                border-color: #86efac;
                color: #15803d;
            }

            .step-chip.active {
                background: #e0f2fe;
                border-color: var(--sky);
                color: var(--sky-d);
            }

        /* Quiz toast */
        .quiz-toast {
            border-radius: 14px;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: .9rem;
            font-weight: 800;
            margin-bottom: 20px;
            animation: fadeIn .4s ease;
        }

            .quiz-toast.success {
                background: #f0fdf4;
                border: 2px solid #86efac;
                color: #15803d;
            }

            .quiz-toast.fail {
                background: #fff7ed;
                border: 2px solid #fed7aa;
                color: #c2410c;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-8px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        /* Section card */
        .section-card {
            background: var(--card);
            border-radius: var(--radius);
            border: 2px solid var(--border);
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
        }

        .section-hd {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            padding-bottom: 14px;
            border-bottom: 2px solid #f1f5f9;
        }

            .section-hd h2 {
                font-size: 1rem;
                font-weight: 900;
                color: var(--text);
            }

        .section-count {
            background: var(--sky);
            color: #fff;
            font-size: .68rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 99px;
        }

        /* Vocabulary grid */
        .vocab-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(160px,1fr));
            gap: 14px;
        }

        .vocab-card {
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            text-align: center;
            cursor: pointer;
            transition: transform .15s, border-color .15s, box-shadow .15s;
        }

            .vocab-card:hover {
                transform: translateY(-3px);
                border-color: var(--sky);
                box-shadow: var(--shadow);
            }

            .vocab-card.flipped {
                border-color: #a78bfa;
                background: #f5f3ff;
            }

        .vocab-img {
            width: 64px;
            height: 64px;
            object-fit: contain;
            margin: 0 auto 8px;
            display: block;
            border-radius: 10px;
        }

        .vocab-img-placeholder {
            width: 64px;
            height: 64px;
            background: #e0f2fe;
            border-radius: 10px;
            margin: 0 auto 8px;
        }

        .vocab-word {
            font-size: 1rem;
            font-weight: 900;
            color: var(--text);
            margin-bottom: 4px;
        }

        .vocab-meaning {
            font-size: .8rem;
            font-weight: 700;
            color: var(--muted);
            display: none;
        }

        .vocab-hint {
            font-size: .65rem;
            color: var(--muted);
            margin-top: 6px;
            font-weight: 600;
        }

        .vocab-card.flipped .vocab-meaning {
            display: block;
            color: var(--purple);
        }

        .vocab-card.flipped .vocab-word {
            color: var(--purple);
        }

        /* Quiz form */
        .quiz-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .quiz-item {
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 18px;
        }

        .quiz-q {
            font-size: .95rem;
            font-weight: 900;
            color: var(--text);
            margin-bottom: 14px;
            display: flex;
            gap: 10px;
        }

        .q-num {
            background: var(--sky-d);
            color: #fff;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .75rem;
            font-weight: 900;
            flex-shrink: 0;
        }

        .options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .option-label {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: 12px;
            padding: 10px 14px;
            cursor: pointer;
            font-weight: 700;
            font-size: .85rem;
            transition: border-color .15s, background .15s;
        }

            .option-label:hover {
                border-color: var(--sky);
                background: #e0f2fe;
            }

            .option-label input[type=radio] {
                display: none;
            }

                .option-label input[type=radio]:checked + .opt-dot {
                    background: var(--sky-d);
                    border-color: var(--sky-d);
                }

            .option-label:has(input:checked) {
                border-color: var(--sky-d);
                background: #e0f2fe;
            }

        .opt-dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 2px solid var(--border);
            flex-shrink: 0;
            transition: all .15s;
        }

        /* Mini games */
        .game-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .game-card {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 14px 18px;
            text-decoration: none;
            color: inherit;
            transition: border-color .15s, transform .15s;
        }

            .game-card:hover {
                border-color: var(--purple);
                transform: translateX(4px);
                color: inherit;
            }

            .game-card.done {
                border-color: #86efac;
                background: #f0fdf4;
            }

        .game-info {
            flex: 1;
        }

        .game-title {
            font-size: .9rem;
            font-weight: 900;
        }

        .game-type {
            font-size: .72rem;
            font-weight: 700;
            color: var(--muted);
            margin-top: 2px;
        }

        .game-xp {
            font-size: .78rem;
            font-weight: 900;
            color: #92400e;
            background: #fef9c3;
            padding: 3px 10px;
            border-radius: 99px;
        }

        /* Submit btn */
        .btn-submit {
            background: linear-gradient(135deg,#0ea5e9,#6366f1);
            color: #fff;
            border: none;
            border-radius: 14px;
            padding: 14px 36px;
            font-family: 'Nunito', sans-serif;
            font-size: 1rem;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 4px 16px rgba(14,165,233,.3);
            transition: opacity .15s, transform .12s;
            margin-top: 20px;
            width: 100%;
        }

            .btn-submit:hover {
                opacity: .9;
                transform: translateY(-1px);
            }

        /* Empty */
        .empty-sm {
            text-align: center;
            padding: 24px;
            color: var(--muted);
            font-size: .85rem;
            font-weight: 700;
        }

        @@media (max-width: 992px) {
            .options-grid {
                grid-template-columns: 1fr;
            }

            .hero-stats {
                display: none;
            }
        }
    </style>
}

<!-- Back link -->
<a href="/student/lessons" class="back-btn">← Quay lại</a>

<!-- Quiz result toast -->
@if (TempData["QuizResult"] != null)
{
    var isOk = TempData["QuizOk"]?.ToString() == "True";
    <div class="quiz-toast @(isOk ? "success" : "fail")">
        @TempData["QuizResult"]
    </div>
}

<!-- Hero -->
<div class="lesson-hero">
    <div class="hero-info">
        <div class="hero-breadcrumb">@Model.CourseName</div>
        <div class="hero-title">@Model.Title</div>
        <div class="hero-tags">
            @if (!string.IsNullOrEmpty(Model.Topic))
            {
                <span class="hero-tag">@Model.Topic</span>
            }
            <span class="hero-tag">@Model.EstimatedMinutes phút</span>
            <span class="hero-tag">+@Model.XPReward XP</span>
            @if (Model.IsCompleted)
            {
                <span class="hero-tag">Hoàn thành</span>
            }
        </div>
    </div>
    <div class="hero-stats">
        <div class="hero-stat">
            <div class="hs-val">@Model.BestScore%</div>
            <div class="hs-lbl">Điểm cao nhất</div>
        </div>
        <div class="hero-stat">
            <div class="hs-val">@Model.AttemptCount</div>
            <div class="hs-lbl">Số lần làm</div>
        </div>
        <div class="hero-stat">
            <div class="hs-val">+@Model.XPReward</div>
            <div class="hs-lbl">XP phần thưởng</div>
        </div>
    </div>
</div>

<!-- Progress steps -->
<div class="progress-section">
    <div class="progress-header">
        <h3>Tiến độ bài học</h3>
        <span class="progress-pct">
            @(Model.IsCompleted ? "Hoàn thành" : Model.CompletionStatus == "In Progress" ? "Đang học" : "Chưa bắt đầu")
        </span>
    </div>
    <div class="prog-bar">
        <div class="prog-fill" style="width:@(Model.IsCompleted ? 100 : Model.CompletionStatus == "In Progress" ? 50 : 0)%"></div>
    </div>
    <div class="progress-steps">
        <span class="step-chip @(hasVocab ? "active" : "")">Từ vựng (@Model.Vocabularies.Count)</span>
        <span class="step-chip @(hasQuiz ? "active" : "")">Quiz (@Model.Quizzes.Count câu)</span>
        <span class="step-chip @(hasGame ? "active" : "")">Mini Game (@Model.MiniGames.Count)</span>
        @if (Model.AttemptCount > 0)
        {
            <span class="step-chip done">Đã làm @Model.AttemptCount lần · Cao nhất @Model.BestScore%</span>
        }
    </div>
</div>

<!-- Vocabulary -->
@if (Model.Vocabularies.Any())
{
    <div class="section-card">
        <div class="section-hd">
            <h2>Từ vựng trong bài</h2>
            <span class="section-count">@Model.Vocabularies.Count từ</span>
        </div>
        <div class="vocab-grid">
            @foreach (var v in Model.Vocabularies)
            {
                <div class="vocab-card" onclick="this.classList.toggle('flipped')">
                    @if (!string.IsNullOrEmpty(v.ImageUrl))
                    {
                        <img src="@v.ImageUrl" alt="@v.Word" class="vocab-img" onerror="this.style.display='none'" />
                    }
                    else
                    {

                        <div class="vocab-img-placeholder"></div>
                    }
                    <div class="vocab-word">@v.Word</div>
                    <div class="vocab-meaning">@v.Meaning</div>
                    <div class="vocab-hint">Nhấn để xem nghĩa</div>
                </div>
            }
        </div>
    </div>
}

<!-- Quiz -->
@if (Model.Quizzes.Any())
{
    <div class="section-card">
        <div class="section-hd">
            <h2>Câu hỏi kiểm tra</h2>
            <span class="section-count">@Model.Quizzes.Count câu</span>
        </div>
        <form asp-action="SubmitQuiz" asp-controller="Student"
              asp-route-lessonId="@Model.LessonId" method="post">
            @Html.AntiForgeryToken()
            <div class="quiz-list">
                @for (int i = 0; i < Model.Quizzes.Count; i++)
                {
                    var q = Model.Quizzes[i];
                    List<string> opts = new();
                    try { opts = System.Text.Json.JsonSerializer.Deserialize<List<string>>(q.OptionsJson) ?? new(); } catch { }

                    <div class="quiz-item">
                        <div class="quiz-q">
                            <span class="q-num">@(i + 1)</span>
                            <span>@q.Question</span>
                        </div>
                        @if (opts.Any())
                        {
                            <div class="options-grid">
                                @foreach (var opt in opts)
                                {
                                    <label class="option-label">
                                        <input type="radio" name="quiz_@q.QuizId" value="@opt" required />
                                        <span class="opt-dot"></span>
                                        @opt
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <input type="text" name="quiz_@q.QuizId"
                                   class="form-control"
                                   placeholder="Nhập câu trả lời..."
                                   style="border:2px solid var(--border);border-radius:12px;font-family:'Nunito',sans-serif;font-weight:700;padding:10px 14px;" />
                        }
                    </div>
                }
            </div>
            <button type="submit" class="btn-submit">Nộp bài</button>
        </form>
    </div>
}
else
{
    <div class="section-card">
        <div class="section-hd"><h2>Câu hỏi kiểm tra</h2></div>
        <div class="empty-sm">Bài học này chưa có câu hỏi.</div>
    </div>
}

<!-- Mini Games -->
@if (Model.MiniGames.Any())
{
    <div class="section-card">
        <div class="section-hd">
            <h2>Mini Game</h2>
            <span class="section-count">@Model.MiniGames.Count trò chơi</span>
        </div>
        <div class="game-list">
            @foreach (var g in Model.MiniGames)
            {
                var gameLabel = g.GameType switch
                {
                    "WORD_MATCH" => "Ghép từ",
                    "DRAG_DROP" => "Kéo thả",
                    "MEMORY_CARD" => "Lật thẻ",
                    "FILL_BLANK" => "Điền từ",
                    _ => g.GameType
                };
                <a href="/student/minigame/@g.GameId" class="game-card @(g.IsDone ? "done" : "")">
                    <div class="game-info">
                        <div class="game-title">@g.Title</div>
                        <div class="game-type">@gameLabel · @(g.IsDone ? "Đã chơi" : "Chưa chơi")</div>
                    </div>
                    <span class="game-xp">+@g.XPReward XP</span>
                </a>
            }
        </div>
    </div>
}
