@model EnglishLearningOnlineSystem.ViewModels.LessonDetailViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveNav"] = Model.AssignmentId.HasValue ? "lessons" : "courses";
    Layout = "_StudentLayout";

    var hasVocab = Model.Vocabularies.Any();
    var hasQuiz = Model.Quizzes.Any();
    var hasGame = Model.MiniGames.Any();
    var doneGames = Model.MiniGames.Count(g => g.IsDone);
    var assignmentProgress = Model.RequiredActivityCount == 0
        ? (Model.IsCompleted ? 100 : 0)
        : (int)Math.Round((double)Model.CompletedActivityCount / Model.RequiredActivityCount * 100);
}

@section Styles {
    <style>
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: .85rem;
            font-weight: 800;
            color: var(--sky-d);
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 10px;
            background: #e0f2fe;
            transition: background .15s;
            margin-bottom: 20px;
        }

            .back-btn:hover {
                background: var(--border);
            }

        /* ── Hero ── */
        .lesson-hero {
            background: linear-gradient(135deg, #0ea5e9, #6366f1);
            border-radius: 24px;
            padding: 28px 32px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(99,102,241,.25);
            position: relative;
            overflow: hidden;
        }

            .lesson-hero::before {
                content: '';
                position: absolute;
                top: -40px;
                right: -40px;
                width: 180px;
                height: 180px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

        .hero-info {
            position: relative;
            z-index: 1;
        }

        .hero-breadcrumb {
            font-size: .78rem;
            opacity: .8;
            margin-bottom: 6px;
        }

        .hero-title {
            font-size: 1.5rem;
            font-weight: 900;
            margin-bottom: 10px;
        }

        .hero-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .hero-tag {
            background: rgba(255,255,255,.2);
            padding: 3px 12px;
            border-radius: 99px;
            font-size: .75rem;
            font-weight: 800;
        }

        .hero-stats {
            display: flex;
            gap: 14px;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .hero-stat {
            text-align: center;
            background: rgba(255,255,255,.15);
            border-radius: 16px;
            padding: 14px 18px;
            min-width: 80px;
        }

        .hs-val {
            font-size: 1.4rem;
            font-weight: 900;
        }

        .hs-lbl {
            font-size: .7rem;
            opacity: .85;
            margin-top: 2px;
        }

        /* ── Progress bar ── */
        .progress-card {
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: var(--radius);
            padding: 20px 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
        }

        .prog-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

            .prog-header h3 {
                font-size: .95rem;
                font-weight: 900;
            }

        .prog-pct {
            font-size: .9rem;
            font-weight: 900;
            color: var(--sky-d);
        }

        .prog-bar {
            height: 10px;
            background: #e2e8f0;
            border-radius: 99px;
            overflow: hidden;
            margin-bottom: 12px;
        }

        .prog-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--sky), #6366f1);
            border-radius: 99px;
            transition: width .8s;
        }

        .step-chips {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .step-chip {
            padding: 5px 14px;
            border-radius: 99px;
            font-size: .75rem;
            font-weight: 800;
            border: 2px solid var(--border);
            color: var(--muted);
            background: var(--bg);
        }

            .step-chip.done {
                background: #dcfce7;
                border-color: #86efac;
                color: #15803d;
            }

            .step-chip.active {
                background: #e0f2fe;
                border-color: var(--sky);
                color: var(--sky-d);
            }

        /* ── Activity cards ── */
        .activities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .activity-card {
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: 18px;
            padding: 22px 22px 18px;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: transform .15s, box-shadow .15s, border-color .15s;
            position: relative;
            overflow: hidden;
        }

            .activity-card::before {
                content: '';
                position: absolute;
                top: -24px;
                right: -24px;
                width: 90px;
                height: 90px;
                border-radius: 50%;
                opacity: .08;
                transition: opacity .2s;
            }

            .activity-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 28px rgba(0,0,0,.1);
                color: inherit;
            }

            .activity-card.flashcard {
                border-color: #bfdbfe;
            }

                .activity-card.flashcard::before {
                    background: #3b82f6;
                }

                .activity-card.flashcard:hover {
                    border-color: #3b82f6;
                    box-shadow: 0 10px 28px rgba(59,130,246,.18);
                }

            .activity-card.quiz {
                border-color: #d9f99d;
            }

                .activity-card.quiz::before {
                    background: #84cc16;
                }

                .activity-card.quiz:hover {
                    border-color: #84cc16;
                    box-shadow: 0 10px 28px rgba(132,204,22,.18);
                }

            .activity-card.minigame {
                border-color: #ddd6fe;
            }

                .activity-card.minigame::before {
                    background: #8b5cf6;
                }

                .activity-card.minigame:hover {
                    border-color: #8b5cf6;
                    box-shadow: 0 10px 28px rgba(139,92,246,.18);
                }

            .activity-card.disabled {
                opacity: .55;
                pointer-events: none;
                filter: grayscale(.4);
            }

        .ac-icon {
            font-size: 2rem;
            line-height: 1;
        }

        .ac-body {
            flex: 1;
        }

        .ac-title {
            font-size: 1rem;
            font-weight: 900;
            color: var(--text);
            margin-bottom: 4px;
        }

        .ac-desc {
            font-size: .78rem;
            font-weight: 700;
            color: var(--muted);
            line-height: 1.4;
        }

        .ac-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .ac-meta {
            font-size: .72rem;
            font-weight: 800;
            color: var(--muted);
        }

        .ac-btn {
            font-size: .78rem;
            font-weight: 900;
            padding: 5px 14px;
            border-radius: 99px;
            border: 2px solid currentColor;
            transition: background .15s, color .15s;
        }

        .activity-card.flashcard .ac-btn {
            color: #2563eb;
        }

        .activity-card.flashcard:hover .ac-btn {
            background: #2563eb;
            color: #fff;
        }

        .activity-card.quiz .ac-btn {
            color: #65a30d;
        }

        .activity-card.quiz:hover .ac-btn {
            background: #65a30d;
            color: #fff;
        }

        .activity-card.minigame .ac-btn {
            color: #7c3aed;
        }

        .activity-card.minigame:hover .ac-btn {
            background: #7c3aed;
            color: #fff;
        }

        .best-score-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: .72rem;
            font-weight: 900;
            padding: 2px 10px;
            border-radius: 99px;
        }

        .bs-high {
            background: #dcfce7;
            color: #15803d;
        }

        .bs-mid {
            background: #fef9c3;
            color: #a16207;
        }

        .bs-low {
            background: #fee2e2;
            color: #dc2626;
        }

        /* ── Mini game list ── */
        .minigame-list {
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .minigame-list-hd {
            padding: 16px 20px;
            border-bottom: 2px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .minigame-list-hd h3 {
                font-size: .9rem;
                font-weight: 900;
            }

        .mg-count {
            background: #f3e8ff;
            color: #7c3aed;
            font-size: .68rem;
            font-weight: 900;
            padding: 2px 9px;
            border-radius: 99px;
        }

        .mg-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 20px;
            text-decoration: none;
            color: inherit;
            border-bottom: 1px solid #f1f5f9;
            transition: background .12s;
        }

            .mg-row:last-child {
                border-bottom: none;
            }

            .mg-row:hover {
                background: #faf5ff;
                color: inherit;
            }

            .mg-row.done-row {
                background: #f0fdf4;
            }

        .mg-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .mg-icon-pending {
            background: #f3e8ff;
        }

        .mg-icon-done {
            background: #dcfce7;
        }

        .mg-info {
            flex: 1;
        }

        .mg-title {
            font-size: .88rem;
            font-weight: 900;
        }

        .mg-type {
            font-size: .7rem;
            font-weight: 700;
            color: var(--muted);
            margin-top: 2px;
        }

        .mg-xp {
            font-size: .75rem;
            font-weight: 900;
            color: #92400e;
            background: #fef9c3;
            padding: 3px 10px;
            border-radius: 99px;
        }

        .mg-done-pill {
            font-size: .68rem;
            font-weight: 900;
            background: #dcfce7;
            color: #15803d;
            padding: 2px 9px;
            border-radius: 99px;
        }

        .mg-play-btn {
            font-size: .75rem;
            font-weight: 900;
            background: #7c3aed;
            color: #fff;
            padding: 4px 14px;
            border-radius: 99px;
            text-decoration: none;
            transition: background .15s;
            white-space: nowrap;
        }

            .mg-play-btn:hover {
                background: #6d28d9;
                color: #fff;
            }

        .mg-replay-btn {
            font-size: .75rem;
            font-weight: 900;
            background: #f3e8ff;
            color: #7c3aed;
            padding: 4px 14px;
            border-radius: 99px;
            text-decoration: none;
            transition: background .15s;
            border: 2px solid #ddd6fe;
            white-space: nowrap;
        }

            .mg-replay-btn:hover {
                background: #ede9fe;
                color: #6d28d9;
            }

        @@media (max-width: 992px) {
            .hero-stats {
                display: none;
            }

            .activities-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Back -->
@if (Model.AssignmentId.HasValue)
{
    <a asp-controller="Student" asp-action="Lessons" class="back-btn">← Quay lại bài được giao</a>
}
else
{
    <a href="/student/courses/@(ViewBag.CourseId ?? "")" class="back-btn">← Quay lại khoá học</a>
}

<!-- Hero -->
<div class="lesson-hero">
    <div class="hero-info">
        <div class="hero-breadcrumb">@Model.CourseName</div>
        <div class="hero-title">@Model.Title</div>
        <div class="hero-tags">
            @if (!string.IsNullOrEmpty(Model.Topic))
            {
                <span class="hero-tag">@Model.Topic</span>
            }
            @if (Model.AssignmentId.HasValue)
            {
                <span class="hero-tag">Bài giáo viên giao</span>
            }
            <span class="hero-tag">@Model.EstimatedMinutes phút</span>
            <span class="hero-tag">+@Model.XPReward XP</span>
            @if (Model.DueDate.HasValue)
            {
                <span class="hero-tag">Hạn @Model.DueDate.Value.ToString("dd/MM/yyyy")</span>
            }
            @if (Model.IsCompleted)
            {
                <span class="hero-tag">✓ Hoàn thành</span>
            }
        </div>
    </div>
    <div class="hero-stats">
        <div class="hero-stat">
            <div class="hs-val">@Model.BestScore%</div>
            <div class="hs-lbl">Điểm cao nhất</div>
        </div>
        <div class="hero-stat">
            <div class="hs-val">@Model.AttemptCount</div>
            <div class="hs-lbl">Số lần làm</div>
        </div>
        <div class="hero-stat">
            <div class="hs-val">@doneGames/@Model.MiniGames.Count</div>
            <div class="hs-lbl">Game hoàn thành</div>
        </div>
    </div>
</div>

<!-- Progress -->
<div class="progress-card">
    <div class="prog-header">
        <h3>Tiến độ bài học</h3>
        <span class="prog-pct">
            @(Model.IsCompleted ? "Hoàn thành"
              : Model.CompletionStatus == "In Progress" ? "Đang học"
              : "Chưa bắt đầu")
        </span>
    </div>
    <div class="prog-bar">
        <div class="prog-fill"
             style="width:@assignmentProgress%">
        </div>
    </div>
    <div class="step-chips">
        <span class="step-chip @(hasVocab ? "active" : "")">Flashcard (@Model.Vocabularies.Count) · @Model.FlashcardStatus</span>
        <span class="step-chip @(hasQuiz ? "active" : "")">Quiz (@Model.Quizzes.Count câu) · @Model.QuizStatus</span>
        <span class="step-chip @(hasGame ? "active" : "")">Mini Game (@Model.MiniGames.Count) · @Model.MiniGameStatus</span>
        @if (Model.AttemptCount > 0)
        {
            <span class="step-chip done">
                Đã làm @Model.AttemptCount lần · Cao nhất @Model.BestScore%
            </span>
        }
    </div>
</div>

<!-- Activity Cards -->
<div class="activities-grid">

    <!-- Flashcard -->
    <a href="@(hasVocab
        ? Url.Action("Flashcards", "Student", new
        {
            lessonId = Model.LessonId,
            assignmentId = Model.AssignmentId
        })
        : "#")"
       class="activity-card flashcard @(!hasVocab ? "disabled" : "")">
        <div class="ac-icon">🃏</div>
        <div class="ac-body">
            <div class="ac-title">Flashcard từ vựng</div>
            <div class="ac-desc">
                @if (hasVocab)
                {
                    <text>Ôn tập @Model.Vocabularies.Count từ vựng trong bài qua thẻ ghi nhớ.</text>
                }
                else
                {
                    <text>Bài học này chưa có từ vựng.</text>
                }
            </div>
        </div>
        <div class="ac-footer">
            <span class="ac-meta">@Model.Vocabularies.Count từ</span>
            @if (hasVocab)
            {
                <span class="ac-btn">Học ngay →</span>
            }
        </div>
    </a>

    <!-- Quiz -->
    <a href="@(hasQuiz
        ? Url.Action("TakeQuiz", "Student", new
        {
            lessonId = Model.LessonId,
            assignmentId = Model.AssignmentId
        })
        : "#")"
       class="activity-card quiz @(!hasQuiz ? "disabled" : "")">
        <div class="ac-icon"></div>
        <div class="ac-body">
            <div class="ac-title">Kiểm tra Quiz</div>
            <div class="ac-desc">
                @if (hasQuiz)
                {
                    <text>Làm @Model.Quizzes.Count câu hỏi để kiểm tra kiến thức và nhận XP.</text>
                }
                else
                {
                    <text>Bài học này chưa có câu hỏi quiz.</text>
                }
            </div>
        </div>
        <div class="ac-footer">
            @if (Model.AttemptCount > 0)
            {
                var bsClass = Model.BestScore >= 80 ? "bs-high"
                            : Model.BestScore >= 50 ? "bs-mid"
                            : "bs-low";
                <span class="best-score-badge @bsClass">Cao nhất @Model.BestScore%</span>
            }
            else
            {
                <span class="ac-meta">@Model.Quizzes.Count câu · +@Model.XPReward XP</span>
            }
            @if (hasQuiz)
            {
                <span class="ac-btn">@(Model.AttemptCount > 0 ? "Làm lại →" : "Bắt đầu →")</span>
            }
        </div>
    </a>

    <!-- Mini Game summary card (không click — danh sách bên dưới để chọn từng game) -->
    <div class="activity-card minigame @(!hasGame ? "disabled" : "")"
         style="cursor:default; pointer-events:@(hasGame ? "auto" : "none")">
        <div class="ac-icon">🎮</div>
        <div class="ac-body">
            <div class="ac-title">Mini Game</div>
            <div class="ac-desc">
                @if (hasGame)
                {
                    <text>@Model.MiniGames.Count trò chơi · Đã hoàn thành @doneGames trò.</text>
                }
                else
                {
                    <text>Bài học này chưa có mini game.</text>
                }
            </div>
        </div>
        <div class="ac-footer">
            <span class="ac-meta">@doneGames/@Model.MiniGames.Count hoàn thành</span>
        </div>
    </div>

</div>

<!-- Mini Game list — mỗi dòng link thẳng đến WordScramble/Play/{gameId} -->
@if (hasGame)
{
    <div class="minigame-list">
        <div class="minigame-list-hd">
            <h3>Danh sách Mini Game</h3>
            <span class="mg-count">@Model.MiniGames.Count trò chơi</span>
        </div>

        @foreach (var g in Model.MiniGames)
        {
            // Map GameType → nhãn hiển thị và emoji
            var (gameLabel, mgEmoji) = g.GameType switch
            {
                "WordScramble" => ("Sắp xếp chữ cái", "🔤"),
                "Matching" => ("Ghép từ", "🔗"),
                "DRAG_DROP" => ("Kéo thả", "✋"),
                "MEMORY_CARD" => ("Lật thẻ", "🃏"),
                "FILL_BLANK" => ("Điền từ", "✏️"),
                _ => (g.GameType, "🎮")
            };

            var playUrl = g.GameType switch
            {
                "WordScramble" => $"/WordScramble/Play/{g.GameId}?assignmentId={Model.AssignmentId}",
                "Matching" => $"/Matching/Play/{g.GameId}?assignmentId={Model.AssignmentId}",
                _ => "#"
            };

            <div class="mg-row @(g.IsDone ? "done-row" : "")">
                <div class="mg-icon @(g.IsDone ? "mg-icon-done" : "mg-icon-pending")">
                    @mgEmoji
                </div>
                <div class="mg-info">
                    <div class="mg-title">@g.Title</div>
                    <div class="mg-type">@gameLabel</div>
                </div>

                @if (g.IsDone)
                {
                    <span class="mg-done-pill">✓ Đã chơi</span>
                    <a href="@playUrl" class="mg-replay-btn">
                        Chơi lại
                    </a>
                }
                else
                {
                    <a href="@playUrl" class="mg-play-btn">
                        Chơi ngay →
                    </a>
                }

                <span class="mg-xp">+@g.XPReward XP</span>
            </div>
        }
    </div>
}
