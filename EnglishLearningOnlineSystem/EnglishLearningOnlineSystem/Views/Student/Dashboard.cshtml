@model EnglishLearningOnlineSystem.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "dashboard";
    Layout = "_StudentLayout";
}

@section Styles {
    <style>
        /* ════════════════════════════════════════
               HERO BANNER
            ════════════════════════════════════════ */
        .hero-banner {
            background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
            border-radius: 24px;
            padding: 28px 32px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
            box-shadow: 0 8px 32px rgba(99,102,241,.25);
            position: relative;
            overflow: hidden;
        }

            .hero-banner::before {
                content: '';
                position: absolute;
                top: -40px;
                right: -40px;
                width: 200px;
                height: 200px;
                background: rgba(255,255,255,.07);
                border-radius: 50%;
            }

            .hero-banner::after {
                content: '';
                position: absolute;
                bottom: -60px;
                right: 120px;
                width: 150px;
                height: 150px;
                background: rgba(255,255,255,.05);
                border-radius: 50%;
            }

        .hero-left {
            position: relative;
            z-index: 1;
        }

        .hero-greeting {
            font-size: 1.5rem;
            font-weight: 900;
            margin-bottom: 4px;
        }

        .hero-sub {
            font-size: .9rem;
            opacity: .88;
            margin-bottom: 16px;
        }

        .hero-xp-bar-wrap {
            min-width: 260px;
        }

        .hero-xp-label {
            font-size: .78rem;
            opacity: .85;
            margin-bottom: 6px;
        }

        .hero-xp-bar {
            height: 12px;
            background: rgba(255,255,255,.25);
            border-radius: 99px;
            overflow: hidden;
        }

        .hero-xp-fill {
            height: 100%;
            background: linear-gradient(90deg,#fbbf24,#f59e0b);
            border-radius: 99px;
            transition: width .8s cubic-bezier(.4,0,.2,1);
            box-shadow: 0 2px 8px rgba(251,191,36,.5);
        }

        .hero-mascot {
            font-size: 5rem;
            position: relative;
            z-index: 1;
            animation: bounce 2s infinite;
        }

        @@keyframes bounce {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-10px)
            }
        }

        /* ════════════════════════════════════════
               STAT CARDS
            ════════════════════════════════════════ */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--card);
            border-radius: var(--radius);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow);
            border: 2px solid transparent;
            transition: transform .15s, box-shadow .15s;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 24px rgba(14,165,233,.18);
            }

            .stat-card.streak {
                border-color: #fed7aa;
            }

            .stat-card.lessons {
                border-color: #bbf7d0;
            }

            .stat-card.xp {
                border-color: #fde68a;
            }

            .stat-card.missions {
                border-color: #ddd6fe;
            }

        .stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            flex-shrink: 0;
        }

        .streak .stat-icon {
            background: #fff7ed;
        }

        .lessons .stat-icon {
            background: #f0fdf4;
        }

        .xp .stat-icon {
            background: #fefce8;
        }

        .missions .stat-icon {
            background: #f5f3ff;
        }

        .stat-info .val {
            font-size: 1.8rem;
            font-weight: 900;
            line-height: 1;
        }

        .streak .val {
            color: #ea580c;
        }

        .lessons .val {
            color: #16a34a;
        }

        .xp .val {
            color: #d97706;
        }

        .missions .val {
            color: #7c3aed;
        }

        .stat-info .lbl {
            font-size: .78rem;
            color: var(--muted);
            font-weight: 700;
            margin-top: 2px;
        }

        .stat-info .sub {
            font-size: .7rem;
            color: var(--muted);
            margin-top: 1px;
        }

        /* ════════════════════════════════════════
               SECTION HEADER
            ════════════════════════════════════════ */
        .section-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

            .section-hd h3 {
                font-size: 1rem;
                font-weight: 900;
                color: var(--text);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .section-hd .count-pill {
                background: var(--sky);
                color: #fff;
                font-size: .68rem;
                font-weight: 800;
                padding: 2px 8px;
                border-radius: 99px;
            }

            .section-hd a {
                font-size: .8rem;
                font-weight: 700;
                color: var(--sky-d);
                text-decoration: none;
            }

                .section-hd a:hover {
                    text-decoration: underline;
                }

        /* ════════════════════════════════════════
               LESSON CARDS
            ════════════════════════════════════════ */
        .lesson-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 28px;
        }

        .lesson-card {
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: var(--radius);
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            color: inherit;
            transition: border-color .15s, transform .15s, box-shadow .15s;
        }

            .lesson-card:hover {
                border-color: var(--sky);
                transform: translateX(4px);
                box-shadow: var(--shadow);
                color: inherit;
            }

        .lesson-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .status-NOT_STARTED {
            background: #e2e8f0;
        }

        .status-In\ Progress, .status-IN_PROGRESS {
            background: var(--yellow);
        }

        .status-Completed, .status-COMPLETED {
            background: var(--green);
        }

        .lesson-info .l-title {
            font-weight: 800;
            font-size: .92rem;
        }

        .lesson-info .l-meta {
            font-size: .75rem;
            color: var(--muted);
            margin-top: 2px;
        }

        .lesson-info {
            flex: 1;
        }

        .lesson-right {
            text-align: right;
            flex-shrink: 0;
        }

        .l-xp {
            font-size: .8rem;
            font-weight: 800;
            color: var(--yellow);
        }

        .l-due {
            font-size: .7rem;
            color: var(--muted);
            margin-top: 2px;
        }

        .l-status-tag {
            display: inline-block;
            font-size: .65rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 99px;
            margin-top: 4px;
        }

        .tag-done {
            background: #dcfce7;
            color: #166534;
        }

        .tag-doing {
            background: #fef9c3;
            color: #854d0e;
        }

        .tag-pending {
            background: #f1f5f9;
            color: #475569;
        }

        /* ════════════════════════════════════════
               MISSION CARDS
            ════════════════════════════════════════ */
        .mission-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 24px;
        }

        .mission-card {
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: var(--radius);
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: border-color .15s;
        }

            .mission-card.done {
                border-color: #bbf7d0;
                background: #f0fdf4;
            }

            .mission-card:not(.done):hover {
                border-color: var(--purple);
            }

        .mission-icon {
            font-size: 1.6rem;
            flex-shrink: 0;
        }

        .mission-body {
            flex: 1;
        }

        .mission-desc {
            font-size: .88rem;
            font-weight: 800;
            color: var(--text);
        }

        .mission-prog-bar {
            height: 7px;
            background: #e2e8f0;
            border-radius: 99px;
            margin-top: 7px;
            overflow: hidden;
        }

        .mission-prog-fill {
            height: 100%;
            background: linear-gradient(90deg,var(--purple),var(--pink));
            border-radius: 99px;
            transition: width .6s;
        }

        .mission-card.done .mission-prog-fill {
            background: linear-gradient(90deg,var(--green),#22c55e);
        }

        .mission-nums {
            font-size: .7rem;
            color: var(--muted);
            margin-top: 3px;
            font-weight: 700;
        }

        .mission-xp-tag {
            font-size: .78rem;
            font-weight: 900;
            color: #92400e;
            background: #fef3c7;
            border-radius: 99px;
            padding: 3px 10px;
            flex-shrink: 0;
        }

        /* ════════════════════════════════════════
               PROGRESS TABLE
            ════════════════════════════════════════ */
        .prog-table-wrap {
            background: var(--card);
            border-radius: var(--radius);
            border: 2px solid var(--border);
            overflow: hidden;
            margin-bottom: 28px;
            box-shadow: var(--shadow);
        }

        .prog-table {
            width: 100%;
            border-collapse: collapse;
        }

            .prog-table thead th {
                background: var(--bg);
                font-size: .72rem;
                text-transform: uppercase;
                letter-spacing: .07em;
                color: var(--muted);
                font-weight: 800;
                padding: 12px 16px;
                border-bottom: 2px solid var(--border);
                text-align: left;
            }

            .prog-table tbody tr {
                border-bottom: 1px solid #f1f5f9;
                transition: background .12s;
            }

                .prog-table tbody tr:last-child {
                    border-bottom: none;
                }

                .prog-table tbody tr:hover {
                    background: #f0f9ff;
                }

            .prog-table td {
                padding: 12px 16px;
                font-size: .85rem;
                font-weight: 700;
            }

        .score-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 3px 12px;
            border-radius: 99px;
            font-size: .78rem;
            font-weight: 900;
        }

        .score-high {
            background: #dcfce7;
            color: #15803d;
        }

        .score-mid {
            background: #fef9c3;
            color: #a16207;
        }

        .score-low {
            background: #fee2e2;
            color: #dc2626;
        }

        /* ════════════════════════════════════════
               BADGE CHIPS
            ════════════════════════════════════════ */
        .badge-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(160px,1fr));
            gap: 12px;
            margin-bottom: 24px;
        }

        .badge-chip {
            background: var(--card);
            border: 2px solid #fde68a;
            border-radius: var(--radius);
            padding: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 2px 8px rgba(251,191,36,.15);
        }

            .badge-chip .b-icon {
                font-size: 2rem;
            }

            .badge-chip .b-name {
                font-weight: 800;
                font-size: .82rem;
                color: var(--text);
            }

            .badge-chip .b-date {
                font-size: .68rem;
                color: var(--muted);
                margin-top: 1px;
            }

        /* ════════════════════════════════════════
               EMPTY STATE
            ════════════════════════════════════════ */
        .empty-box {
            background: var(--card);
            border: 2px dashed var(--border);
            border-radius: var(--radius);
            padding: 36px 20px;
            text-align: center;
            color: var(--muted);
            margin-bottom: 28px;
        }

            .empty-box .e-icon {
                font-size: 2.8rem;
                margin-bottom: 8px;
            }

            .empty-box p {
                font-size: .88rem;
                font-weight: 700;
            }

        @@media (max-width: 600px) {
            .hero-mascot {
                display: none;
            }

            .stat-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width: 992px) {
            .stat-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }
    </style>
}

@{
    int xpTotal = Model.XP + Model.XPToNextLevel;
    int xpPct = xpTotal > 0 ? (int)((double)Model.XP / xpTotal * 100) : 100;
}

<!-- Hero Banner -->
<div class="hero-banner">
    <div class="hero-left">
        <div class="hero-greeting">Hãy tiếp tục phát huy những thành quả tuyệt vời hôm nay!</div>
        <div class="hero-sub">Bạn đang ở Cấp độ @Model.Level · Còn @Model.XPToNextLevel XP để lên Cấp độ @(Model.Level + 1)</div>
        <div class="hero-xp-bar-wrap">
            <div class="hero-xp-label">@Model.XP / @xpTotal XP</div>
            <div class="hero-xp-bar">
                <div class="hero-xp-fill" style="width:@xpPct%"></div>
            </div>
        </div>
    <div class="hero-mascot">🦉</div>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card streak">
        <div class="stat-icon"></div>
        <div class="stat-info">
            <div class="val">@Model.CurrentStreakDays</div>
            <div class="lbl">Chuỗi ngày học</div>
            <div class="sub">Kỷ lục: @Model.LongestStreak ngày</div>
        </div>
    </div>
    <div class="stat-card lessons">
        <div class="stat-icon"></div>
        <div class="stat-info">
            <div class="val">@Model.TotalLessonsCompleted</div>
            <div class="lbl">Bài học đã hoàn thành</div>
            <div class="sub">Tiếp tục phát huy nhé!</div>
        </div>
    </div>
    <div class="stat-card xp">
        <div class="stat-icon"></div>
        <div class="stat-info">
            <div class="val">@Model.TotalXPEarned</div>
            <div class="lbl">Tổng XP</div>
            <div class="sub">Cấp độ @Model.Level</div>
        </div>
    </div>
    <div class="stat-card missions">
        <div class="stat-icon"></div>
        <div class="stat-info">
            <div class="val">@Model.DailyMissions.Count(m => m.IsCompleted)/@Model.DailyMissions.Count</div>
            <div class="lbl">Nhiệm vụ hôm nay</div>
            <div class="sub">
                @if (Model.DailyMissions.All(m => m.IsCompleted) && Model.DailyMissions.Any())
                {
                    <text>Hoàn thành tất cả!</text>
                }
                else
                {

                    <text>Tiếp tục cố gắng!</text>
                }
            </div>
        </div>
    </div>
</div>

<!-- Two column layout -->
<div class="row g-4">
        <!-- AI Recommended for You -->
        @if (Model.Recommendations.Any())
        {
            <div class="section-hd">
                <h3>Gợi ý học tập (AI) <span class="count-pill">@Model.Recommendations.Count</span></h3>
            </div>
            <div class="lesson-list">
                @foreach (var rec in Model.Recommendations)
                {
                    <a href="@rec.ActionUrl" class="lesson-card" style="border-color: var(--sky); background: #f0f9ff;">
                        <div class="lesson-dot" style="background: var(--sky)"></div>
                        <div class="lesson-info">
                            <div class="l-title">@rec.LessonTitle</div>
                            <div class="l-meta">@rec.Reason</div>
                        </div>
                        <div class="lesson-right">
                            <div class="l-xp">Thử ngay →</div>
                        </div>
                    </a>
                }
            </div>
        }

        <!-- Assigned Lessons -->
        <div class="section-hd">
            <h3> Bài học được giao <span class="count-pill">@Model.AssignedLessons.Count</span></h3>
            <a href="/student/lessons">Xem tất cả →</a>
        </div>
        @if (!Model.AssignedLessons.Any())
        {
            <div class="empty-box"><div class="e-icon"></div><p>Chưa có bài học nào được giao.</p></div>
        }
        else
        {
            <div class="lesson-list">
                @foreach (var lesson in Model.AssignedLessons)
                {
                    var tagClass = lesson.CompletionStatus is "Completed" or "COMPLETED"
                        ? "Đã hoàn thành" : lesson.CompletionStatus is "In Progress" or "IN_PROGRESS"
                        ? "Đang học" : "Chưa bắt đầu";
                    var tagText = lesson.CompletionStatus is "Completed" or "COMPLETED"
                        ? " Hoàn thành" : lesson.CompletionStatus is "In Progress" or "IN_PROGRESS"
                        ? " Đang học" : " Chưa làm";
                    <a href="/student/lesson/@lesson.LessonId/quiz" class="lesson-card">
                        <div class="lesson-dot status-@lesson.CompletionStatus"></div>
                        <div class="lesson-info">
                            <div class="l-title">@lesson.Title</div>
                            <div class="l-meta">@lesson.Topic ·  @lesson.EstimatedMinutes phút</div>
                            <span class="l-status-tag @tagClass">@tagText</span>
                        </div>
                        <div class="lesson-right">
                            <div class="l-xp">+@lesson.XPReward XP</div>
                            <div class="l-due">Hạn chót: @lesson.DueDate.ToString("dd/MM")</div>
                        </div>
                    </a>
                }
            </div>
        }

        <!-- Recent Progress -->
        <div class="section-hd">
            <h3> Tiến độ gần đây</h3>
            <a href="/student/history">Xem lịch sử →</a>
        </div>
        @if (!Model.RecentProgress.Any())
        {
            <div class="empty-box"><div class="e-icon"></div><p>Hãy bắt đầu bài học đầu tiên của bạn!</p></div>
        }
        else
        {
            <div class="prog-table-wrap">
                <table class="prog-table">
                    <thead>
                        <tr>
                            <th>Bài học</th>
                            <th>Điểm</th>
                            <th>XP</th>
                            <th>Ngày hoàn thành</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.RecentProgress)
                        {
                            var sc = p.QuizScore >= 80 ? "score-high" : p.QuizScore >= 50 ? "score-mid" : "score-low";
                            <tr>
                                <td>@p.LessonTitle</td>
                                <td><span class="score-pill @sc">@p.QuizScore%</span></td>
                                <td style="color:var(--yellow)">+@p.XPEarned</td>
                                <td style="color:var(--muted)">@(p.CompletedAt == DateTime.MinValue ? "—" : p.CompletedAt.ToString("dd/MM/yy"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
    <div class="col-lg-5">

        <!-- Daily Missions -->
        <div class="section-hd">
            <h3> Nhiệm vụ hôm nay</h3>
            <a href="/student/missions">Xem tất cả →</a>
        </div>
        @if (!Model.DailyMissions.Any())
        {
            <div class="empty-box"><div class="e-icon"></div><p>Hôm nay chưa có nhiệm vụ nào.</p></div>
        }
        else
        {
            <div class="mission-list">
                @foreach (var m in Model.DailyMissions)
                {
                    int mp = m.TargetValue > 0 ? (int)((double)m.CurrentValue / m.TargetValue * 100) : 0;
                    var mIcon = m.Type switch
                    {
                        "COMPLETE_LESSON" => "",
                        "PLAY_MINIGAME" => "",
                        "QUIZ_PERFECT" => "",
                        "LOGIN_STREAK" => "",
                        _ => ""
                    };
                    <div class="mission-card @(m.IsCompleted ? "done" : "")">
                        <div class="mission-icon">@mIcon</div>
                        <div class="mission-body">
                            <div class="mission-desc">@m.Description</div>
                            <div class="mission-prog-bar">
                                <div class="mission-prog-fill" style="width:@mp%"></div>
                            </div>
                            <div class="mission-nums">@m.CurrentValue / @m.TargetValue</div>
                        </div>
                        <div class="mission-xp-tag">+@m.XPReward ⭐</div>
                    </div>
                }
            </div>
        }

        <!-- Recent Badges -->
        @if (Model.RecentBadges.Any())
        {
            <div class="section-hd">
                <h3> Huy hiệu mới</h3>
                <a href="/student/badges">Xem tất cả →</a>
            </div>
            <div class="badge-grid">
                @foreach (var b in Model.RecentBadges)
                {
                    <div class="badge-chip">
                        <div class="b-icon">
                            @if (!string.IsNullOrEmpty(b.IconUrl))
                            {
                                <img src="@b.IconUrl" style="width:2rem;height:2rem;object-fit:contain" />
                            }
                            else
                            {

                                <text></text>
                            }
                        </div>
                        <div>
                            <div class="b-name">@b.BadgeName</div>
                            <div class="b-date">@b.EarnedAt.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>
