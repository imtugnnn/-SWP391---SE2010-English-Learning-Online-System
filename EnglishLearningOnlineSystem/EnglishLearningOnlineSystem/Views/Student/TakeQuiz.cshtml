@model EnglishLearningOnlineSystem.ViewModels.TakeQuizViewModel
@{
    ViewData["Title"] = "Làm bài kiểm tra - " + Model.LessonTitle;
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["ActiveNav"] = "lessons";
}

@section Styles {
    <style>
        .quiz-container {
            max-width: 800px;
            margin: 0 auto;
            padding-bottom: 100px; /* Space for bottom bar */
        }
        .quiz-header {
            background: linear-gradient(135deg, var(--sky), var(--sidebar));
            color: var(--white);
            border-radius: var(--radius);
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: var(--shadow);
            text-align: center;
        }
        .quiz-header h1 {
            font-weight: 800;
            margin-bottom: 10px;
        }
        .question-card {
            background: var(--card);
            border-radius: var(--radius);
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .question-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 24px rgba(14, 165, 233, 0.2);
        }
        .question-text {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 20px;
        }
        .option-label {
            display: flex;
            align-items: center;
            padding: 15px 20px;
            margin-bottom: 12px;
            border-radius: 12px;
            border: 2px solid var(--border);
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
            color: var(--text);
            background: #fff;
        }
        .option-label:hover {
            background: var(--bg);
            border-color: var(--sky);
        }
        .option-input {
            display: none;
        }
        .option-input:checked + .option-label {
            background: rgba(14, 165, 233, 0.1);
            border-color: var(--text);
            box-shadow: inset 0 0 0 1px var(--text);
        }
        .option-input:checked + .option-label .radio-custom {
            border-color: var(--text);
            background: transparent;
        }
        .option-input:checked + .option-label .radio-custom::after {
            background: var(--text);
            transform: translate(-50%, -50%) scale(1);
        }
        .radio-custom {
            width: 24px;
            height: 24px;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            margin-right: 15px;
            position: relative;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }
        .radio-custom::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 10px;
            height: 10px;
            background: white;
            border-radius: 50%;
            transform: translate(-50%, -50%) scale(0);
            transition: transform 0.2s ease;
        }
        .bottom-bar {
            position: fixed;
            bottom: 0;
            left: 230px; /* offset sidebar */
            right: 0;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border);
            padding: 20px;
            display: flex;
            justify-content: center;
            z-index: 100;
            box-shadow: 0 -4px 16px rgba(14, 165, 233, 0.1);
        }
        @@media (max-width: 992px) {
            .bottom-bar { left: 0; }
        }
        .btn-submit {
            background: var(--sky);
            color: white;
            font-size: 1.2rem;
            font-weight: 800;
            padding: 12px 40px;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
        }
        .btn-submit:hover {
            background: var(--sky-d);
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 8px 25px rgba(14, 165, 233, 0.4);
        }
    </style>
}

<div class="quiz-container">
    <div class="quiz-header">
        <h1>@Model.LessonTitle</h1>
        <p class="mb-0 fs-5">Hãy bình tĩnh và làm bài tốt nhé! </p>
    </div>

    <form id="quizForm" method="post" action="/student/lesson/@Model.LessonId/quiz/submit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="LessonId" value="@Model.LessonId" />
        <input type="hidden" name="WeeklyAssignmentId" value="@Model.WeeklyAssignmentId" />
        <input type="hidden" id="StartedAtTicks" name="StartedAtTicks" value="" />

        @{ int qIndex = 1; }
        @if (Model.Questions != null && Model.Questions.Any())
        {
            foreach (var q in Model.Questions)
            {
                <div class="question-card">
                    <div class="question-text">
                        <span class="badge bg-primary rounded-pill me-2">Q@(qIndex)</span> @q.Question
                    </div>
                    @if (q.QuizType == "MultipleChoice" || q.QuizType == "IMAGE_CHOICE")
                    {
                        <div class="options">
                            @if (q.Options != null)
                            {
                                int optIndex = 0;
                                foreach (var opt in q.Options)
                                {
                                    <div class="option-wrapper">
                                        <input type="radio" id="q_@(q.QuizId)_@(optIndex)" name="Answers[@q.QuizId]" value="@opt" class="option-input" />
                                        <label for="q_@(q.QuizId)_@(optIndex)" class="option-label">
                                            <span class="radio-custom"></span>
                                            @if (q.QuizType == "IMAGE_CHOICE")
                                            {
                                                <img src="@opt" style="max-height: 80px; max-width: 120px; border-radius: 4px; object-fit: contain;" alt="Option @(optIndex + 1)" />
                                            }
                                            else
                                            {
                                                @opt
                                            }
                                        </label>
                                    </div>
                                    optIndex++;
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <textarea name="Answers[@q.QuizId]" class="form-control" rows="3" placeholder="Nhập câu trả lời của bạn vào đây..."></textarea>
                    }
                </div>
                qIndex++;
            }
        }
        else
        {
            <div class="text-center p-5 text-muted">
                <h4>Không có câu hỏi nào</h4>
            </div>
        }

        <div class="bottom-bar">
            <button type="submit" class="btn-submit">Nộp bài </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("StartedAtTicks").value = Date.now() * 10000;
        });
    </script>
}
