@model EnglishLearningOnlineSystem.ViewModels.QuizResultViewModel
@{
    ViewData["Title"] = "Kết quả bài làm";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["ActiveNav"] = "lessons";
}

@section Styles {
    <style>
        .result-hero {
            background: linear-gradient(135deg, var(--purple), #7c3aed);
            border-radius: var(--radius);
            padding: 50px 20px;
            text-align: center;
            color: white;
            box-shadow: 0 10px 30px rgba(139, 92, 246, 0.3);
            margin-bottom: 40px;
            position: relative;
            overflow: hidden;
        }
        .result-hero::after {
            content: '';
            position: absolute;
            font-size: 150px;
            opacity: 0.1;
            right: -20px;
            bottom: -20px;
            transform: rotate(-15deg);
        }
        .score-circle {
            width: 150px;
            height: 150px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: #7c3aed;
            font-size: 3rem;
            font-weight: 900;
            border: 8px solid #ddd6fe;
            animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @@keyframes popIn {
            0% { transform: scale(0); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .xp-badge {
            background: var(--yellow);
            color: #854d0e;
            padding: 8px 20px;
            border-radius: 30px;
            font-weight: 800;
            font-size: 1.2rem;
            display: inline-block;
            margin-top: 15px;
            box-shadow: 0 4px 10px rgba(251, 191, 36, 0.4);
        }
        .stat-box {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 10px;
        }
        .question-list {
            max-width: 800px;
            margin: 0 auto;
        }
        .q-item {
            background: var(--card);
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            border: 1px solid var(--border);
            transition: transform 0.2s;
        }
        .q-item:hover {
            transform: translateX(5px);
        }
        .q-item.correct {
            border-left: 5px solid var(--green);
        }
        .q-item.incorrect {
            border-left: 5px solid var(--red);
        }
        .q-text {
            font-weight: 600;
            color: var(--text);
            margin: 0;
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding-right: 15px;
        }
        .q-status {
            font-size: 1.5rem;
        }
        .btn-review {
            display: block;
            width: fit-content;
            margin: 30px auto;
            background: linear-gradient(135deg, var(--orange), #ea580c);
            color: white;
            font-weight: 800;
            padding: 12px 30px;
            border-radius: 30px;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(249, 115, 22, 0.3);
            transition: all 0.3s;
        }
        .btn-review:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(249, 115, 22, 0.4);
        }
    </style>
}

<div class="result-hero">
    <div class="score-circle">
        @Model.Score%
    </div>
    <div class="stat-box">
        Số câu đúng: @Model.CorrectCount / @Model.TotalQuestions
    </div>
    <div class="xp-badge">
        +@Model.XpEarned XP 
    </div>
</div>

<div class="question-list">
    <h3 class="fw-bold mb-4 text-center text-dark">Xem nhanh kết quả</h3>
    @if (Model.AnswerResults != null)
    {
        foreach (var q in Model.AnswerResults)
        {
            <div class="q-item @(q.IsCorrect ? "correct" : "incorrect")">
                <p class="q-text">@q.Question</p>
                <div class="q-status">
                    @(q.IsCorrect ? "" : "")
                </div>
            </div>
        }
    }

    <a href="/student/quiz/review/@Model.AttemptId" class="btn-review">
        Xem chi tiết câu sai 
    </a>
</div>
