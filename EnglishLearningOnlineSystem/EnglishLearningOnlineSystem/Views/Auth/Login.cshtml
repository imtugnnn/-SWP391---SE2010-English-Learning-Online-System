@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELS Login</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="login-container">
    <div class="login-title">
        ELS Learning <br />
        System
    </div>

    @* Form này POST về /login để AuthController.Login xử lý *@
    <form asp-action="Login" method="post">
        @if (TempData["Message"] != null)
        {
            <div class="auth-message">@TempData["Message"]</div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

        <div class="form-group">
            <input type="email" class="form-input" placeholder="Nhập Email" asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="password" class="form-input" placeholder="Nhập Password" asp-for="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <!-- Post /login -> Gọi AuthController.Login()-->
        <button type="submit" class="btn-login">Đăng nhập</button>
        @* Nút này đi vào AuthController.GoogleLogin rồi nhảy sang Google OAuth *@
        <a class="btn-google" asp-action="GoogleLogin">Đăng nhập với Google</a>
        @* Link này mở màn hình forgot password, sau đó controller gọi service tạo token *@
        <a class="register-link" asp-action="ForgotPassword">Quên mật khẩu?</a>
    </form>
</div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>

