@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELS Forgot Password</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="login-container">
    <div class="login-title auth-title-small">
        Forgot <br />
        Password
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="auth-message">@ViewBag.Message</div>
    }

    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

        <div class="form-group">
            <input type="email" class="form-input" placeholder="Enter your email" asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-login">Send reset link</button>
        <a class="register-link" asp-action="Login">Back to login</a>
    </form>
</div>

<partial name="_ValidationScriptsPartial" />
</body>
</html>
