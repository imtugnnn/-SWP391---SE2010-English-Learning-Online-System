@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ELS Reset Password</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="login-container">
    <div class="login-title auth-title-small">
        Đặt lại mật khẩu
    </div>

    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
        <input type="hidden" asp-for="Token" />

        <div class="form-group">
            <input type="password" class="form-input" placeholder="Nhập mật khẩu mới" asp-for="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="password" class="form-input" placeholder="Nhập lại mật khẩu" asp-for="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        @* Gọi đến func ForgotPassword ở AuthController *@
        <button type="submit" class="btn-login">Đặt lại mật khẩu</button>
        
        <a class="register-link" asp-action="Login">Quay về đăng nhập</a>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
