@model GoogleLoginCompletionViewModel

@{
    ViewData["Title"] = "Complete Google Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Complete Google Login</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="register-container">
        <div class="register-title">
            Complete <br />
            Account
        </div>

        <form asp-action="CompleteGoogleLogin" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <input type="email" class="form-input" value="@Model.Email" disabled />
            </div>

            <div class="form-group">
                <input type="text" class="form-input" placeholder="Enter Username" asp-for="Username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="password" class="form-input" placeholder="Enter Password" asp-for="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <select class="form-input" asp-for="RoleId" asp-items="Model.RoleOptions">
                    <option value="">Choose role</option>
                </select>
                <span asp-validation-for="RoleId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="date" class="form-input" asp-for="BirthDate" />
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-register">Continue</button>
            <a class="login-link" asp-action="Login">Back to login</a>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
